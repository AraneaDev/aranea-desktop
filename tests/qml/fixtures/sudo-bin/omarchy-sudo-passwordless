#!/usr/bin/env python3
"""Inert whole-command boundary for native PasswordlessSudo QML tests."""
import os
from pathlib import Path
import sys
import time

root = Path(os.environ["ARANEA_SUDO_FIXTURE_ROOT"])
root.mkdir(parents=True, exist_ok=True)
name = Path(sys.argv[0]).name
with (root / "calls").open("a") as stream:
    stream.write(name + " " + " ".join(sys.argv[1:]) + "\n")
if name == "omarchy-notification-send":
    sys.exit(0)
if sys.argv[1:] == ["--active"]:
    if (root / "delay").exists() and (root / "delay").read_text().strip():
        time.sleep(0.5)
    sys.exit(0 if (root / "active").read_text().strip() == "1" else 3)
if sys.argv[1:] == ["--disable"]:
    if (root / "fail-disable").exists() and (root / "fail-disable").read_text().strip():
        sys.exit(1)
    (root / "active").write_text("0")
    sys.exit(0)
# Enable is deliberately never implemented: the UI's terminal launch is captured.
sys.exit(97)
