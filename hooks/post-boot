#!/bin/bash

# Aranea theme: login-time setup when Aranea is the active theme.
# Omarchy runs post-boot hooks a couple seconds after the desktop starts.
#
# Install with:
#   omarchy hook install post-boot hooks/post-boot

[[ $(omarchy theme current 2>/dev/null) == "Aranea" ]] || exit 0

# Omarchy hard-codes these two locations (see omarchy-theme-set): the copy of
# the current theme, and the stable installed Aranea theme that survives
# theme switches (integration links point there).
current_theme="$HOME/.local/state/omarchy/current/theme"
installed_theme="$HOME/.config/omarchy/themes/aranea"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

mkdir -p ~/.config/omarchy/branding
ln -nsf ~/.local/state/omarchy/current/theme/branding/screensaver.txt ~/.config/omarchy/branding/screensaver.txt

theme_root="$current_theme"
profile_file="$state_home/aranea/profile"
profile="${ARANEA_INSTALL_PROFILE:-}"
if [[ -z "$profile" && -f "$profile_file" ]]; then
  profile="$(<"$profile_file")"
fi
profile="${profile:-full}"

# Persist the selected bar and competing-plugin state before using shell IPC.
# This still repairs a crashed/stopped shell, where `omarchy plugin ...` cannot
# connect and the best-effort commands below would otherwise be skipped.
if [[ -x "$theme_root/scripts/repair-shell-config" ]]; then
  "$theme_root/scripts/repair-shell-config" "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1 || true
fi

# Integrations link from the stable installed theme so they survive theme
# switches; ones the user deactivated (aranea-integrations) stay off.
integration_scripts="$installed_theme/scripts"
[[ -x "$integration_scripts/install-integration" ]] || integration_scripts="$theme_root/scripts"
run_integration() {
  [[ "$(cat "$state_home/aranea/integrations/$1" 2>/dev/null)" == inactive ]] && return 0
  "$integration_scripts/install-integration" "$1" --yes >/dev/null 2>&1 || true
}
if [[ -x "$integration_scripts/install-integration" ]]; then
  if [[ "$profile" == full ]]; then
    for integration in terminal developer cursor icons qt browser session media; do run_integration "$integration"; done
  elif [[ "$profile" == no_apps ]]; then
    for integration in cursor icons; do run_integration "$integration"; done
  fi
fi

if [[ -f /usr/share/applications/teams-for-linux.desktop && -x "$theme_root/scripts/repair-desktop-entry" ]]; then
  "$theme_root/scripts/repair-desktop-entry" \
    /usr/share/applications/teams-for-linux.desktop \
    "$HOME/.local/share/applications/teams-for-linux.desktop" >/dev/null 2>&1 || true
fi

if [[ -x "$theme_root/scripts/deploy-plugins-safely" ]]; then
  "$theme_root/scripts/deploy-plugins-safely" "$theme_root"
fi
# Aranea's polkit agent can only register in a fresh shell process (a
# deploy that restarted the shell has already done this).
if [[ -x "$theme_root/scripts/finish-polkit-handover" ]]; then
  "$theme_root/scripts/finish-polkit-handover" || true
fi
if [[ -x "$theme_root/scripts/ensure-shell-running" ]]; then
  "$theme_root/scripts/ensure-shell-running"
fi
# The day/night wallpaper schedule is switched off while another theme is
# active; its state file still says "on", so bring it back.
if [[ "$(cat "$state_home/aranea/wallpaper-schedule" 2>/dev/null)" == on && -x "$installed_theme/scripts/aranea-wallpaper" ]]; then
  "$installed_theme/scripts/aranea-wallpaper" schedule on >/dev/null 2>&1 || true
fi
if [[ -x "$theme_root/scripts/aranea-motion" ]]; then
  "$theme_root/scripts/aranea-motion" apply >/dev/null 2>&1 || true
fi
