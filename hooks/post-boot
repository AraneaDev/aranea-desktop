#!/bin/bash

# Aranea theme: prepare the optional diagnostics toggle at login when Aranea
# is the active theme. Conky remains off until explicitly summoned.
# Omarchy runs post-boot hooks a couple seconds after the desktop starts.
#
# Install with:
#   omarchy hook install post-boot hooks/post-boot

[[ $(omarchy theme current 2>/dev/null) == "Aranea" ]] || exit 0

mkdir -p ~/.config/conky ~/.local/bin
ln -nsf ~/.local/state/omarchy/current/theme/conky.conf ~/.config/conky/conky.conf
install -Dm755 ~/.local/state/omarchy/current/theme/scripts/aranea-diagnostics-toggle ~/.local/bin/aranea-diagnostics-toggle

theme_root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
lock_plugin="$HOME/.config/omarchy/plugins/araneadev.lock"
menu_plugin="$HOME/.config/omarchy/plugins/araneadev.menu"
mkdir -p "$lock_plugin"
install -Dm644 "$theme_root/plugins/araneadev.lock/manifest.json" "$lock_plugin/manifest.json"
install -Dm644 "$theme_root/plugins/araneadev.lock/Service.qml" "$lock_plugin/Service.qml"
install -Dm644 "$theme_root/plugins/araneadev.lock/LockView.qml" "$lock_plugin/LockView.qml"
mkdir -p "$menu_plugin"
install -Dm644 "$theme_root/plugins/araneadev.menu/manifest.json" "$menu_plugin/manifest.json"
install -Dm644 "$theme_root/plugins/araneadev.menu/BarWidget.qml" "$menu_plugin/BarWidget.qml"
install -Dm644 "$theme_root/plugins/araneadev.menu/Menu.qml" "$menu_plugin/Menu.qml"
install -Dm644 "$theme_root/plugins/araneadev.menu/MenuModel.js" "$menu_plugin/MenuModel.js"
omarchy plugin disable tim.lock >/dev/null 2>&1 || true
omarchy plugin enable araneadev.lock >/dev/null 2>&1 || true
omarchy plugin disable tim.menu >/dev/null 2>&1 || true
omarchy plugin enable araneadev.menu >/dev/null 2>&1 || true
