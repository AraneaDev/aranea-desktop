#!/usr/bin/env bash
# Refuse commits made directly on an integration branch.
#
# Work belongs on a topic branch so it can be reviewed as a pull request.
# Committing to master locally is easy to do by accident and awkward to undo
# once anything is built on top of it.
#
# Install by copying into .git/hooks/ rather than pointing core.hooksPath at
# this directory: a tracked hook only exists in the working tree while a
# branch containing it is checked out, so it would be missing on exactly the
# branches that predate it.
#
# Deliberate exception (a release chore, an emergency fix):
#     git commit --no-verify
set -eu

PROTECTED='main master'

# Empty during a rebase, cherry-pick, or any other detached-HEAD operation,
# which must not be blocked: those commits were already made on a branch.
branch="$(git symbolic-ref --quiet --short HEAD || true)"
[ -n "$branch" ] || exit 0

for protected in $PROTECTED; do
  if [ "$branch" = "$protected" ]; then
    cat >&2 <<MSG

  Refusing to commit directly on '$branch'.

    git switch -c some-branch-name
    git commit ...

  If you really meant it: git commit --no-verify

MSG
    exit 1
  fi
done

# The staged content gets the same gates CI runs (format, lint, validate,
# qml, and the fast tests when tests, scripts or plugin code are staged),
# checked from a snapshot of the index rather than the working tree, so a
# partial `git add -p` cannot pass here and fail there. Branches that predate
# tools/check have nothing to run. See CONTRIBUTING.md; bypass once with
# --no-verify.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
[ -x tools/check ] || exit 0
if [ ! -d "$repo_root/node_modules" ]; then
  echo "  tools/check needs the JS tooling first: npm ci" >&2
  exit 1
fi
exec tools/check --staged --fast
