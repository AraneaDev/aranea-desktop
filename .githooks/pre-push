#!/usr/bin/env bash
# Refuse a direct push to a protected branch.
#
# Branch protection already refuses this server-side; this catches it before
# the round trip, and covers a clone where the remote settings have not been
# checked. It is a guard rail rather than a control: anyone can pass
# --no-verify, and a different clone will not have it until core.hooksPath is
# set there too.
#
# Install by copying into .git/hooks/, the same way pre-commit is installed:
#   cp .githooks/pre-commit .githooks/pre-push .githooks/commit-msg .git/hooks/
#
# Copied rather than reached through core.hooksPath for the reason
# CONTRIBUTING.md gives: a tracked hook only exists in the working tree while a
# branch containing it is checked out, so it would be missing on exactly the
# branches that predate it.
#
# Bypass once, deliberately:
#   git push --no-verify
set -euo pipefail

PROTECTED="master"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if [ "$branch" = "$PROTECTED" ]; then
    cat >&2 <<MSG

  Refusing to push straight to '$PROTECTED'.

  This repository takes changes through pull requests. Try:

    git switch -c some-branch-name
    git push -u origin some-branch-name
    gh pr create --fill

  If you really meant it: git push --no-verify

MSG
    exit 1
  fi
done

exit 0
