# Aranea tmux status fragment
set -g status-style 'bg={{colors.darker_background}},fg={{colors.dark_foreground}}'
set -g status-left '#[fg={{colors.accent}}] ◈ #[fg={{colors.bright_foreground}}]#S '
set -g status-left-length 32
set -g window-status-format '#[fg={{colors.dark_foreground}}] #I:#W '
set -g window-status-current-format '#[fg={{colors.background}},bg={{colors.accent}}] #I:#W '
set -g status-right '#[fg={{colors.accent_secondary}}]%Y-%m-%d #[fg={{colors.bright_foreground}}]%H:%M '
set -g pane-border-style 'fg={{colors.muted}}'
set -g pane-active-border-style 'fg={{colors.accent}}'
