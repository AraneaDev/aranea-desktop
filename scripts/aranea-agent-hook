#!/bin/bash
# Usage: aranea-agent-hook claude|codex < native-hook.json
# Advisory reporter: fixed bootstrap tools, no provider decisions or context.
export PATH=/usr/bin:/bin
unset BASH_ENV ENV CDPATH
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
started=${EPOCHREALTIME//[!0-9]/}
# Prints microseconds since the wrapper started (EPOCHREALTIME, any decimal mark).
elapsed_us() { echo $((${EPOCHREALTIME//[!0-9]/} - started)); }
{
  # Explicit stdin keeps native payloads attached to the background monitor.
  # TERM at 1.4 s, KILL 0.3 s later: the store gets time to remove its scratch
  # files, and everything still ends before the provider's 2 s deadline.
  /usr/bin/timeout --kill-after=0.3 1.4 /bin/bash "$script_dir/aranea-agent-hook-worker" "${1:-}" <&0 &
  worker_group=$!
  worker_status=0
  wait "$worker_group" || worker_status=$?
  # timeout can exit after the worker accepts TERM, leaving a resistant child.
  # Successful SessionStart leaves time for its background setsid to detach.
  # Wait up to 0.3 s for the group to finish its cleanup, but never past 1.8 s
  # in all; after timeout's own KILL (137) there is no time left to wait.
  if ((worker_status != 0)) && kill -0 -- "-$worker_group" 2>/dev/null; then
    if ((worker_status != 137)); then
      kill -TERM -- "-$worker_group" 2>/dev/null || true
      for _ in 1 2 3 4 5 6; do
        kill -0 -- "-$worker_group" 2>/dev/null || break
        (($(elapsed_us) < 1750000)) || break
        /bin/sleep 0.05
      done
    fi
    kill -KILL -- "-$worker_group" 2>/dev/null || true
  fi
} >/dev/null 2>&1
exit 0
