#!/usr/bin/env bash
# Adds, removes or reports the one marked quick switcher key binding in the
# user's Hyprland bindings.lua. Only the line ending in
# "-- aranea:projects-switcher" is ever touched; every other byte is kept.
# The file is never created, every write is atomic and followed by
# `hyprctl reload`, and a failed reload puts the previous bytes back.
# Usage: aranea-keybind status|remove [--json]
#        aranea-keybind add --key "SUPER + ALT + P" [--json]
# Output is always the JSON envelope {ok,data,error:{code,message,recovery}}
# and the exit status is 1 on failure.
# Errors: INVALID_KEY KEY_TAKEN NO_BINDINGS_FILE RELOAD_FAILED HYPRCTL_UNAVAILABLE
set -euo pipefail

marker='-- aranea:projects-switcher'
bindings="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
backup="$bindings.aranea.bak"

# Print a success envelope around the given JSON data.
ok() { jq -cn --argjson data "$1" '{ok:true,data:$data,error:null}'; }
# Print a failure envelope for CODE, MESSAGE, RECOVERY and exit 1.
fail() {
  jq -cn --arg code "$1" --arg message "$2" --arg recovery "$3" '{ok:false,data:null,error:{code:$code,message:$message,recovery:$recovery}}'
  exit 1
}

# Set canon to the canonical "SUPER + ALT + P" form of a typed key, or fail INVALID_KEY.
canonical_key() {
  local raw="$1" part mods="" key="" i count
  local -a parts=()
  local bad="Use modifiers from SUPER, CTRL, ALT and SHIFT plus one key, for example SUPER + ALT + P."
  if [[ ! $raw =~ ^[A-Za-z0-9\ +]+$ || $raw =~ ^[[:space:]]*\+ || $raw =~ \+[[:space:]]*$ || $raw == *++* ]]; then
    fail INVALID_KEY "That is not a usable key combination." "$bad"
  fi
  IFS=+ read -ra parts <<<"$raw"
  count=${#parts[@]}
  ((count >= 2)) || fail INVALID_KEY "A key combination needs at least one modifier." "$bad"
  for ((i = 0; i < count; i++)); do
    part="${parts[i]//[[:space:]]/}"
    part="${part^^}"
    [[ -n $part ]] || fail INVALID_KEY "That is not a usable key combination." "$bad"
    if ((i == count - 1)); then
      [[ $part =~ ^([A-Z0-9]|F([1-9]|1[0-2])|PERIOD|COMMA|SPACE|RETURN|SLASH)$ ]] || fail INVALID_KEY "That key is not supported." "$bad"
      key="$part"
    else
      case "$part" in
        SUPER | CTRL | ALT | SHIFT) ;;
        *) fail INVALID_KEY "$part is not a modifier." "$bad" ;;
      esac
      [[ $mods != *" $part "* ]] || fail INVALID_KEY "A modifier is repeated." "$bad"
      mods+=" $part "
    fi
  done
  local out="" m
  for m in SUPER CTRL ALT SHIFT; do
    [[ $mods == *" $m "* ]] && out+="$m + "
  done
  canon="$out$key"
}

# Print the Hyprland modifier mask (SHIFT 1, CTRL 4, ALT 8, SUPER 64) of a canonical key.
mask_of() {
  local mask=0 p
  for p in ${1//+/ }; do
    case "$p" in SHIFT) mask=$((mask + 1)) ;; CTRL) mask=$((mask + 4)) ;; ALT) mask=$((mask + 8)) ;; SUPER) mask=$((mask + 64)) ;; esac
  done
  printf '%s' "$mask"
}

# Print the description of another bind already using this canonical key, if any.
taken_by() {
  local key="$1" mask last binds
  mask=$(mask_of "$key")
  last="${key##* + }"
  binds=$(hyprctl -j binds 2>/dev/null) || return 2
  jq -r --argjson mask "$mask" --arg key "$last" '
    .[] | . as $b
      | ([1, 4, 8, 64] | map(select((($b.modmask // 0) / . | floor) % 2 == 1)) | add // 0) as $mods
      | select(($b.key | ascii_upcase) == $key and $mods == $mask)
      | select((($b.arg // "") | contains("araneadev.projects")) | not)
      | select($b.description != "Aranea project switcher")
      | ($b.description // "another binding")' <<<"$binds" | head -n 1
}

# Rewrite the bindings file text on stdout: MODE add (with LINE) or remove, or find.
rewrite() {
  local mode="$1" line="${2:-}" final_nl=1
  [[ -s $bindings && $(tail -c1 "$bindings" | od -An -c | tr -d ' ') != '\n' ]] && final_nl=0
  NEWLINE="$line" awk -v mode="$mode" -v marker="$marker" -v final_nl="$final_nl" '
    { body[NR] = $0; cr[NR] = 0; term[NR] = 1
      if (body[NR] ~ /\r$/) { sub(/\r$/, "", body[NR]); cr[NR] = 1 } }
    END {
      if (NR > 0 && !final_nl) term[NR] = 0
      first = 0
      for (i = 1; i <= NR; i++) {
        t = body[i]; sub(/^[ \t]+/, "", t)
        if (t !~ /^--/ && t ~ /^o\.bind\(/ && substr(t, length(t) - length(marker) - 1) == ") " marker) {
          man[i] = 1
          if (!first) first = i
        }
      }
      if (mode == "find") { if (first) { print body[first]; exit 0 } exit 3 }
      if (mode == "remove") {
        if (!first) exit 3
        for (i = 1; i <= NR; i++) if (!man[i]) { keep[++k] = i }
        if (man[NR] && !term[NR] && k > 0) { term[keep[k]] = 0; cr[keep[k]] = 0 }
        for (j = 1; j <= k; j++) emit(keep[j])
        exit 0
      }
      if (first) {
        body[first] = ENVIRON["NEWLINE"]
        for (i = 1; i <= NR; i++) if (!man[i] || i == first) emit(i)
        exit 0
      }
      eolcr = (NR > 0 && cr[1]) ? 1 : 0
      if (NR > 0 && !term[NR]) { if (!cr[NR]) cr[NR] = eolcr; term[NR] = 1; lastend = 0 } else lastend = 1
      for (i = 1; i <= NR; i++) emit(i)
      printf "%s", ENVIRON["NEWLINE"]
      if (lastend) printf "%s\n", eolcr ? "\r" : ""
    }
    function emit(i) { printf "%s%s%s", body[i], cr[i] ? "\r" : "", term[i] ? "\n" : "" }
  ' "$bindings"
}

# Replace the bindings file atomically with stdin content, keeping its mode.
write_atomic() {
  local tmp
  tmp=$(mktemp "$bindings.XXXXXX")
  cat >"$tmp"
  chmod --reference="$bindings" "$tmp"
  mv "$tmp" "$bindings"
}

# Put the backed up bytes back after a failed reload.
restore_backup() {
  local tmp
  tmp=$(mktemp "$bindings.XXXXXX")
  cp -p "$backup" "$tmp"
  mv "$tmp" "$bindings"
}

# Reload Hyprland; on any error restore the backup and fail RELOAD_FAILED.
reload_or_restore() {
  local out rc=0
  out=$(hyprctl reload 2>&1) || rc=$?
  if ((rc != 0)) || [[ ${out,,} == *error* ]]; then
    restore_backup
    fail RELOAD_FAILED "Hyprland did not accept the change, so it was undone." "Your bindings file is as it was. Check it for mistakes, then try again."
  fi
}

# Require the bindings file to exist; never create it.
need_file() { [[ -f $bindings ]] || fail NO_BINDINGS_FILE "No Hyprland bindings file was found." "Create ~/.config/hypr/bindings.lua first, then try again."; }

# Report whether the marked binding exists and which key it uses.
cmd_status() {
  local found key=""
  if [[ -f $bindings ]] && found=$(rewrite find); then
    key="${found#*\"}"
    key="${key%%\"*}"
    ok "$(jq -cn --arg k "$key" '{bound:true,key:$k}')"
  else
    ok '{"bound":false,"key":null}'
  fi
}

# Add or move the marked binding to the given key.
cmd_add() {
  local key="" taken line canon=""
  while (($#)); do
    case "$1" in
      --key)
        key="${2:-}"
        shift 2 || true
        ;;
      --json) shift ;;
      *) fail INVALID_KEY "Unknown option $1." "Use add --key \"SUPER + ALT + P\"." ;;
    esac
  done
  canonical_key "$key"
  key="$canon"
  need_file
  command -v hyprctl >/dev/null 2>&1 || fail HYPRCTL_UNAVAILABLE "Hyprland could not be reached." "Run this from your Hyprland session."
  taken=$(taken_by "$key") || fail HYPRCTL_UNAVAILABLE "Hyprland could not list its key bindings." "Run this from your Hyprland session."
  [[ -z $taken ]] || fail KEY_TAKEN "$key is already used by \"$taken\"." "Pick a different key combination."
  line="o.bind(\"$key\", \"Aranea project switcher\", \"omarchy-shell shell toggle araneadev.projects '{\\\"mode\\\":\\\"switcher\\\"}'\") $marker"
  cp -p "$bindings" "$backup"
  rewrite add "$line" | write_atomic
  reload_or_restore
  ok "$(jq -cn --arg k "$key" '{bound:true,key:$k}')"
}

# Remove the marked binding, if there is one.
cmd_remove() {
  need_file
  if ! rewrite find >/dev/null; then
    ok '{"removed":false}'
    return
  fi
  command -v hyprctl >/dev/null 2>&1 || fail HYPRCTL_UNAVAILABLE "Hyprland could not be reached." "Run this from your Hyprland session."
  cp -p "$bindings" "$backup"
  rewrite remove | write_atomic
  reload_or_restore
  ok '{"removed":true}'
}

# Dispatch the subcommand.
main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    status) cmd_status ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove ;;
    *) fail INVALID_KEY "Usage: aranea-keybind status|add|remove." "Use status, add --key KEY or remove." ;;
  esac
}
main "$@"
