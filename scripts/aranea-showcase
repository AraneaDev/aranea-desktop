#!/usr/bin/env bash
set -euo pipefail

# Lists the showcase surface ids, or checks that one exists and prints where
# it is documented.
#
# Usage: scripts/aranea-showcase [list|surface <name>]

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
surfaces=(desktop menu menu-submenu menu-search menu-input ceremony notifications clipboard emojis polkit health lock boot about idle file-manager editor network vpn audio bluetooth agents power monitor clock weather image-picker apps favorites recent dawn osd workspaces updates)

case "${1:-list}" in
  list)
    printf '%s\n' "${surfaces[@]}"
    ;;
  surface)
    requested="${2:-}"
    for surface in "${surfaces[@]}"; do
      if [[ "$surface" == "$requested" ]]; then
        printf 'surface: %s\n' "$surface"
        printf 'documentation: %s\n' "$repo_root/README.md"
        exit 0
      fi
    done
    printf 'Unknown surface: %s\n' "$requested" >&2
    exit 1
    ;;
  *)
    printf 'Usage: %s list|surface <name>\n' "$0" >&2
    exit 2
    ;;
esac
