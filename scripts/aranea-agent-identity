#!/bin/bash
# Usage: aranea-agent-identity (reads {provenance,terminalPid?,provider?}; read-only proof)
# Native process validation is shared with the hook adapter; terminal is an ancestor.
set -euo pipefail
export PATH=/usr/bin:/bin
unset BASH_ENV ENV CDPATH
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/agent-hooks.sh
source "$script_dir/lib/agent-hooks.sh"
[[ -x /usr/bin/jq ]] || {
  echo '{"ok":false,"verified":false,"code":"DEPENDENCY_MISSING"}'
  exit 4
}
request=$(head -c 65537 | jq -Rcse 'if utf8bytelength<=65536 then fromjson else error("too large") end' 2>/dev/null) || request=null
verified=false terminal=null
if jq -e 'type=="object" and (keys-["provenance","terminalPid","provider"]|length)==0 and (.provenance|type=="object") and ((has("provider")|not) or (.provider|IN("claude","codex")))' <<<"$request" >/dev/null 2>&1; then
  evidence=$(jq -c .provenance <<<"$request")
  if agent_hooks_validate_provenance "$evidence" "$(jq -r '.provider // ""' <<<"$request")" 2>/dev/null; then
    if jq -e 'has("terminalPid")' <<<"$request" >/dev/null; then
      terminal=$(jq -c --argjson pid "$(jq .terminalPid <<<"$request")" '[.ancestors[]|select(.pid==$pid)][0] // null' <<<"$evidence")
      [[ "$terminal" == null ]] || verified=true
    else verified=true; fi
  fi
fi
jq -cn --argjson verified "$verified" --argjson terminal "$terminal" '{ok:true,verified:$verified,terminal:$terminal}'
