#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_root/scripts/lib/manifest.sh"
source "$repo_root/scripts/lib/ownership.sh"

json=0
[[ "${1:-}" == "--json" ]] && json=1

emit() {
  local id="$1" status="$2" message="$3"
  if (( json )); then
    printf '{"id":"%s","status":"%s","message":"%s"}\n' "$id" "$status" "$message"
  else
    printf '%-14s %-8s %s\n' "$id" "$status" "$message"
  fi
}

theme="${ARANEA_DOCTOR_THEME:-}"
if [[ -z "$theme" ]] && command -v omarchy >/dev/null 2>&1; then
  theme="$(omarchy theme current 2>/dev/null || true)"
fi
if [[ "$theme" == "Aranea" || "$theme" == "aranea" ]]; then
  emit theme ok 'Aranea is the active theme'
else
  emit theme repair 'Aranea is not the active theme'
fi

hook_root="${ARANEA_DOCTOR_HOOK_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks}"
theme_hook="$hook_root/theme-set.d/theme-set"
post_boot_hook="$hook_root/post-boot.d/post-boot"

if [[ "${ARANEA_DOCTOR_HOOKS:-}" == ok ]]; then
  hooks_ok=1
elif [[ -f "$theme_hook" && -f "$post_boot_hook" ]] \
  && cmp -s "$repo_root/hooks/theme-set" "$theme_hook" \
  && cmp -s "$repo_root/hooks/post-boot" "$post_boot_hook"; then
  hooks_ok=1
else
  hooks_ok=0
fi

if (( hooks_ok )); then
  emit hooks ok 'theme-set and post-boot hooks reported healthy'
else
  emit hooks repair 'theme-set or post-boot hook is missing or stale'
fi

if [[ -f "$manifest_file" ]]; then
  emit manifest ok 'integration manifest is present'
else
  emit manifest repair 'theme-manifest.toml is missing'
fi

font_name="${ARANEA_DOCTOR_FONT:-monospace}"
if command -v fc-match >/dev/null 2>&1 && [[ -n "$(fc-match -f '%{family}\n' "$font_name" 2>/dev/null | head -1)" ]]; then
  emit fonts ok "fontconfig resolves $font_name"
else
  emit fonts repair "fontconfig cannot resolve $font_name"
fi

ownership_record_file="$(ownership_record)"
ownership_ok=1
ownership_count=0
if [[ -f "$ownership_record_file" ]]; then
  while IFS= read -r managed_target; do
    [[ -n "$managed_target" ]] || continue
    ownership_count=$((ownership_count + 1))
    if [[ ! -e "$managed_target" && ! -L "$managed_target" ]]; then
      ownership_ok=0
    elif [[ -L "$managed_target" && ! -e "$(readlink -f "$managed_target")" ]]; then
      ownership_ok=0
    fi
  done < "$ownership_record_file"
fi
if (( ownership_ok )); then
  emit ownership ok "${ownership_count} managed targets are present"
else
  emit ownership repair 'one or more managed targets are missing or stale'
fi

for optional in conky alacritty kitty foot starship tmux btop lazygit kvantummanager; do
  if command -v "$optional" >/dev/null 2>&1; then
    emit "$optional" ok 'optional command is available'
  else
    emit "$optional" skipped 'optional command is not installed'
  fi
done
