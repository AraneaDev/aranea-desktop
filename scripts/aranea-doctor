#!/usr/bin/env bash
set -euo pipefail

# Runs the Aranea health checks (theme, hooks, manifest, icons, fonts,
# ownership, shell, plugins, polkit, notifications, health, runtime log,
# qmllint, optional commands) and prints one "id status message" line per
# check, or one JSON object per line with --json. --fix reinstalls missing or
# stale hooks and, when omarchy-shell is available, redeploys the plugins
# before the plugin check. ARANEA_DOCTOR_* variables override inputs
# and individual checks (used by the tests).
#
# Usage: scripts/aranea-doctor [--json] [--fix]

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/paths.sh"
# shellcheck disable=SC1091
source "$repo_root/branding/brand.env"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/manifest.sh"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/ownership.sh"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/json-events.sh"

json=0
fix=0
for arg in "$@"; do
  case "$arg" in
    --json) json=1 ;;
    --fix) fix=1 ;;
  esac
done
# jq reads the shell's plugin list and the inbox files; ARANEA_DOCTOR_JQ
# overrides it (tests point it at a missing path).
jq_bin="${ARANEA_DOCTOR_JQ:-jq}"
have_jq=0
command -v "$jq_bin" >/dev/null 2>&1 && have_jq=1
if ((json)) && ((! have_jq)); then
  printf '%s\n' 'jq is required for --json' >&2
  exit 4
fi

doctor_has_repair=0
if ((json)); then
  json_started doctor '{}'
fi

# Prints one check result: ID, STATUS (ok, repair or skipped) and MESSAGE,
# as text or as JSON with --json.
emit() {
  local id="$1" status="$2" message="$3"
  if ((json)); then
    timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Keep id/status/message together for compatibility with consumers that
    # display the original doctor records, while adding the shared envelope.
    jq -cn --arg id "$id" --arg status "$status" --arg message "$message" --arg timestamp "$timestamp" \
      '{schema: 1, id: $id, status: $status, message: $message, event: "step", operation: "doctor", timestamp: $timestamp}'
  else
    printf '%-14s %-8s %s\n' "$id" "$status" "$message"
  fi
  if [[ "$status" == repair ]]; then
    doctor_has_repair=1
  fi
}

# Emits check ID with the status held in environment VARIABLE and returns 0
# when it is set; returns 1 otherwise so the real check runs.
emit_override() {
  local id="$1" variable="$2"
  local value="${!variable:-}"
  if [[ -n "$value" ]]; then
    emit "$id" "$value" "check overridden by $variable"
    return 0
  fi
  return 1
}

theme="${ARANEA_DOCTOR_THEME:-}"
if [[ -z "$theme" ]] && command -v omarchy >/dev/null 2>&1; then
  theme="$(omarchy theme current 2>/dev/null || true)"
fi
if [[ "$theme" == "Aranea" || "$theme" == "Aranea Pulse" || "$theme" == "aranea" || "$theme" == "aranea-pulse" ]]; then
  emit theme ok "$BRAND_NAME is the active theme"
else
  emit theme repair "$BRAND_NAME is not the active theme"
fi

# omarchy-hook installs under $HOME/.config regardless of XDG_CONFIG_HOME.
hook_root="${ARANEA_DOCTOR_HOOK_ROOT:-$HOME/.config/omarchy/hooks}"
theme_hook="$hook_root/theme-set.d/theme-set"
post_boot_hook="$hook_root/post-boot.d/post-boot"

# A stale or missing hook is what lets everything downstream of it (plugin
# registration in shell.json, integration re-linking) silently drift after an
# update: theme-set/post-boot never fire, so nothing re-runs
# repair-shell-config. Reinstalling the hook files directly is safe to redo
# unconditionally.
if ((fix)) && [[ -z "${ARANEA_DOCTOR_HOOKS:-}" ]]; then
  install -Dm755 "$repo_root/hooks/theme-set" "$theme_hook" 2>/dev/null || true
  install -Dm755 "$repo_root/hooks/post-boot" "$post_boot_hook" 2>/dev/null || true
fi

if [[ "${ARANEA_DOCTOR_HOOKS:-}" == ok ]]; then
  hooks_ok=1
elif [[ -f "$theme_hook" && -f "$post_boot_hook" ]] &&
  cmp -s "$repo_root/hooks/theme-set" "$theme_hook" &&
  cmp -s "$repo_root/hooks/post-boot" "$post_boot_hook"; then
  hooks_ok=1
else
  hooks_ok=0
fi

if ((hooks_ok)); then
  emit hooks ok 'theme-set and post-boot hooks reported healthy'
else
  emit hooks repair 'theme-set or post-boot hook is missing or stale'
fi

# shellcheck disable=SC2154 # defined by the sourced manifest library
if [[ -f "$manifest_file" ]]; then
  emit manifest ok 'integration manifest is present'
else
  emit manifest repair 'theme-manifest.toml is missing'
fi

icon_root="${ARANEA_DOCTOR_ICON_ROOT:-$(xdg_data_home)/icons/Aranea-icons}"
expected_icon_count="$(find "$repo_root/integrations/icons/aranea/scalable" -type f -name '*.svg' 2>/dev/null | wc -l)"
installed_icon_count=0
broken_icon_count=0
linked_icon_count=0
if [[ -d "$icon_root/scalable" ]]; then
  installed_icon_count="$(find "$icon_root/scalable" -type f -name '*.svg' -print 2>/dev/null | wc -l)"
  broken_icon_count="$(find "$icon_root/scalable" -xtype l -name '*.svg' -print 2>/dev/null | wc -l)"
  linked_icon_count="$(find "$icon_root/scalable" -type l -name '*.svg' -print 2>/dev/null | wc -l)"
fi
if [[ -f "$icon_root/index.theme" ]] && ((installed_icon_count == expected_icon_count)) && ((broken_icon_count == 0)) && ((linked_icon_count == 0)); then
  emit icons ok "$BRAND_NAME-icons has $installed_icon_count standalone SVGs"
else
  emit icons repair "$BRAND_NAME-icons is incomplete or linked to a missing checkout; run scripts/install-integration --yes icons"
fi

font_name="${ARANEA_DOCTOR_FONT:-monospace}"
if command -v fc-match >/dev/null 2>&1 && [[ -n "$(fc-match -f '%{family}\n' "$font_name" 2>/dev/null | head -1)" ]]; then
  emit fonts ok "fontconfig resolves $font_name"
else
  emit fonts repair "fontconfig cannot resolve $font_name"
fi

ownership_record_file="$(ownership_record)"
ownership_ok=1
ownership_count=0
ownership_customised=()
if [[ -f "$ownership_record_file" ]]; then
  while IFS= read -r managed_target; do
    [[ -n "$managed_target" ]] || continue
    ownership_count=$((ownership_count + 1))
    if [[ ! -e "$managed_target" && ! -L "$managed_target" ]]; then
      ownership_ok=0
    elif [[ -L "$managed_target" && ! -e "$(readlink -f "$managed_target")" ]]; then
      ownership_ok=0
    elif ! is_aranea_target "$managed_target"; then
      ownership_customised+=("$managed_target")
    fi
  done <"$ownership_record_file"
fi
if ((! ownership_ok)); then
  emit ownership repair 'one or more managed targets are missing or stale'
elif ((${#ownership_customised[@]} > 0)); then
  emit ownership ok "${ownership_count} managed targets, ${#ownership_customised[@]} customised and left alone: ${ownership_customised[*]:0:3}"
else
  emit ownership ok "${ownership_count} managed targets are present"
fi

if ! emit_override shell ARANEA_DOCTOR_SHELL_STATUS; then
  if command -v omarchy-shell >/dev/null 2>&1; then
    if omarchy-shell shell ping >/dev/null 2>&1; then
      emit shell ok 'omarchy-shell IPC is reachable'
    else
      emit shell repair 'omarchy-shell is installed but IPC did not respond'
    fi
  else
    emit shell skipped 'omarchy-shell is not installed'
  fi
fi

if ! emit_override plugins ARANEA_DOCTOR_PLUGINS_STATUS; then
  # deploy-plugins-safely reconciles shell.json against whatever plugin
  # directories actually exist on disk even when no plugin file changed, so
  # it also repairs the "deployed but never enabled" drift this doctor check
  # exists to catch.
  if ((fix)) && command -v omarchy-shell >/dev/null 2>&1 && [[ -x "$repo_root/scripts/deploy-plugins-safely" ]]; then
    "$repo_root/scripts/deploy-plugins-safely" "$repo_root" >/dev/null 2>&1 || true
  fi
  if ((! have_jq)); then
    emit plugins skipped 'jq is not installed'
  elif command -v omarchy-shell >/dev/null 2>&1; then
    plugin_json="$(omarchy-shell shell listPlugins 2>/dev/null || true)"
    if "$jq_bin" -e '
      ([.[] | select(.id == "araneadev.bar") | .enabled] | any) and
      ([.[] | select(.id == "araneadev.lock") | .enabled] | any) and
      ([.[] | select(.id == "araneadev.menu") | .enabled] | any) and
      ([.[] | select(.id == "araneadev.notifications") | .enabled] | any) and
      ([.[] | select(.id == "araneadev.osd") | .enabled] | any)
    ' <<<"$plugin_json" >/dev/null 2>&1; then
      emit plugins ok 'Aranea plugins are enabled'
    else
      emit plugins repair 'one or more Aranea plugins are disabled or missing'
    fi
  else
    emit plugins skipped 'plugin state requires omarchy-shell'
  fi
fi

# Exactly one polkit prompt should be enabled: Aranea's, or Omarchy's when
# the Aranea one is turned off. Without either, privileged actions cannot
# ask for a password. (Which one is a choice, so neither is required.)
if ! emit_override polkit ARANEA_DOCTOR_POLKIT_STATUS; then
  if ((! have_jq)); then
    emit polkit skipped 'jq is not installed'
  elif command -v omarchy-shell >/dev/null 2>&1; then
    polkit_json="$(omarchy-shell shell listPlugins 2>/dev/null || true)"
    polkit_owner="$("$jq_bin" -r '[.[] | select((.id == "araneadev.polkit" or .id == "omarchy.polkit") and .enabled) | .id] | first // ""' <<<"$polkit_json" 2>/dev/null || true)"
    case "$polkit_owner" in
      araneadev.polkit) emit polkit ok 'Aranea polkit prompt is enabled' ;;
      omarchy.polkit) emit polkit ok 'Omarchy polkit prompt is enabled' ;;
      *) emit polkit repair 'no polkit prompt is enabled; run omarchy restart shell after enabling one' ;;
    esac
  else
    emit polkit skipped 'polkit state requires omarchy-shell'
  fi
fi

if ! emit_override notifications ARANEA_DOCTOR_NOTIFICATIONS_STATUS; then
  inbox_root="${ARANEA_DOCTOR_INBOX_ROOT:-$HOME/.local/state/omarchy/notifications/inbox}"
  if ((! have_jq)); then
    emit notifications skipped 'jq is not installed'
  elif [[ ! -d "$inbox_root" ]]; then
    emit notifications skipped 'no notification inbox yet'
  else
    inbox_total=0
    inbox_bad=0
    for inbox_file in "$inbox_root"/*.json; do
      [[ -e "$inbox_file" ]] || continue
      inbox_total=$((inbox_total + 1))
      "$jq_bin" -e 'type == "object"' "$inbox_file" >/dev/null 2>&1 || inbox_bad=$((inbox_bad + 1))
    done
    if ((inbox_bad > 0)); then
      emit notifications repair "inbox holds $inbox_total entries, $inbox_bad unreadable"
    else
      emit notifications ok "inbox holds $inbox_total entries"
    fi
  fi
fi

if ! emit_override health ARANEA_DOCTOR_HEALTH_STATUS; then
  health_units=off
  health_disk=off
  health_reboot=off
  health_docker='off (docker not installed)'
  command -v systemctl >/dev/null 2>&1 && health_units=on
  command -v df >/dev/null 2>&1 && health_disk=on
  [[ -d /usr/lib/modules ]] && health_reboot=on
  if command -v docker >/dev/null 2>&1; then
    if docker info --format '{{.ServerVersion}}' >/dev/null 2>&1; then
      health_docker=on
    else
      health_docker='off (daemon not running)'
    fi
  fi
  terminal_bin="${ARANEA_DOCTOR_TERMINAL_BIN:-xdg-terminal-exec}"
  health_actions=on
  command -v "$terminal_bin" >/dev/null 2>&1 || health_actions="off ($terminal_bin missing)"
  # Docker is optional; the core checks and the click actions are not.
  health_status=ok
  if [[ "$health_units" != on || "$health_disk" != on || "$health_actions" != on ]]; then
    health_status=repair
  fi
  emit health "$health_status" "units $health_units, disk $health_disk, reboot $health_reboot, docker $health_docker, actions $health_actions"
fi

if ! emit_override runtime ARANEA_DOCTOR_RUNTIME_STATUS; then
  log_root="${ARANEA_DOCTOR_RUNTIME_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$UID}/quickshell/by-id}"
  log_file="$(find "$log_root" -type f -name log.log -printf '%T@ %p\n' 2>/dev/null | sort -nr | sed -n '1s/^[^ ]* //p' || true)"
  rg_bin="${ARANEA_DOCTOR_RG:-rg}"
  if ! command -v "$rg_bin" >/dev/null 2>&1; then
    emit runtime skipped 'rg is not installed'
  elif [[ -z "$log_file" ]]; then
    emit runtime skipped 'no QuickShell runtime log is available'
  else
    # rg exits 0 on a match, 1 on none, and 2 when it could not read the log.
    rg_status=0
    "$rg_bin" -qi 'TypeError|ReferenceError|duplicate.*target|coerced to void' "$log_file" || rg_status=$?
    case "$rg_status" in
      0) emit runtime repair "recent QuickShell runtime warnings found in $log_file" ;;
      1) emit runtime ok 'recent QuickShell log has no Aranea runtime errors' ;;
      *) emit runtime skipped 'rg failed' ;;
    esac
  fi
fi

if ! emit_override qmllint ARANEA_DOCTOR_QMLLINT_STATUS; then
  if command -v qmllint >/dev/null 2>&1; then
    emit qmllint ok "$(qmllint --version) is available"
  else
    emit qmllint skipped 'qmllint is not installed'
  fi
fi

for optional in alacritty kitty foot starship tmux btop lazygit kvantummanager; do
  if command -v "$optional" >/dev/null 2>&1; then
    emit "$optional" ok 'optional command is available'
  else
    emit "$optional" skipped 'optional command is not installed'
  fi
done

if ((json)); then
  if ((doctor_has_repair)); then
    json_completed doctor warning '' 'doctor found checks needing attention'
  else
    json_completed doctor ok '' 'doctor checks passed'
  fi
fi
