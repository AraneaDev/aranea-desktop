#!/usr/bin/env bash
# Versioned JSON boundary for settings. Helpers retain preference ownership.
# Usage: scripts/aranea-settings status --json | set motion|schedule on|off --json
#        scripts/aranea-settings set wallpaper ID --json | set integration ID active|inactive --json
#        scripts/aranea-settings configure schedule DAWN DAY DUSK NIGHT --json
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
operation=unknown
error_code=''
error_message=''
result_status=0
case "${1:-} ${2:-}" in
  status\ *) operation=status ;;
  'set motion') operation='set motion' ;;
  'set wallpaper') operation='set wallpaper' ;;
  'set schedule') operation='set schedule' ;;
  'configure schedule') operation='configure schedule' ;;
  'set integration') operation='set integration' ;;
esac
# Even without the serializer this constant object is one valid JSON result.
if ! command -v jq >/dev/null 2>&1; then
  echo 'jq is required for settings' >&2
  printf '%s\n' '{"schemaVersion":1,"ok":false,"operation":null,"state":null,"error":{"code":"DEPENDENCY_MISSING","message":"jq is required for settings"}}'
  exit 2
fi
scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT
# Invalid requests never reach helper mutation branches.
invalid() {
  error_code="$1"
  error_message="$2"
  result_status="${3:-2}"
}
# Accept only 24-hour HH:MM phase times before helper dispatch.
valid_time() { [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }
case "$operation" in
  status) [[ $# -eq 2 && "$2" == --json ]] || invalid INVALID_ARGUMENTS 'Expected status --json' ;;
  'set motion' | 'set schedule')
    if [[ $# -ne 4 || "${4:-}" != --json || ("${3:-}" != on && "${3:-}" != off) ]]; then
      invalid INVALID_ARGUMENTS 'Expected set motion|schedule on|off --json'
    fi
    ;;
  'set wallpaper') [[ $# -eq 4 && "$4" == --json && -n "$3" ]] || invalid INVALID_ARGUMENTS 'Expected set wallpaper <manifest-id> --json' ;;
  'set integration')
    if [[ $# -ne 5 || "${5:-}" != --json || -z "${3:-}" || ("${4:-}" != active && "${4:-}" != inactive) ]]; then
      invalid INVALID_ARGUMENTS 'Expected set integration <known-id> active|inactive --json'
    fi
    ;;
  'configure schedule')
    if [[ $# -ne 7 || "${7:-}" != --json ]]; then
      invalid INVALID_ARGUMENTS 'Expected configure schedule DAWN DAY DUSK NIGHT --json'
    else
      for value in "$3" "$4" "$5" "$6"; do
        valid_time "$value" || invalid INVALID_SCHEDULE 'Use four 24-hour HH:MM times in ascending order'
      done
      if [[ -z "$error_code" ]]; then
        ((10#${3/:/} < 10#${4/:/} && 10#${4/:/} < 10#${5/:/} && 10#${5/:/} < 10#${6/:/})) || invalid INVALID_SCHEDULE 'Schedule times must be strictly ascending'
      fi
    fi
    ;;
  *) invalid UNKNOWN_OPERATION 'Unknown settings operation' ;;
esac

# Capture JSON and diagnostics separately; retain partial JSON on read failure.
read_section() {
  local name="$1" fallback="$2" rc=0
  shift 2
  "$@" >"$scratch/$name" 2>"$scratch/$name.err" || rc=$?
  cat "$scratch/$name.err" >&2
  if ! jq -e 'type == "object"' "$scratch/$name" >/dev/null 2>&1; then
    printf '%s\n' "$fallback" >"$scratch/$name"
    rc=1
  fi
  ((rc == 0)) || reads_failed=1
}
# Aggregate independent owner reads while retaining available sections on failure.
refresh_state() {
  local rc=0
  reads_failed=0
  read_section motion '{"configured":null,"applied":null,"availability":"unavailable","application":"unavailable"}' "$script_dir/aranea-motion" status --json
  read_section wallpaper '{"activeId":null,"availability":"unavailable"}' "$script_dir/aranea-wallpaper" status --json
  read_section schedule '{"enabled":null,"applied":null,"dawn":null,"day":null,"dusk":null,"night":null,"availability":"unavailable"}' "$script_dir/aranea-wallpaper" schedule status --json
  catalog_availability=available
  "$script_dir/aranea-wallpaper" list --json >"$scratch/wallpapers" 2>"$scratch/wallpapers.err" || rc=$?
  cat "$scratch/wallpapers.err" >&2
  if ((rc != 0)) || ! jq -e 'type == "array"' "$scratch/wallpapers" >/dev/null 2>&1; then
    echo '[]' >"$scratch/wallpapers"
    catalog_availability=unavailable
    reads_failed=1
  fi
  rc=0
  "$script_dir/aranea-integrations" status --json >"$scratch/integrations.jsonl" 2>"$scratch/integrations.err" || rc=$?
  cat "$scratch/integrations.err" >&2
  integrations_availability=available
  if ((rc != 0)) || ! jq -se 'if all(.[]; type == "object" and (.id | type == "string") and (.status == "active" or .status == "inactive") and (.availability == "available" or .availability == "unavailable")) then . else error("Invalid integration status") end' "$scratch/integrations.jsonl" >"$scratch/integrations"; then
    echo '[]' >"$scratch/integrations"
    integrations_availability=unavailable
    reads_failed=1
  fi
  jq -cn --slurpfile motion "$scratch/motion" --slurpfile wallpaper "$scratch/wallpaper" \
    --slurpfile schedule "$scratch/schedule" --slurpfile integrations "$scratch/integrations" \
    --slurpfile wallpapers "$scratch/wallpapers" --arg catalog "$catalog_availability" --arg integrationsAvailability "$integrations_availability" \
    '{motion:$motion[0],wallpaper:$wallpaper[0],schedule:$schedule[0],integrations:$integrations[0],
      wallpapers:$wallpapers[0],wallpapersAvailability:$catalog,integrationsAvailability:$integrationsAvailability}' >"$scratch/state"
}
refresh_state
if [[ -z "$error_code" && "$operation" != status ]]; then
  case "$operation" in
    'set motion') [[ "$(jq -r '.motion.availability' "$scratch/state")" == available ]] || invalid STATE_UNAVAILABLE 'Motion preference is unreadable' 1 ;;
    'set schedule' | 'configure schedule') [[ "$(jq -r '.schedule.availability' "$scratch/state")" == available ]] || invalid STATE_UNAVAILABLE 'Schedule preference is unreadable' 1 ;;
    'set wallpaper')
      if [[ "$catalog_availability" != available ]]; then
        invalid STATE_UNAVAILABLE 'Wallpaper catalog is unreadable' 1
      elif ! jq -e --arg id "$3" 'any(.wallpapers[]; .id == $id)' "$scratch/state" >/dev/null; then
        invalid UNKNOWN_ID 'Unknown wallpaper ID' 1
      elif ! jq -e --arg id "$3" 'any(.wallpapers[]; .id == $id and .available)' "$scratch/state" >/dev/null; then
        invalid ASSET_UNAVAILABLE 'Wallpaper asset is unreadable or missing' 1
      fi
      ;;
    'set integration')
      if [[ "$integrations_availability" != available ]]; then
        invalid STATE_UNAVAILABLE 'Integration registry is unreadable' 1
      elif ! jq -e --arg id "$3" 'any(.integrations[]; .id == $id)' "$scratch/state" >/dev/null; then
        invalid UNKNOWN_ID 'Unknown integration ID' 1
      fi
      ;;
  esac
fi
if [[ -z "$error_code" && "$operation" != status ]]; then
  # Arguments are passed as arrays, never assembled into shell commands.
  case "$operation" in
    'set motion') argv=("$script_dir/aranea-motion" set "$3") ;;
    'set wallpaper') argv=("$script_dir/aranea-wallpaper" set "$3") ;;
    'set schedule') argv=("$script_dir/aranea-wallpaper" schedule "$3") ;;
    'configure schedule') argv=("$script_dir/aranea-wallpaper" schedule configure "$3" "$4" "$5" "$6") ;;
    'set integration')
      if [[ "$4" == active ]]; then
        argv=("$script_dir/aranea-integrations" activate "$3" --yes)
      else argv=("$script_dir/aranea-integrations" deactivate "$3"); fi
      ;;
  esac
  "${argv[@]}" >"$scratch/mutation.out" 2>"$scratch/mutation.err" || result_status=$?
  cat "$scratch/mutation.out" "$scratch/mutation.err" >&2
  if ((result_status != 0)); then
    error_code=HELPER_FAILED
    error_message="$(cat "$scratch/mutation.err")"
    [[ -n "$error_message" ]] || error_message='Settings helper failed; see diagnostics'
  fi
  refresh_state
fi
if [[ -z "$error_code" ]] && ((reads_failed)); then invalid STATE_UNAVAILABLE 'Some settings could not be read; retry the affected section' 1; fi
jq -cn --arg operation "$operation" --argjson ok "$([[ "$result_status" == 0 ]] && echo true || echo false)" \
  --slurpfile state "$scratch/state" --arg code "$error_code" --arg message "$error_message" \
  '{schemaVersion:1,ok:$ok,operation:$operation,state:$state[0],
    error:(if $code == "" then null else {code:$code,message:$message} end)}'
exit "$result_status"
