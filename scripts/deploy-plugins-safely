#!/usr/bin/env bash
set -euo pipefail

# Deploys Aranea's plugins from <theme-root>/plugins into the Omarchy plugin
# dir (default ~/.config/omarchy/plugins) when any of them changed, stopping
# the shell for the swap and restarting it after. Skips the deploy while the
# session is locked. Always reconciles shell.json via repair-shell-config.
#
# Usage: scripts/deploy-plugins-safely <theme-root> [target-root]

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/lib/paths.sh"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/lib/brand-assets.sh"

[[ $# -ge 1 && -n "$1" ]] || {
  echo "Usage: scripts/deploy-plugins-safely <theme-root> [target-root]" >&2
  exit 2
}
theme_root="$1"
target_root=${2:-$HOME/.config/omarchy/plugins}
deploy_plugin="$theme_root/scripts/deploy-plugin"

[[ -x "$deploy_plugin" ]] || {
  echo "plugin deployment helper is missing: $deploy_plugin" >&2
  exit 1
}

plugin_ids=(araneadev.shared araneadev.lock araneadev.menu araneadev.bar araneadev.notifications araneadev.health araneadev.clipboard araneadev.emojis araneadev.polkit araneadev.osd araneadev.workspaces araneadev.updates)
needs_deploy=0
for plugin_id in "${plugin_ids[@]}"; do
  source_dir="$theme_root/plugins/$plugin_id"
  target_dir="$target_root/$plugin_id"
  [[ -d "$source_dir" ]] || {
    echo "plugin source directory is missing: $source_dir" >&2
    exit 1
  }
  if [[ ! -d "$target_dir" ]] || ! diff -qr "$source_dir" "$target_dir" >/dev/null; then
    needs_deploy=1
  fi
done

# Plugins newer than the installed theme reference branding files the active
# theme lacks (a blank mark). Deploy anyway, but say what is missing and how
# to fix it. Omarchy keeps the active theme copy at this fixed location.
mapfile -t brand_missing < <(missing_brand_assets "$theme_root/plugins" "$HOME/.local/state/omarchy/current/theme")
if ((${#brand_missing[@]})); then
  echo "warning: the active theme lacks ${brand_missing[*]}, used by these plugins; update the theme with scripts/install.sh" >&2
fi

# Reconcile shell.json against whatever plugins actually exist on disk on
# every run, deploy or not. A plugin can land here without ever being
# registered (a manual deploy, an update that skipped the theme-set/post-boot
# hooks) and would otherwise stay silently disabled until something else
# happens to repair the config.
repair_shell_config() {
  local config_dir
  config_dir="$(dirname "$target_root")"
  if [[ -x "$theme_root/scripts/repair-shell-config" ]]; then
    "$theme_root/scripts/repair-shell-config" "$config_dir/shell.json" >/dev/null 2>&1 || true
  fi
}

if ((! needs_deploy)); then
  repair_shell_config
  exit 0
fi

# A live directory swap makes QuickShell reload plugins. Stop it first so its
# stock panels never observe the short interval between plugin generations.
if command -v omarchy-hyprland-session-locked >/dev/null 2>&1 &&
  omarchy-hyprland-session-locked; then
  echo "Skipping plugin deployment while the session is locked." >&2
  repair_shell_config
  exit 0
fi

shell_was_running=0
if omarchy-shell shell ping >/dev/null 2>&1; then
  shell_was_running=1
  quickshell kill -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell" --any-display >/dev/null
fi

restart_needed=$shell_was_running
# Restarts the shell when this run stopped it, and clears the polkit
# handover marker that the restart completes.
finish() {
  if ((restart_needed)); then
    restart_needed=0
    omarchy restart shell >/dev/null 2>&1 || true
    # This restart also completes any polkit agent handover.
    rm -f "$(aranea_state_root)/polkit-handover"
  fi
}
trap finish EXIT

for plugin_id in "${plugin_ids[@]}"; do
  "$deploy_plugin" "$theme_root/plugins/$plugin_id" "$target_root/$plugin_id"
done

repair_shell_config
