#!/usr/bin/env bash
# Public project commands: validate, submit once, and observe the live owner.
# Usage: aranea capabilities | projects COMMAND [OPTIONS] | desktop status [--json]
set -euo pipefail
# The installed user-bin symlink points to the stable theme executable.
# Resolve it before loading siblings, independently of the active theme.
script_path="${BASH_SOURCE[0]}"
if [[ -L "$script_path" ]]; then
  script_path="$(readlink -f -- "$script_path")"
fi
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
# shellcheck source=scripts/lib/json-events.sh
source "$script_dir/lib/json-events.sh"
# shellcheck source=scripts/lib/projects-cli.sh
source "$script_dir/lib/projects-cli.sh"
# shellcheck source=scripts/lib/project-actions-cli.sh
source "$script_dir/lib/project-actions-cli.sh"
# shellcheck source=scripts/lib/agents-cli.sh
source "$script_dir/lib/agents-cli.sh"
if [[ ${1:-} == agents ]]; then
  shift
  agents_cli_main "$@"
elif [[ ${1:-} == projects && (${2:-} == actions || ${2:-} == runs) ]]; then
  project_actions_cli_main "$@"
else
  projects_cli_main "$@"
fi
