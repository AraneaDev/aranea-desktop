#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_root/scripts/lib/manifest.sh"
source "$repo_root/scripts/lib/ownership.sh"

dry_run=0
assume_yes=0
integration=""

while (($#)); do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --yes) assume_yes=1 ;;
    -h|--help)
      printf '%s\n' 'Usage: scripts/install-integration [--dry-run] [--yes] <integration-id>'
      exit 0
      ;;
    -*) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) integration="$1" ;;
  esac
  shift
done

# --yes is accepted for CLI parity with install.sh, which passes it to
# every install-integration call uniformly; nothing here ever prompts, so
# the value itself has nothing to gate.
: "$assume_yes"

if [[ -z "$integration" ]]; then
  printf '%s\n' 'An integration ID is required.' >&2
  exit 2
fi
if ! manifest_integration_exists "$integration"; then
  printf 'Unknown integration: %s\n' "$integration" >&2
  exit 1
fi

optional_command="$(manifest_integration_field "$integration" optional_command || true)"
if [[ -n "$optional_command" ]]; then
  available=0
  IFS='|' read -r -a commands <<<"$optional_command"
  for command_name in "${commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then available=1; break; fi
  done
  if (( ! available )); then
    printf 'Skipping %s: optional command is not installed.\n' "$integration"
    exit 0
  fi
fi

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
install_one() {
  local source="$1" target="$2"
  if (( dry_run )); then
    printf 'would link %s -> %s\n' "$source" "$target"
  else
    link_managed_file "$target" "$source"
    printf 'linked %s -> %s\n' "$source" "$target"
  fi
}

install_generated() {
  local source="$1" target="$2"
  if (( dry_run )); then
    printf 'would copy %s -> %s\n' "$source" "$target"
  else
    backup_target "$target"
    mkdir -p "$(dirname "$target")"
    install -m644 "$source" "$target"
    record_managed_file "$target"
    printf 'copied %s -> %s\n' "$source" "$target"
  fi
}

case "$integration" in
  terminal)
    if command -v alacritty >/dev/null 2>&1; then
      install_one "$repo_root/integrations/terminal/alacritty.toml" "$config_root/alacritty/themes/aranea.toml"
    elif command -v kitty >/dev/null 2>&1; then
      install_one "$repo_root/integrations/terminal/kitty.conf" "$config_root/kitty/themes/aranea.conf"
    elif command -v foot >/dev/null 2>&1; then
      install_one "$repo_root/integrations/terminal/foot.ini" "$config_root/foot/themes/aranea.ini"
    fi
    ;;
  developer)
    command -v nvim >/dev/null 2>&1 && install_one "$repo_root/integrations/developer/neovim.lua" "$config_root/nvim/lua/plugins/aranea-theme.lua"
    command -v starship >/dev/null 2>&1 && install_one "$repo_root/integrations/developer/starship.toml" "$config_root/starship.toml"
    command -v tmux >/dev/null 2>&1 && install_one "$repo_root/integrations/developer/tmux.conf" "$config_root/tmux/themes/aranea.conf"
    command -v btop >/dev/null 2>&1 && install_one "$repo_root/integrations/developer/btop.theme" "$config_root/btop/themes/aranea.theme"
    command -v lazygit >/dev/null 2>&1 && install_one "$repo_root/integrations/developer/lazygit.yml" "$config_root/lazygit/themes/aranea.yml"
    ;;
  qt)
    if command -v kvantummanager >/dev/null 2>&1; then
      install_one "$repo_root/integrations/qt/kvantum/Aranea/Aranea.kvconfig" "$config_root/Kvantum/Aranea/Aranea.kvconfig"
      install_one "$repo_root/integrations/qt/kvantum/Aranea/Aranea.svg" "$config_root/Kvantum/Aranea/Aranea.svg"
    fi
    ;;
  browser)
    if command -v firefox >/dev/null 2>&1; then
      install_one "$repo_root/integrations/browser/firefox/userChrome.css" "$config_root/aranea/browser/firefox/userChrome.css"
      install_one "$repo_root/integrations/browser/firefox/userContent.css" "$config_root/aranea/browser/firefox/userContent.css"
    fi
    if command -v chromium >/dev/null 2>&1; then
      install_one "$repo_root/integrations/browser/chromium/new-tab/index.html" "$config_root/aranea/browser/chromium/new-tab/index.html"
      install_one "$repo_root/integrations/browser/chromium/new-tab/style.css" "$config_root/aranea/browser/chromium/new-tab/style.css"
    fi
    ;;
  session)
    install_one "$repo_root/integrations/session/omarchy.css" "$config_root/omarchy/session/aranea.css"
    ;;
  cursor)
    cursor_root="${XDG_DATA_HOME:-$HOME/.local/share}/icons/Aranea"
    install_one "$repo_root/integrations/cursor/index.theme" "$cursor_root/index.theme"
    install_one "$repo_root/integrations/cursor/uwsm-env" "$config_root/uwsm/env.d/aranea-cursor"
    if [[ -d "$repo_root/integrations/cursor/hyprcursor" ]]; then
      if (( dry_run )); then
        printf 'would link %s -> %s\n' "$repo_root/integrations/cursor/hyprcursor" "$cursor_root"
      else
        hyprcursor_tmp="$(mktemp -d)"
        trap 'rm -rf -- "$hyprcursor_tmp"' RETURN
        mkdir -p "$hyprcursor_tmp/out"
        if command -v hyprcursor-util >/dev/null 2>&1; then
          hyprcursor-util --create "$repo_root/integrations/cursor/hyprcursor" \
            --output "$hyprcursor_tmp/out" >/dev/null
          compiled_root="$hyprcursor_tmp/out/theme_Aranea"
          install_generated "$compiled_root/manifest.hl" "$cursor_root/manifest.hl"
          for compiled_cursor in "$compiled_root"/hyprcursors/*.hlc; do
            install_generated "$compiled_cursor" "$cursor_root/hyprcursors/$(basename "$compiled_cursor")"
          done
        fi
      fi
    fi
    for cursor_asset in left_ptr.svg hand2.svg watch.svg crosshair.svg; do
      install_one "$repo_root/integrations/cursor/cursors/$cursor_asset" "$cursor_root/cursors/$cursor_asset"
    done

    # SVG files are useful source artwork but are not loadable Xcursor assets.
    # Compile them when the host has the standard Xcursor helper, then select
    # the theme in both the desktop settings and the running Hyprland session.
    if ! (( dry_run )) && command -v xcursorgen >/dev/null 2>&1 &&
       { command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; }; then
      cursor_tmp="$(mktemp -d)"
      trap 'rm -rf -- "$cursor_tmp"' RETURN
      for cursor_spec in \
        "left_ptr 2 2" \
        "hand2 16 16" \
        "watch 16 16" \
        "crosshair 16 16"; do
        read -r cursor_name hotspot_x hotspot_y <<<"$cursor_spec"
        cursor_cfg="$cursor_tmp/$cursor_name.cfg"
        : >"$cursor_cfg"
        if [[ "$cursor_name" == watch ]]; then
          for frame in 01 02 03 04 05 06 07 08; do
            source_svg="$repo_root/integrations/cursor/cursors/watch-$frame.svg"
            raster_png="$cursor_tmp/watch-$frame.png"
            if command -v magick >/dev/null 2>&1; then
              magick -background none "$source_svg" -resize 32x32 "$raster_png"
            else
              convert -background none "$source_svg" -resize 32x32 "$raster_png"
            fi
            printf '32 %s %s %s 140\n' "$hotspot_x" "$hotspot_y" "$raster_png" >>"$cursor_cfg"
          done
        else
          source_svg="$repo_root/integrations/cursor/cursors/$cursor_name.svg"
          raster_png="$cursor_tmp/$cursor_name.png"
          if command -v magick >/dev/null 2>&1; then
            magick -background none "$source_svg" -resize 32x32 "$raster_png"
          else
            convert -background none "$source_svg" -resize 32x32 "$raster_png"
          fi
          printf '32 %s %s %s\n' "$hotspot_x" "$hotspot_y" "$raster_png" >>"$cursor_cfg"
        fi
        xcursorgen "$cursor_cfg" "$cursor_root/cursors/$cursor_name"
      done
      if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface cursor-theme Aranea >/dev/null 2>&1 || true
      fi
      if command -v hyprctl >/dev/null 2>&1; then
        hyprctl setcursor Aranea "${XCURSOR_SIZE:-24}" >/dev/null 2>&1 || true
      fi
    fi
    ;;
  icons)
    # Aranea overrides the Wave 1 file-manager core and falls back to a muted,
    # accent-toned host variant for every unsupported name. Keep the install
    # recursive so new contexts do not require another installer branch.
    icon_theme=Aranea-icons
    icon_root="${XDG_DATA_HOME:-$HOME/.local/share}/icons/$icon_theme"
    install_one "$repo_root/integrations/icons/aranea/index.theme" "$icon_root/index.theme"
    while IFS= read -r icon_source; do
      icon_relative="${icon_source#"$repo_root/integrations/icons/aranea/"}"
      install_one "$icon_source" "$icon_root/$icon_relative"
    done < <(find "$repo_root/integrations/icons/aranea/scalable" -type f -name '*.svg' -print | sort)
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      if (( dry_run )); then
        printf 'would refresh GTK icon cache at %s\n' "$icon_root"
      else
        gtk-update-icon-cache -f -t "$icon_root" >/dev/null 2>&1 || true
      fi
    fi
    if command -v gsettings >/dev/null 2>&1; then
      if (( dry_run )); then
        printf 'would set desktop icon theme to %s\n' "$icon_theme"
        printf 'would set Nautilus icon/list zoom to small\n'
      else
        gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" >/dev/null 2>&1 || true
        gsettings set org.gnome.nautilus.icon-view default-zoom-level small >/dev/null 2>&1 || true
        gsettings set org.gnome.nautilus.list-view default-zoom-level small >/dev/null 2>&1 || true
        printf 'set desktop icon theme to %s\n' "$icon_theme"
      fi
    fi
    ;;
  media)
    if command -v pavucontrol >/dev/null 2>&1 || command -v pwvucontrol >/dev/null 2>&1; then
      install_one "$repo_root/integrations/media/pavucontrol.css" "$config_root/aranea/media/pavucontrol.css"
    fi
    ;;
  *)
    printf 'Integration %s has no file targets in this phase.\n' "$integration"
    ;;
esac
