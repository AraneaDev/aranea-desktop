#!/usr/bin/env bash
set -euo pipefail

# Registers Aranea in the Omarchy shell.json: sets the Aranea bar, swaps the
# stock menu entry for Aranea's, enables the Aranea plugins and disables the
# stock ones they replace, and places the notification bell, the health icon
# and the VPN icon once each (again after release-shell-config parked them):
# an icon the user took out of the bar stays out. Keeps a one-time
# .aranea.bak backup and writes through a symlink.
#
# Usage: scripts/repair-shell-config [shell.json]

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/lib/paths.sh"
config_file="${1:-$(xdg_config_home)/omarchy/shell.json}"

if [[ ! -f "$config_file" ]]; then
  printf 'Shell config not found: %s\n' "$config_file" >&2
  exit 0
fi
command -v jq >/dev/null 2>&1 || {
  printf 'jq is required to repair shell config: %s\n' "$config_file" >&2
  exit 1
}

# The directory of the config path as given: the shell (and the plugin
# deploy) work from there, even when shell.json is a symlink elsewhere.
given_config_dir="$(dirname "$config_file")"

# Write through a symlinked shell.json (dotfile managers) instead of
# replacing the link with a plain file (the .aranea.bak backup then sits
# next to the real file too).
resolved_config="$(readlink -f -- "$config_file" 2>/dev/null || true)"
[[ -n "$resolved_config" ]] && config_file="$resolved_config"

config_dir="$(dirname "$config_file")"
tmp_file="$(mktemp "$config_dir/.shell.json.aranea.XXXXXX")"
backup_file="$config_file.aranea.bak"
state_root="$(aranea_state_root)"
bell_marker="$state_root/notifications-widget-placed"
# Written by release-shell-config when another theme took the bell out of the
# bar; it overrides the once-only marker so returning to Aranea restores it.
parked_marker="$state_root/notifications-widget-parked"
place_bell=true
[[ -e "$bell_marker" && ! -e "$parked_marker" ]] && place_bell=false
health_marker="$state_root/health-widget-placed"
health_parked="$state_root/health-widget-parked"
place_health=true
[[ -e "$health_marker" && ! -e "$health_parked" ]] && place_health=false
vpn_marker="$state_root/vpn-widget-placed"
vpn_parked="$state_root/vpn-widget-parked"
place_vpn=true
[[ -e "$vpn_marker" && ! -e "$vpn_parked" ]] && place_vpn=false
# araneadev.audio, araneadev.bluetooth, araneadev.clock, araneadev.monitor,
# araneadev.network, araneadev.power, araneadev.weather, araneadev.tray and
# araneadev.agents only take over their bar entry once they are actually
# deployed beside this config (deploy-plugins-safely writes their manifest
# there); a repair that runs before that (a bare hook, a partial install)
# must not retarget the id to a plugin that does not exist on disk yet. The
# deploy writes beside the config path as given; beside a symlink's target
# counts too. araneadev.vpn is not a clone (there is no stock entry to
# retarget): the same guard just decides whether its own bar entry gets
# inserted at all.
audio_installed=false
bluetooth_installed=false
clock_installed=false
monitor_installed=false
network_installed=false
power_installed=false
weather_installed=false
tray_installed=false
agents_installed=false
settings_installed=false
vpn_installed=false
for dir in "$given_config_dir" "$config_dir"; do
  [[ -f "$dir/plugins/araneadev.settings/manifest.json" ]] && settings_installed=true
  [[ -f "$dir/plugins/araneadev.audio/manifest.json" ]] && audio_installed=true
  [[ -f "$dir/plugins/araneadev.bluetooth/manifest.json" ]] && bluetooth_installed=true
  [[ -f "$dir/plugins/araneadev.clock/manifest.json" ]] && clock_installed=true
  [[ -f "$dir/plugins/araneadev.monitor/manifest.json" ]] && monitor_installed=true
  [[ -f "$dir/plugins/araneadev.network/manifest.json" ]] && network_installed=true
  [[ -f "$dir/plugins/araneadev.power/manifest.json" ]] && power_installed=true
  [[ -f "$dir/plugins/araneadev.weather/manifest.json" ]] && weather_installed=true
  [[ -f "$dir/plugins/araneadev.tray/manifest.json" ]] && tray_installed=true
  [[ -f "$dir/plugins/araneadev.agents/manifest.json" ]] && agents_installed=true
  [[ -f "$dir/plugins/araneadev.vpn/manifest.json" ]] && vpn_installed=true
done
# Removes the temp file on exit.
cleanup() { rm -f "$tmp_file"; }
trap cleanup EXIT

# Which polkit agent this config enables. An agent registers once per shell
# process, so a change of owner needs a shell restart: leave a marker for
# finish-polkit-handover (the hooks run it) instead of restarting from here.
polkit_owner() {
  jq -r 'if ([.plugins[]? | (if type == "string" then . else .id? end)] | index("araneadev.polkit")) != null
            and (((.disabledPlugins // []) | index("omarchy.polkit")) != null)
         then "aranea" else "stock" end' "$1" 2>/dev/null || echo unknown
}
# Leaves the polkit-handover marker when the rewrite changes which polkit
# agent is enabled.
note_polkit_handover() {
  if [[ "$(polkit_owner "$config_file")" != "$(polkit_owner "$tmp_file")" ]]; then
    mkdir -p "$state_root"
    : >"$state_root/polkit-handover"
  fi
}

jq --argjson settings "$settings_installed" --argjson place "$place_bell" --argjson placeHealth "$place_health" --argjson audio "$audio_installed" --argjson bluetooth "$bluetooth_installed" --argjson clock "$clock_installed" --argjson monitor "$monitor_installed" --argjson network "$network_installed" --argjson power "$power_installed" --argjson weather "$weather_installed" --argjson tray "$tray_installed" --argjson agents "$agents_installed" --argjson vpn "$vpn_installed" --argjson placeVpn "$place_vpn" '
  def entry_id: if type == "string" then . else .id? end;
  # Drops later duplicates by id (string or {id} entries), keeping order.
  def dedupe_by_id: reduce .[] as $e ([]; ($e | entry_id) as $id | if ([.[] | entry_id] | index($id)) != null then . else . + [$e] end);
  # Whether araneadev.vpn already sits anywhere in the bar layout.
  def vpn_present: ([.bar.layout[]? | arrays | .[] | entry_id] | index("araneadev.vpn")) != null;
  # The single layout section to insert araneadev.vpn into: the first, in a
  # fixed scan order (right, center, left, then any other section in the
  # layout object own key order), whose array holds a network entry
  # (araneadev.network or omarchy.network). Returns null when no section
  # holds one, so the caller falls back to appending onto "right" instead.
  # Only ever one section is chosen, so the insert never runs twice even
  # when both the araneadev and omarchy ids appear in different sections.
  def vpn_target_section:
    (.bar.layout) as $layout
    | (["right", "center", "left"] + (($layout | keys) - ["right", "center", "left"])) as $order
    | ($order
        | map(select(($layout[.] | type) == "array"
            and (($layout[.] | map(entry_id)) as $ids
                 | ($ids | index("araneadev.network")) != null or ($ids | index("omarchy.network")) != null)))
        | .[0]);
  .bar = ((.bar // {}) + {id: "araneadev.bar"})
  # Aranea bar widgets take the place of their stock entries (release hands
  # them back), while preserving the user layout position and inline settings.
  | (if (.bar.layout | type) == "object" then
       .bar.layout |= with_entries(.value |= (if type == "array" then
         map(if type == "string" then (if . == "omarchy.menu" then "araneadev.menu" else . end)
             | if . == "omarchy.workspaces" then "araneadev.workspaces" else . end
             | if . == "omarchy.system-update" then "araneadev.updates" else . end
             | if $audio and . == "omarchy.audio" then "araneadev.audio" else . end
             | if $bluetooth and . == "omarchy.bluetooth" then "araneadev.bluetooth" else . end
             | if $clock and . == "omarchy.clock" then "araneadev.clock" else . end
             | if $monitor and . == "omarchy.monitor" then "araneadev.monitor" else . end
             | if $network and . == "omarchy.network" then "araneadev.network" else . end
             | if $power and . == "omarchy.power" then "araneadev.power" else . end
             | if $weather and . == "omarchy.weather" then "araneadev.weather" else . end
             | if $tray and . == "omarchy.tray" then "araneadev.tray" else . end
             | if $agents and . == "omarchy.agents" then "araneadev.agents" else . end
             elif type == "object" and .id == "omarchy.menu" then .id = "araneadev.menu"
             elif type == "object" and .id == "omarchy.workspaces" then .id = "araneadev.workspaces"
             elif type == "object" and .id == "omarchy.system-update" then .id = "araneadev.updates"
             elif $audio and type == "object" and .id == "omarchy.audio" then .id = "araneadev.audio"
             elif $bluetooth and type == "object" and .id == "omarchy.bluetooth" then .id = "araneadev.bluetooth"
             elif $clock and type == "object" and .id == "omarchy.clock" then .id = "araneadev.clock"
             elif $monitor and type == "object" and .id == "omarchy.monitor" then .id = "araneadev.monitor"
             elif $network and type == "object" and .id == "omarchy.network" then .id = "araneadev.network"
             elif $power and type == "object" and .id == "omarchy.power" then .id = "araneadev.power"
             elif $weather and type == "object" and .id == "omarchy.weather" then .id = "araneadev.weather"
             elif $tray and type == "object" and .id == "omarchy.tray" then .id = "araneadev.tray"
             elif $agents and type == "object" and .id == "omarchy.agents" then .id = "araneadev.agents"
             else . end)
       else . end))
     else . end)
  # The bar center anchor (the widget the center cluster expands/collapses
  # around) retargets the same way, and only under the same guard: an anchor
  # pointed at a plugin that is not deployed yet would make the bar center on
  # nothing.
  | (if $clock and (.bar.centerAnchor? == "omarchy.clock") then .bar.centerAnchor = "araneadev.clock" else . end)
  # araneadev.vpn is not a clone (there is no stock entry to swap): it gets
  # its own bar entry inserted right after the network entry, in the single
  # layout section vpn_target_section picks (the araneadev.network index
  # wins over the omarchy.network index within that section, even when
  # omarchy.network comes first in the array). With no network entry
  # anywhere, it goes on the end of the right section instead. Skipped
  # entirely once already present anywhere in the layout, so a second
  # repair never duplicates it, and only ever one section is touched, so a
  # network entry split across two sections never inserts twice. Placed
  # once ($placeVpn): an icon the user removed stays removed until a
  # release parks it.
  | (if $vpn and $placeVpn and (.bar.layout | type) == "object" and (vpn_present | not) then
       (vpn_target_section) as $section
       | if $section != null then
           .bar.layout[$section] |= (
             (map(entry_id)) as $ids
             | (($ids | index("araneadev.network")) // ($ids | index("omarchy.network"))) as $netIdx
             | .[0:($netIdx + 1)] + [{id: "araneadev.vpn"}] + .[($netIdx + 1):])
         elif (.bar.layout.right | type) == "array" then
           .bar.layout.right += [{id: "araneadev.vpn"}]
         else . end
     else . end)
  | .plugins = ((if (.plugins | type) == "array" then .plugins else [] end) + [
      {id: "araneadev.lock"},
      {id: "araneadev.notifications"},
      {id: "araneadev.health"},
      {id: "araneadev.clipboard"},
      {id: "araneadev.emojis"},
      {id: "araneadev.osd"},
      {id: "araneadev.polkit"},
      {id: "araneadev.workspaces"},
      {id: "araneadev.updates"}
    ] + (if $settings then [{id: "araneadev.settings"}] else [] end) | dedupe_by_id)
  | .disabledPlugins = (((.disabledPlugins // []) + [
      "omarchy.bar",
      "omarchy.clipboard",
      "omarchy.emojis",
      "omarchy.lock",
      "omarchy.menu",
      "omarchy.notifications",
      "omarchy.osd",
      "omarchy.polkit"
    ]) | unique | sort)
  # Tell the host to re-enable the Omarchy plugin if the user ever disables
  # an Aranea clone by hand (host bookkeeping for cloned plugins; for polkit
  # this keeps an agent registered).
  | .cloneSourceRestores = ((if (.cloneSourceRestores | type) == "array" then .cloneSourceRestores else [] end)
      + ["araneadev.notifications", "araneadev.clipboard", "araneadev.emojis", "araneadev.polkit", "araneadev.lock", "araneadev.osd", "araneadev.menu"]
      + (if $audio then ["araneadev.audio"] else [] end)
      + (if $bluetooth then ["araneadev.bluetooth"] else [] end)
      + (if $clock then ["araneadev.clock"] else [] end)
      + (if $monitor then ["araneadev.monitor"] else [] end)
      + (if $network then ["araneadev.network"] else [] end)
      + (if $power then ["araneadev.power"] else [] end)
      + (if $weather then ["araneadev.weather"] else [] end)
      + (if $tray then ["araneadev.tray"] else [] end)
      + (if $agents then ["araneadev.agents"] else [] end) | unique)
  # Place the notification bell once, right after the tray (the tray leads
  # the right section, then health, then the bell). Layout entries may be
  # plain id strings or {id: ...} objects; both count. Only a layout the
  # user already owns is touched: writing a partial layout would replace the
  # host defaults. The tray entry is looked up as araneadev.tray first (it
  # may already have been retargeted above, in the same pass) and
  # omarchy.tray otherwise, so placement is unaffected by whether the tray
  # retarget has run yet.
  | if $place
       and ((.bar.layout.right | type) == "array")
       and ([.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.notifications") == null)
    then .bar.layout.right |= (
      (map(if type == "string" then . else .id? end)) as $ids
      | (($ids | index("araneadev.tray")) // ($ids | index("omarchy.tray"))) as $trayAt
      | if $trayAt == null then [{id: "araneadev.notifications"}] + .
        else .[:$trayAt + 1] + [{id: "araneadev.notifications"}] + .[$trayAt + 1:] end)
    else . end
  # Place the health icon once: before the bell when the bell is in the right
  # section, else right after the tray, else first.
  | if $placeHealth
       and ((.bar.layout.right | type) == "array")
       and ([.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.health") == null)
    then .bar.layout.right |= (
      (map(if type == "string" then . else .id? end)) as $ids
      | ($ids | index("araneadev.notifications")) as $bell
      | (($ids | index("araneadev.tray")) // ($ids | index("omarchy.tray"))) as $trayAt
      | if $bell != null then .[:$bell] + [{id: "araneadev.health"}] + .[$bell:]
        elif $trayAt != null then .[:$trayAt + 1] + [{id: "araneadev.health"}] + .[$trayAt + 1:]
        else [{id: "araneadev.health"}] + . end)
    else . end
' "$config_file" >"$tmp_file"

if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.notifications") != null' "$tmp_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$bell_marker"
  rm -f "$parked_marker"
fi
if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.health") != null' "$tmp_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$health_marker"
  rm -f "$health_parked"
fi
if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.vpn") != null' "$tmp_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$vpn_marker"
  rm -f "$vpn_parked"
fi

note_polkit_handover

if cmp -s "$config_file" "$tmp_file"; then
  printf 'shell config already repaired: %s\n' "$config_file"
  exit 0
fi

if [[ ! -e "$backup_file" ]]; then
  cp -p "$config_file" "$backup_file"
fi
chmod --reference="$config_file" "$tmp_file"
mv -f "$tmp_file" "$config_file"
printf 'repaired shell config: %s\n' "$config_file"
