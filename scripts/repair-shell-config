#!/usr/bin/env bash
set -euo pipefail

# Registers Aranea in the Omarchy shell.json: sets the Aranea bar, swaps the
# stock menu entry for Aranea's, enables the Aranea plugins and disables the
# stock ones they replace, and places the notification bell and health icon
# once (again after release-shell-config parked them). Keeps a one-time
# .aranea.bak backup and writes through a symlink.
#
# Usage: scripts/repair-shell-config [shell.json]

config_file="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json}"

if [[ ! -f "$config_file" ]]; then
  printf 'Shell config not found: %s\n' "$config_file" >&2
  exit 0
fi
command -v jq >/dev/null 2>&1 || {
  printf 'jq is required to repair shell config: %s\n' "$config_file" >&2
  exit 1
}

# Write through a symlinked shell.json (dotfile managers) instead of
# replacing the link with a plain file (the .aranea.bak backup then sits
# next to the real file too).
resolved_config="$(readlink -f -- "$config_file" 2>/dev/null || true)"
[[ -n "$resolved_config" ]] && config_file="$resolved_config"

config_dir="$(dirname "$config_file")"
tmp_file="$(mktemp "$config_dir/.shell.json.aranea.XXXXXX")"
backup_file="$config_file.aranea.bak"
state_root="${ARANEA_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/aranea}"
bell_marker="$state_root/notifications-widget-placed"
# Written by release-shell-config when another theme took the bell out of the
# bar; it overrides the once-only marker so returning to Aranea restores it.
parked_marker="$state_root/notifications-widget-parked"
place_bell=true
[[ -e "$bell_marker" && ! -e "$parked_marker" ]] && place_bell=false
health_marker="$state_root/health-widget-placed"
health_parked="$state_root/health-widget-parked"
place_health=true
[[ -e "$health_marker" && ! -e "$health_parked" ]] && place_health=false
# Removes the temp file on exit.
cleanup() { rm -f "$tmp_file"; }
trap cleanup EXIT

# Which polkit agent this config enables. An agent registers once per shell
# process, so a change of owner needs a shell restart: leave a marker for
# finish-polkit-handover (the hooks run it) instead of restarting from here.
polkit_owner() {
  jq -r 'if ([.plugins[]? | (if type == "string" then . else .id? end)] | index("araneadev.polkit")) != null
            and (((.disabledPlugins // []) | index("omarchy.polkit")) != null)
         then "aranea" else "stock" end' "$1" 2>/dev/null || echo unknown
}
# Leaves the polkit-handover marker when the rewrite changes which polkit
# agent is enabled.
note_polkit_handover() {
  if [[ "$(polkit_owner "$config_file")" != "$(polkit_owner "$tmp_file")" ]]; then
    mkdir -p "$state_root"
    : >"$state_root/polkit-handover"
  fi
}

jq --argjson place "$place_bell" --argjson placeHealth "$place_health" '
  def entry_id: if type == "string" then . else .id? end;
  # Drops later duplicates by id (string or {id} entries), keeping order.
  def dedupe_by_id: reduce .[] as $e ([]; ($e | entry_id) as $id | if ([.[] | entry_id] | index($id)) != null then . else . + [$e] end);
  .bar = ((.bar // {}) + {id: "araneadev.bar"})
  # The Aranea menu takes the place of the stock menu entry (release hands it back).
  | (if (.bar.layout | type) == "object" then
       .bar.layout |= with_entries(.value |= (if type == "array" then
         map(if type == "string" then (if . == "omarchy.menu" then "araneadev.menu" else . end)
             elif type == "object" and .id == "omarchy.menu" then .id = "araneadev.menu"
             else . end)
       else . end))
     else . end)
  | .plugins = ((if (.plugins | type) == "array" then .plugins else [] end) + [
      {id: "araneadev.lock"},
      {id: "araneadev.notifications"},
      {id: "araneadev.health"},
      {id: "araneadev.clipboard"},
      {id: "araneadev.emojis"},
      {id: "araneadev.osd"},
      {id: "araneadev.polkit"}
    ] | dedupe_by_id)
  | .disabledPlugins = (((.disabledPlugins // []) + [
      "omarchy.bar",
      "omarchy.clipboard",
      "omarchy.emojis",
      "omarchy.lock",
      "omarchy.menu",
      "omarchy.notifications",
      "omarchy.osd",
      "omarchy.polkit"
    ]) | unique | sort)
  # Tell the host to re-enable the Omarchy plugin if the user ever disables
  # an Aranea clone by hand (host bookkeeping for cloned plugins; for polkit
  # this keeps an agent registered).
  | .cloneSourceRestores = ((if (.cloneSourceRestores | type) == "array" then .cloneSourceRestores else [] end)
      + ["araneadev.notifications", "araneadev.clipboard", "araneadev.emojis", "araneadev.polkit", "araneadev.lock", "araneadev.osd", "araneadev.menu"] | unique)
  # Place the notification bell once. Layout entries may be plain id strings
  # or {id: ...} objects; both count. Only a layout the user already owns is
  # touched: writing a partial layout would replace the host defaults.
  | if $place
       and ((.bar.layout.right | type) == "array")
       and ([.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.notifications") == null)
    then .bar.layout.right |= (
      (map(if type == "string" then . else .id? end) | index("omarchy.tray")) as $tray
      | if $tray == null then [{id: "araneadev.notifications"}] + .
        else .[:$tray] + [{id: "araneadev.notifications"}] + .[$tray:] end)
    else . end
  # Place the health icon once: before the bell when the bell is in the right
  # section, else before the tray, else first.
  | if $placeHealth
       and ((.bar.layout.right | type) == "array")
       and ([.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.health") == null)
    then .bar.layout.right |= (
      (map(if type == "string" then . else .id? end)) as $ids
      | ($ids | index("araneadev.notifications")) as $bell
      | ($ids | index("omarchy.tray")) as $tray
      | if $bell != null then .[:$bell] + [{id: "araneadev.health"}] + .[$bell:]
        elif $tray != null then .[:$tray] + [{id: "araneadev.health"}] + .[$tray:]
        else [{id: "araneadev.health"}] + . end)
    else . end
' "$config_file" >"$tmp_file"

if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.notifications") != null' "$tmp_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$bell_marker"
  rm -f "$parked_marker"
fi
if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.health") != null' "$tmp_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$health_marker"
  rm -f "$health_parked"
fi

note_polkit_handover

if cmp -s "$config_file" "$tmp_file"; then
  printf 'shell config already repaired: %s\n' "$config_file"
  exit 0
fi

if [[ ! -e "$backup_file" ]]; then
  cp -p "$config_file" "$backup_file"
fi
chmod --reference="$config_file" "$tmp_file"
mv -f "$tmp_file" "$config_file"
printf 'repaired shell config: %s\n' "$config_file"
