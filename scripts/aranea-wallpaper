#!/usr/bin/env bash
set -euo pipefail

# Lists and applies the wallpapers in backgrounds/manifest.toml, applies the
# scheduled wallpaper for the current time, and manages its daily timer.
# ARANEA_WALLPAPER_MANIFEST overrides the manifest path.
#
# Usage: scripts/aranea-wallpaper list
#        scripts/aranea-wallpaper set <id> | set-scheduled | set-phase | set-day-night
#        scripts/aranea-wallpaper schedule on|off|status
#        scripts/aranea-wallpaper schedule configure --entries JSON
#        scripts/aranea-wallpaper schedule configure DAWN DAY DUSK NIGHT
#        scripts/aranea-wallpaper motion on|off

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/paths.sh"
manifest="${ARANEA_WALLPAPER_MANIFEST:-$repo_root/backgrounds/manifest.toml}"
state_root="$(aranea_state_root)"
config_root="${ARANEA_CONFIG_HOME:-$(xdg_config_home)}/aranea"
schedule_config="$config_root/wallpaper-schedule.conf"
systemd_user_dir="${ARANEA_SYSTEMD_USER_DIR:-$(xdg_config_home)/systemd/user}"
timer_unit="aranea-wallpaper-day-night.timer"
service_unit="aranea-wallpaper-day-night.service"

# Runs systemctl --user (ARANEA_SYSTEMCTL overrides the binary).
systemctl_user() { "${ARANEA_SYSTEMCTL:-systemctl}" --user "$@"; }
# Normalize and validate entry data against the available manifest catalog.
normalize_entries() {
  local catalog normalized
  catalog="$(wallpaper_catalog_json)" || return $?
  normalized="$(jq -cse --argjson catalog "$catalog" '
    if length == 1 then .[0] else error("Expected one schedule JSON value") end
    | if type != "array" or length == 0 then error("Schedule requires at least one entry") else . end
    | if all(.[]; type == "object" and (.time | type == "string") and (.wallpaper | type == "string"))
      then . else error("Schedule entries require time and wallpaper strings") end
    | if all(.[]; .time | test("^([01][0-9]|2[0-3]):[0-5][0-9]$"))
      then . else error("Invalid schedule time") end
    | if (map(.time) | unique | length) == length then . else error("Duplicate schedule time") end
    | ($catalog | map({key:.id,value:.available}) | from_entries) as $available
    | if all(.[]; $available[.wallpaper] == true) then . else error("Unknown or missing wallpaper asset") end
    | map({time,wallpaper}) | sort_by(.time)
  ' <<<"$1")" || return 1
  entries="$normalized"
  # Legacy fields are meaningful only for a single entry assigned to that ID.
  local phase value
  for phase in dawn day dusk night; do
    value="$(jq -r --arg phase "$phase" '[.[] | select(.wallpaper == $phase)] | if length == 1 then .[0].time else "" end' <<<"$entries")"
    printf -v "$phase" '%s' "$value"
  done
}
# True when $1 is a 24-hour HH:MM time.
valid_time() { [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }
# Legacy arguments retain their strictly ascending four-phase contract.
validate_schedule() {
  local value legacy_entries
  for value in "$dawn" "$day" "$dusk" "$night"; do valid_time "$value" || {
    printf 'Invalid schedule time: %s\n' "$value" >&2
    return 1
  }; done
  ((10#${dawn/:/} < 10#${day/:/} && 10#${day/:/} < 10#${dusk/:/} && 10#${dusk/:/} < 10#${night/:/})) || {
    printf 'Schedule times must be strictly ascending (dawn day dusk night).\n' >&2
    return 1
  }
  legacy_entries="$(jq -cn --arg dawn "$dawn" --arg day "$day" --arg dusk "$dusk" --arg night "$night" \
    '[{time:$dawn,wallpaper:"dawn"},{time:$day,wallpaper:"day"},{time:$dusk,wallpaper:"dusk"},{time:$night,wallpaper:"night"}]')"
  normalize_entries "$legacy_entries"
}
# Read version-2 JSON or legacy literal assignments without executing them.
# Reading legacy files deliberately does not migrate or write anything.
load_schedule() {
  dawn=06:00 day=08:00 dusk=18:00 night=20:00
  if [[ -e "$schedule_config" || -L "$schedule_config" ]]; then
    [[ -f "$schedule_config" && -r "$schedule_config" ]] || {
      echo 'Schedule config is unreadable' >&2
      return 1
    }
    local source_data
    source_data="$(cat -- "$schedule_config")" || return $?
    if [[ "$source_data" =~ ^[[:space:]]*\{ ]]; then
      local json_entries
      json_entries="$(jq -cse 'if length == 1 then .[0] else error("Expected one configuration JSON value") end | if type == "object" and .version == 2 then .entries else error("Invalid schedule version") end' <<<"$source_data")" || return 1
      normalize_entries "$json_entries"
      return $?
    fi
    local key value line
    local assignment='^[[:space:]]*(dawn|day|dusk|night)[[:space:]]*=[[:space:]]*(.*)$'
    local plain='^([0-9]{2}:[0-9]{2})[[:space:]]*(#.*)?$'
    local double_quoted='^"([0-9]{2}:[0-9]{2})"[[:space:]]*(#.*)?$'
    local single_quoted="^'([0-9]{2}:[0-9]{2})'[[:space:]]*(#.*)?$"
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
      [[ "$line" =~ $assignment ]] || {
        echo 'Invalid schedule configuration' >&2
        return 1
      }
      key="${BASH_REMATCH[1]}" value="${BASH_REMATCH[2]}"
      if [[ "$value" =~ $plain || "$value" =~ $double_quoted || "$value" =~ $single_quoted ]]; then
        printf -v "$key" '%s' "${BASH_REMATCH[1]}"
      else
        echo 'Invalid schedule time assignment' >&2
        return 1
      fi
    done <<<"$source_data"
  fi
  validate_schedule
}
# Atomic replacement preserves a previous config symlink's target.
write_schedule_config() {
  local temporary rc=0
  mkdir -p "$config_root" || return $?
  temporary="$(mktemp "$config_root/.wallpaper-schedule.XXXXXX")" || return $?
  jq -cn --argjson entries "$entries" '{version:2,entries:$entries}' >"$temporary" && mv -f -- "$temporary" "$schedule_config" || rc=$?
  rm -f -- "$temporary"
  return "$rc"
}
# The stable unit names preserve existing hook and removal compatibility.
write_schedule_units() {
  local temporary_service temporary_timer rc=0 calendars
  calendars="$(jq -r 'map("OnCalendar=*-*-* " + .time + ":00") | join("\n")' <<<"$entries")" || return $?
  mkdir -p "$systemd_user_dir" || return $?
  temporary_service="$(mktemp "$systemd_user_dir/.wallpaper-service.XXXXXX")" || return $?
  temporary_timer="$(mktemp "$systemd_user_dir/.wallpaper-timer.XXXXXX")" || {
    rc=$?
    rm -f -- "$temporary_service"
    return "$rc"
  }
  cat >"$temporary_service" <<'UNIT' || rc=$?
[Unit]
Description=Apply the Aranea scheduled wallpaper

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/themes/aranea/scripts/aranea-wallpaper set-scheduled
UNIT
  if ((rc == 0)); then
    cat >"$temporary_timer" <<UNIT || rc=$?
[Unit]
Description=Schedule the Aranea wallpaper

[Timer]
$calendars
Persistent=true

[Install]
WantedBy=timers.target
UNIT
  fi
  if ((rc == 0)); then
    mv -f -- "$temporary_service" "$systemd_user_dir/$service_unit" && mv -f -- "$temporary_timer" "$systemd_user_dir/$timer_unit" || rc=$?
  fi
  rm -f -- "$temporary_service" "$temporary_timer"
  return "$rc"
}
# Prints "id<TAB>path" for every [[wallpapers]] block of the manifest (other
# sections are ignored; any spacing around = is accepted). Pass 1 to append
# the optional human-facing label for JSON catalogs only.
wallpaper_rows() {
  awk -v labels="${1:-0}" '
    # The value of a key = value line, without quotes.
    function value(line) { sub(/^[^=]*=[[:space:]]*/, "", line); gsub(/^"|"[[:space:]]*$/, "", line); return line }
    # Prints the block just read when it has both an id and a path.
    function flush() { if (in_block && id != "" && path != "") print id "\t" path (labels == 1 ? "\t" label : ""); id = ""; path = ""; label = "" }
    /^\[\[wallpapers\]\][[:space:]]*$/ { flush(); in_block = 1; next }
    /^\[/ { flush(); in_block = 0; next }
    in_block && /^id[[:space:]]*=/ { id = value($0) }
    in_block && /^path[[:space:]]*=/ { path = value($0) }
    in_block && /^label[[:space:]]*=/ { label = value($0) }
    END { flush() }
  ' "$manifest"
}
# Prints the absolute path of the wallpaper whose id is $WANTED (below $ROOT),
# comparing ids as text.
wallpaper_rows_lookup() {
  wallpaper_rows | awk -F '\t' '$1 == ENVIRON["WANTED"] { print ENVIRON["ROOT"] $2; exit }'
}
# Prints the absolute path of wallpaper ID from the manifest (nothing when
# the id is unknown); the id is compared as text, never as a pattern.
wallpaper_path() {
  # Passed through the environment: awk -v would expand backslashes.
  WANTED="$1" ROOT="$repo_root/" wallpaper_rows_lookup
}
# The last transition of yesterday applies before today's first entry.
wallpaper_for_now() {
  jq -r --arg now "$1" '. as $all | [.[] | select(.time <= $now)]
    | if length == 0 then $all[-1].wallpaper else .[-1].wallpaper end' <<<"$entries"
}

# Optional JSON catalog uses the same path resolution as set.
wallpaper_catalog_json() {
  local id relative path label available
  [[ -r "$manifest" ]] || {
    printf '[]\n'
    echo 'Wallpaper manifest is unreadable' >&2
    return 1
  }
  while IFS=$'\t' read -r id relative label; do
    path="$repo_root/$relative"
    if [[ -z "$label" ]]; then
      label="${id//-/ }"
      label="${label//_/ }"
      label="${label^}"
    fi
    available=false
    [[ -f "$path" && -r "$path" ]] && available=true
    jq -cn --arg id "$id" --arg path "$path" --arg label "$label" \
      --argjson available "$available" '{id:$id,label:$label,path:$path,available:$available}'
  done < <(wallpaper_rows 1) | jq -s .
}
# Host source matches omarchy-theme-bg-switcher and omarchy-theme-bg-current.
wallpaper_status_json() {
  local active=null availability=unavailable target id relative candidate host_root host_candidate
  local current_theme=""
  current_theme="$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)"
  target="$(readlink -f -- "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)"
  if [[ -n "$target" && -f "$target" && -r "$target" ]]; then
    availability=available
    if [[ -r "$manifest" ]]; then
      while IFS=$'\t' read -r id relative; do
        candidate="$(readlink -f -- "$repo_root/$relative" 2>/dev/null || true)"
        # Match the host's staged/installed copies only for the active Aranea
        # theme and byte-identical manifest assets, never a custom basename.
        if [[ "$candidate" != "$target" && "$current_theme" == aranea ]]; then
          for host_root in "$HOME/.local/state/omarchy/current/theme" "$HOME/.config/omarchy/themes/aranea"; do
            host_candidate="$(readlink -f -- "$host_root/$relative" 2>/dev/null || true)"
            if [[ "$host_candidate" == "$target" ]] && cmp -s -- "$candidate" "$target"; then
              candidate="$target"
              break
            fi
          done
        fi
        if [[ "$candidate" == "$target" ]]; then
          active="$(jq -cn --arg id "$id" '$id')"
          break
        fi
      done < <(wallpaper_rows)
    else availability=unavailable; fi
  fi
  jq -cn --argjson active "$active" --arg availability "$availability" \
    '{activeId:$active,availability:$availability}'
}
# Applied means observed active timer, not that a phase image was applied.
schedule_status_json() {
  local enabled=false applied=null availability=available live
  if [[ -e "$state_root/wallpaper-schedule" || -L "$state_root/wallpaper-schedule" ]]; then
    case "$(cat "$state_root/wallpaper-schedule" 2>/dev/null)" in
      on) enabled=true ;;
      off) enabled=false ;;
      *)
        enabled=null
        availability=unavailable
        ;;
    esac
  fi
  if ! load_schedule; then
    availability=unavailable
    dawn=""
    day=""
    dusk=""
    night=""
    entries='[]'
  fi
  if live="$(systemctl_user is-active "$timer_unit" 2>/dev/null)"; then
    [[ "$live" == active ]] && applied=true
  else
    [[ "$live" == inactive || "$live" == failed ]] && applied=false
  fi
  jq -cn --argjson enabled "$enabled" --argjson applied "$applied" \
    --arg availability "$availability" --arg dawn "$dawn" --arg day "$day" \
    --arg dusk "$dusk" --arg night "$night" --argjson entries "$entries" \
    '{entries:$entries,enabled:$enabled,applied:$applied,availability:$availability,
      dawn:(if $dawn == "" then null else $dawn end),day:(if $day == "" then null else $day end),
      dusk:(if $dusk == "" then null else $dusk end),night:(if $night == "" then null else $night end)}'
  [[ "$availability" == available ]]
}
# Preserve exactly the existing files (including symlinks) on apply failure.
schedule_transaction() {
  local mode="$1" snapshot rc=0 file index=0 live_enabled live_active temporary_state runtime_changed=false
  live_enabled="$(systemctl_user is-enabled "$timer_unit" 2>/dev/null || true)"
  live_active="$(systemctl_user is-active "$timer_unit" 2>/dev/null || true)"
  local -a files=("$schedule_config" "$systemd_user_dir/$service_unit" "$systemd_user_dir/$timer_unit" "$state_root/wallpaper-schedule" "$systemd_user_dir/timers.target.wants/$timer_unit")
  snapshot="$(mktemp -d)" || return $?
  for file in "${files[@]}"; do
    if [[ -e "$file" || -L "$file" ]]; then
      cp -a -- "$file" "$snapshot/$index" || {
        rc=$?
        rm -rf -- "$snapshot"
        return "$rc"
      }
    fi
    index=$((index + 1))
  done
  if [[ "$mode" == off ]]; then
    runtime_changed=true
    systemctl_user disable --now "$timer_unit" || rc=$?
    if ((rc == 0)); then rm -f -- "$systemd_user_dir/$timer_unit" "$systemd_user_dir/$service_unit" || rc=$?; fi
    if ((rc == 0)); then systemctl_user daemon-reload || rc=$?; fi
  else
    write_schedule_config || rc=$?
    if ((rc == 0)) && { [[ "$mode" == on ]] || [[ -f "$state_root/wallpaper-schedule" && "$(cat "$state_root/wallpaper-schedule")" == on ]]; }; then
      write_schedule_units || rc=$?
      if ((rc == 0)); then systemctl_user daemon-reload || rc=$?; fi
      if ((rc == 0)); then
        runtime_changed=true
        systemctl_user enable --now "$timer_unit" || rc=$?
      fi
      # Restart refreshes calendars; Persistent=true retains missed-event
      # catch-up, so an explicitly saved enabled schedule may apply its entry.
      if ((rc == 0)); then systemctl_user restart "$timer_unit" || rc=$?; fi
    fi
  fi
  if ((rc == 0)) && [[ "$mode" != configure ]]; then
    mkdir -p "$state_root" || rc=$?
    if ((rc == 0)); then temporary_state="$(mktemp "$state_root/.wallpaper-schedule.XXXXXX")" || rc=$?; fi
    if ((rc == 0)); then printf '%s' "$mode" >"$temporary_state" && mv -f -- "$temporary_state" "$state_root/wallpaper-schedule" || rc=$?; fi
    [[ -z "${temporary_state:-}" ]] || rm -f -- "$temporary_state"
  fi
  if ((rc != 0)); then
    index=0
    for file in "${files[@]}"; do
      rm -f -- "$file"
      if [[ -e "$snapshot/$index" || -L "$snapshot/$index" ]]; then cp -a -- "$snapshot/$index" "$file"; fi
      index=$((index + 1))
    done
    systemctl_user daemon-reload >/dev/null 2>&1 || true
    # Restore observed runtime state, which may differ from saved preference.
    if [[ "$runtime_changed" == true ]]; then
      case "$live_enabled" in
        enabled) systemctl_user enable "$timer_unit" >/dev/null 2>&1 || true ;;
        enabled-runtime) systemctl_user enable --runtime "$timer_unit" >/dev/null 2>&1 || true ;;
        disabled | not-found) systemctl_user disable "$timer_unit" >/dev/null 2>&1 || true ;;
      esac
      case "$live_active" in
        active) systemctl_user restart "$timer_unit" >/dev/null 2>&1 || true ;;
        inactive | failed) systemctl_user stop "$timer_unit" >/dev/null 2>&1 || true ;;
      esac
    fi
    # Enable/disable may create/remove this link after the file rollback.
    file="${files[4]}"
    rm -f -- "$file"
    if [[ -e "$snapshot/4" || -L "$snapshot/4" ]]; then
      mkdir -p -- "$(dirname "$file")"
      cp -a -- "$snapshot/4" "$file"
    fi
  fi
  rm -rf -- "$snapshot"
  return "$rc"
}

# Serialize shared reads, writes, and rollback across all schedule mutations.
# The subshell closes the lock descriptor on every success or failure path.
schedule_mutation() (
  local mode="$1" schedule_lock_fd
  mkdir -p -- "$config_root"
  exec {schedule_lock_fd}>"$config_root/wallpaper-schedule.lock"
  flock -x "$schedule_lock_fd"
  if [[ "$mode" == on ]]; then load_schedule; fi
  schedule_transaction "$mode"
)

# JSON reads and schedule commands require jq before doing any work.
if [[ "${*: -1}" == --json || "${1:-}" == schedule || "${1:-}" == set-scheduled || "${1:-}" == set-phase || "${1:-}" == set-day-night ]]; then
  command -v jq >/dev/null 2>&1 || {
    echo 'jq is required for JSON and schedule commands' >&2
    exit 2
  }
fi

case "${1:-list}" in
  list)
    if [[ "${2:-}" == --json ]]; then
      [[ $# -eq 2 ]] || exit 2
      wallpaper_catalog_json
    else wallpaper_rows; fi
    ;;
  status)
    [[ $# -eq 2 && "$2" == --json ]] || exit 2
    wallpaper_status_json
    ;;
  set)
    id="${2:-}"
    path="$(wallpaper_path "$id")"
    [[ -n "$path" ]] || {
      printf 'Unknown wallpaper: %s\n' "$id" >&2
      exit 1
    }
    [[ -f "$path" && -r "$path" ]] || {
      printf 'Wallpaper asset is missing: %s\n' "$path" >&2
      exit 1
    }
    if [[ -n "${ARANEA_WALLPAPER_APPLIER:-}" ]]; then "$ARANEA_WALLPAPER_APPLIER" "$path"; elif [[ "${ARANEA_WALLPAPER_DRY_RUN:-0}" != 1 ]] && command -v omarchy >/dev/null 2>&1; then omarchy theme bg set "$path"; fi
    printf 'wallpaper: %s\npath: %s\n' "$id" "$path"
    ;;
  set-scheduled | set-phase)
    load_schedule
    now="${ARANEA_NOW:-$(date +%H:%M)}"
    valid_time "$now" || {
      printf 'Invalid ARANEA_NOW: %s\n' "$now" >&2
      exit 1
    }
    exec "$0" set "$(wallpaper_for_now "$now")"
    ;;
  set-day-night) exec "$0" set-scheduled ;;
  schedule)
    mode="${2:-}"
    if [[ "$mode" == configure ]]; then
      if [[ $# -eq 4 && "$3" == --entries ]]; then
        normalize_entries "$4"
      elif [[ $# -eq 6 ]]; then
        dawn="$3" day="$4" dusk="$5" night="$6"
        validate_schedule
      else
        printf 'Usage: %s schedule configure --entries JSON | DAWN DAY DUSK NIGHT\n' "$0" >&2
        exit 2
      fi
      schedule_mutation configure
      printf 'wallpaper schedule: configured\n'
      exit 0
    fi
    [[ "$mode" == on || "$mode" == off || "$mode" == status ]] || {
      printf 'Usage: %s schedule on|off|status|configure\n' "$0" >&2
      exit 2
    }
    if [[ "$mode" == status ]]; then
      if [[ "${3:-}" == --json ]]; then
        [[ $# -eq 3 ]] || exit 2
        schedule_status_json
        exit $?
      fi
      state=off
      [[ -f "$state_root/wallpaper-schedule" ]] && state="$(<"$state_root/wallpaper-schedule")"
      load_schedule
      printf 'wallpaper schedule: %s\n' "$state"
      if [[ -n "$dawn" && -n "$day" && -n "$dusk" && -n "$night" ]]; then
        printf 'phases: %s %s %s %s\n' "$dawn" "$day" "$dusk" "$night"
      fi
      text_entries="$(jq -r '.[] | .time + " " + .wallpaper' <<<"$entries")"
      printf '%s\n' "$text_entries"
      exit 0
    fi
    schedule_mutation "$mode"
    printf 'wallpaper schedule: %s\n' "$mode"
    ;;
  motion)
    mode="${2:-}"
    [[ "$mode" == on || "$mode" == off ]] || {
      printf 'Usage: %s motion on|off\n' "$0" >&2
      exit 2
    }
    exec "$repo_root/scripts/aranea-motion" set "$mode"
    ;;
  *)
    printf 'Usage: %s list|set <id>|set-scheduled|set-phase|set-day-night|schedule on|off|status|configure|motion on|off\n' "$0" >&2
    exit 2
    ;;
esac
