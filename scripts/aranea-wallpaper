#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$repo_root/backgrounds/manifest.toml"
state_root="${ARANEA_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/aranea}"
config_root="${ARANEA_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/aranea"
schedule_config="$config_root/wallpaper-schedule.conf"
systemd_user_dir="${ARANEA_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
timer_unit="aranea-wallpaper-day-night.timer"
service_unit="aranea-wallpaper-day-night.service"

systemctl_user() { "${ARANEA_SYSTEMCTL:-systemctl}" --user "$@"; }
load_schedule() {
  dawn=06:00; day=08:00; dusk=18:00; night=20:00
  if [[ -f "$schedule_config" ]]; then source "$schedule_config"; fi
}
valid_time() { [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }
validate_schedule() {
  local value
  for value in "$dawn" "$day" "$dusk" "$night"; do valid_time "$value" || { printf 'Invalid schedule time: %s\n' "$value" >&2; return 1; }; done
  ((10#${dawn/:/} < 10#${day/:/} && 10#${day/:/} < 10#${dusk/:/} && 10#${dusk/:/} < 10#${night/:/})) || { printf 'Schedule times must be strictly ascending (dawn day dusk night).\n' >&2; return 1; }
}
write_schedule_config() { mkdir -p "$config_root"; printf 'dawn=%s\nday=%s\ndusk=%s\nnight=%s\n' "$dawn" "$day" "$dusk" "$night" > "$schedule_config"; }
write_schedule_units() {
  load_schedule; validate_schedule; mkdir -p "$systemd_user_dir"
  cat > "$systemd_user_dir/$service_unit" <<'UNIT'
[Unit]
Description=Apply the Aranea phase wallpaper

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/themes/aranea/scripts/aranea-wallpaper set-phase
UNIT
  cat > "$systemd_user_dir/$timer_unit" <<UNIT
[Unit]
Description=Schedule the Aranea phase wallpaper

[Timer]
OnCalendar=*-*-* ${dawn}:00
OnCalendar=*-*-* ${day}:00
OnCalendar=*-*-* ${dusk}:00
OnCalendar=*-*-* ${night}:00
Persistent=true

[Install]
WantedBy=timers.target
UNIT
}
wallpaper_path() {
  local id="$1"
  awk -v wanted="$id" -v root="$repo_root/" '/^\[\[wallpapers\]\]$/ { in_block = 1; match_id = 0; next } in_block && /^\[/ { in_block = 0 } in_block && $0 ~ "^id[[:space:]]*=[[:space:]]*\"" wanted "\"$" { match_id = 1; next } match_id && /^path[[:space:]]*=/ { line = $0; sub(/^[^=]*=[[:space:]]*/, "", line); gsub(/^"|"$/, "", line); print root line; exit }' "$manifest"
}
phase_for_now() {
  local now="$1"; local dawn_minutes=$((10#${dawn/:/})); local day_minutes=$((10#${day/:/})); local dusk_minutes=$((10#${dusk/:/})); local night_minutes=$((10#${night/:/})); local now_minutes=$((10#${now/:/}))
  if ((now_minutes >= night_minutes || now_minutes < dawn_minutes)); then printf night
  elif ((now_minutes < day_minutes)); then printf dawn
  elif ((now_minutes < dusk_minutes)); then printf day
  else printf dusk
  fi
}

case "${1:-list}" in
  list) awk '/^id = / { id=$0; sub(/^id = /, "", id); gsub(/"/, "", id) } /^path = / { path=$0; sub(/^path = /, "", path); gsub(/"/, "", path); print id "\t" path }' "$manifest" ;;
  set)
    id="${2:-}"; path="$(wallpaper_path "$id")"; [[ -n "$path" ]] || { printf 'Unknown wallpaper: %s\n' "$id" >&2; exit 1; }; [[ -f "$path" ]] || { printf 'Wallpaper asset is missing: %s\n' "$path" >&2; exit 1; }
    if [[ -n "${ARANEA_WALLPAPER_APPLIER:-}" ]]; then "$ARANEA_WALLPAPER_APPLIER" "$path"; elif [[ "${ARANEA_WALLPAPER_DRY_RUN:-0}" != 1 ]] && command -v omarchy >/dev/null 2>&1; then omarchy theme bg set "$path"; fi
    printf 'wallpaper: %s\npath: %s\n' "$id" "$path" ;;
  set-phase) load_schedule; validate_schedule; now="${ARANEA_NOW:-$(date +%H:%M)}"; valid_time "$now" || { printf 'Invalid ARANEA_NOW: %s\n' "$now" >&2; exit 1; }; exec "$0" set "$(phase_for_now "$now")" ;;
  set-day-night) exec "$0" set-phase ;;
  schedule)
    mode="${2:-}"
    if [[ "$mode" == configure ]]; then
      [[ $# -eq 6 ]] || { printf 'Usage: %s schedule configure DAWN DAY DUSK NIGHT\n' "$0" >&2; exit 2; }; dawn="$3"; day="$4"; dusk="$5"; night="$6"; validate_schedule; write_schedule_config
      if [[ -f "$state_root/wallpaper-schedule" ]] && [[ "$(<"$state_root/wallpaper-schedule")" == on ]]; then write_schedule_units; systemctl_user daemon-reload; systemctl_user enable --now "$timer_unit"; fi
      printf 'wallpaper schedule: configured\n'; exit 0
    fi
    [[ "$mode" == on || "$mode" == off || "$mode" == status ]] || { printf 'Usage: %s schedule on|off|status|configure\n' "$0" >&2; exit 2; }; mkdir -p "$state_root"
    if [[ "$mode" == status ]]; then state=off; [[ -f "$state_root/wallpaper-schedule" ]] && state="$(<"$state_root/wallpaper-schedule")"; load_schedule; printf 'wallpaper schedule: %s\nphases: %s %s %s %s\n' "$state" "$dawn" "$day" "$dusk" "$night"; exit 0; fi
    if [[ "$mode" == on ]]; then load_schedule; validate_schedule; [[ -f "$schedule_config" ]] || write_schedule_config; write_schedule_units; systemctl_user daemon-reload; systemctl_user enable --now "$timer_unit"; printf on > "$state_root/wallpaper-schedule"; printf 'wallpaper schedule: on\n'
    else systemctl_user disable --now "$timer_unit" >/dev/null 2>&1 || true; systemctl_user daemon-reload >/dev/null 2>&1 || true; rm -f "$systemd_user_dir/$timer_unit" "$systemd_user_dir/$service_unit"; printf off > "$state_root/wallpaper-schedule"; printf 'wallpaper schedule: off\n'; fi ;;
  motion) mode="${2:-}"; [[ "$mode" == on || "$mode" == off ]] || { printf 'Usage: %s motion on|off\n' "$0" >&2; exit 2; }; exec "$repo_root/scripts/aranea-motion" set "$mode" ;;
  *) printf 'Usage: %s list|set <id>|set-phase|set-day-night|schedule on|off|status|configure|motion on|off\n' "$0" >&2; exit 2 ;;
esac
