#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$repo_root/backgrounds/manifest.toml"
state_root="${ARANEA_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/aranea}"
systemd_user_dir="${ARANEA_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
timer_unit="aranea-wallpaper-day-night.timer"
service_unit="aranea-wallpaper-day-night.service"

systemctl_user() {
  "${ARANEA_SYSTEMCTL:-systemctl}" --user "$@"
}

write_schedule_units() {
  mkdir -p "$systemd_user_dir"
  cat > "$systemd_user_dir/$service_unit" <<'UNIT'
[Unit]
Description=Apply the Aranea day/night wallpaper

[Service]
Type=oneshot
ExecStart=%h/.local/state/omarchy/current/theme/scripts/aranea-wallpaper set-day-night
UNIT
  cat > "$systemd_user_dir/$timer_unit" <<'UNIT'
[Unit]
Description=Schedule the Aranea day/night wallpaper

[Timer]
OnCalendar=*-*-* 07:00:00
OnCalendar=*-*-* 19:00:00
Persistent=true

[Install]
WantedBy=timers.target
UNIT
}

wallpaper_path() {
  local id="$1"
  awk -v wanted="$id" -v root="$repo_root/" '
    /^\[\[wallpapers\]\]$/ { in_block = 1; match_id = 0; next }
    in_block && /^\[/ { in_block = 0 }
    in_block && $0 ~ "^id[[:space:]]*=[[:space:]]*\"" wanted "\"$" { match_id = 1; next }
    match_id && /^path[[:space:]]*=/ {
      line = $0
      sub(/^[^=]*=[[:space:]]*/, "", line)
      gsub(/^"|"$/, "", line)
      print root line
      exit
    }
  ' "$manifest"
}

case "${1:-list}" in
  list)
    awk '/^id = / { id=$0; sub(/^id = /, "", id); gsub(/"/, "", id) }
         /^path = / { path=$0; sub(/^path = /, "", path); gsub(/"/, "", path); print id "\t" path }' "$manifest"
    ;;
  set)
    id="${2:-}"
    path="$(wallpaper_path "$id")"
    [[ -n "$path" ]] || { printf 'Unknown wallpaper: %s\n' "$id" >&2; exit 1; }
    [[ -f "$path" ]] || { printf 'Wallpaper asset is missing: %s\n' "$path" >&2; exit 1; }
    if [[ -n "${ARANEA_WALLPAPER_APPLIER:-}" ]]; then
      "$ARANEA_WALLPAPER_APPLIER" "$path"
    elif [[ "${ARANEA_WALLPAPER_DRY_RUN:-0}" != 1 ]] && command -v omarchy >/dev/null 2>&1; then
      omarchy theme bg set "$path"
    fi
    printf 'wallpaper: %s\npath: %s\n' "$id" "$path"
    ;;
  set-day-night)
    hour="$(date +%H)"
    if (( 10#$hour >= 7 && 10#$hour < 19 )); then
      exec "$0" set day
    fi
    exec "$0" set night
    ;;
  schedule)
    mode="${2:-}"
    [[ "$mode" == on || "$mode" == off || "$mode" == status ]] || { printf 'Usage: %s schedule on|off|status\n' "$0" >&2; exit 2; }
    mkdir -p "$state_root"
    if [[ "$mode" == status ]]; then
      if [[ -f "$state_root/wallpaper-schedule" ]]; then
        printf 'wallpaper schedule: %s\n' "$(<"$state_root/wallpaper-schedule")"
      else
        printf 'wallpaper schedule: off\n'
      fi
      exit 0
    fi
    if [[ "$mode" == on ]]; then
      write_schedule_units
      systemctl_user daemon-reload
      systemctl_user enable --now "$timer_unit"
      printf '%s\n' on > "$state_root/wallpaper-schedule"
      printf 'wallpaper schedule: on\n'
    else
      systemctl_user disable --now "$timer_unit" >/dev/null 2>&1 || true
      systemctl_user daemon-reload >/dev/null 2>&1 || true
      rm -f "$systemd_user_dir/$timer_unit" "$systemd_user_dir/$service_unit"
      printf '%s\n' off > "$state_root/wallpaper-schedule"
      printf 'wallpaper schedule: off\n'
    fi
    ;;
  motion)
    mode="${2:-}"
    [[ "$mode" == on || "$mode" == off ]] || { printf 'Usage: %s motion on|off\n' "$0" >&2; exit 2; }
    mkdir -p "$state_root"
    printf '%s\n' "$mode" > "$state_root/motion"
    printf 'motion: %s\n' "$mode"
    ;;
  *)
    printf 'Usage: %s list|set <id>|set-day-night|schedule on|off|status|motion on|off\n' "$0" >&2
    exit 2
    ;;
esac
