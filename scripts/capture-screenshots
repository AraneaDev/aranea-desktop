#!/usr/bin/env bash
set -euo pipefail

# Captures screenshots of Aranea surfaces into an output directory. --surface
# captures one; --all (only on workspace 2, needs hyprctl) captures every
# surface with the real notification inbox parked, then builds
# hero-showcase.gif. --hero rebuilds hero-showcase.gif from the PNGs already
# in the output directory (no captures, no shell restart). Surfaces without a
# built-in capture use ARANEA_SCREENSHOT_COMMAND.
#
# Never captured: the keyboard-layout widget and wifiqr (it would put the
# Wi-Fi password in a screenshot). Workspace and update bar popovers expose
# explicit IPC capture targets below.
#
# Network and Bluetooth never show real nearby names: once summoned, the
# dropdown is handed stand-in names through its `showcase` IPC method
# (display only, cleared when it closes), and a dropdown that doesn't answer
# "ok" (the stock panel, say) fails the surface with no screenshot written.
# Network waits for its link graph to draw a trace first. VPN never shows the
# machine's real profiles either: it is handed stand-in fixture rows through
# its `showcaseFixture` IPC method (display only, every action refused while
# shown, cleared when it closes), failing the same way on a non-"ok" answer.
# Clock never shows the user's real area either: once summoned, the dropdown
# is handed a stand-in place (Amsterdam) through its `showcase` IPC method
# (display only, cleared when it closes), failing the same way on a
# non-"ok" answer. Audio never shows the user's real devices, apps or track
# either: once summoned, the dropdown is handed stand-in device and app
# labels and a made-up track (with a position, so the progress strand
# shows) through its `showcase` IPC method (display only, the transport
# controls refused while shown, cleared when it closes), failing the same
# way on a non-"ok" answer. Agents never shows the user's real usage, plans
# or balance either: once summoned, the dropdown is handed stand-in agents
# (Claude Code, Codex and Fireworks, with made-up plans, limits, days,
# models and a prepaid balance) through its `showcase` IPC method (display
# only, refresh and the agent picker refused while shown, cleared when it
# closes), failing the same way on a non-"ok" answer. Tray and tray-manage never show a real tray app: two
# dev-only fixtures (tools/fixture-tray-item, "Courier" and "Syncbox") are
# started for the capture and killed by their own PIDs afterwards; if the
# StatusNotifierWatcher also lists any item that is not one of those two
# fixtures, both tray captures are refused with no screenshot written, so a
# real tray app can never reach one. Tray captures refuse while any real
# tray app (for example LocalSend) is registered.
#
# Menu search variants menu-search-mixed, menu-search-no-match,
# menu-search-no-compositor and menu-search-vanished render production MenuSurface
# offscreen with inert sources and dispatch.
# Settings and Display use the normal production window in full-desktop frames.
# Diagnostic variants settings-narrow, settings-dirty, settings-unavailable,
# settings-integration-failed and settings-notifications use offscreen fixtures.
# All fixture mutation controls and controller requests refuse changes.
# Lock and Plymouth are rendered, not grabbed from the screen: lock runs the
# plugin's real LockView offscreen with a stand-in clock
# (tools/render-lock-preview; the session is never locked) and plymouth
# composes the disk-unlock prompt from the boot theme's own assets and
# omarchy.script geometry (tools/render-plymouth-preview; no plymouthd, sudo
# or reboot). A render that fails exits non-zero with no screenshot written.
#   ARANEA_CAPTURE_WIFI_NAMES    JSON array of Wi-Fi names (default below)
#   ARANEA_CAPTURE_BT_NAMES      JSON array of Bluetooth names (default below)
#   ARANEA_NETWORK_GRAPH_DELAY   seconds the Network graph records (default 20)
#   ARANEA_BLUETOOTH_SCAN_DELAY  extra seconds for the Bluetooth scan (default 3)
#   ARANEA_CAPTURE_VPN_FIXTURE   JSON array of VPN fixture rows (default below)
#   ARANEA_CAPTURE_CLOCK_PLACE   JSON {name, latitude, longitude} stand-in place (default below)
#   ARANEA_CAPTURE_AUDIO_SHOWCASE JSON {outputs, inputs, apps, track} audio stand-ins (default below)
#
# ARANEA_CAPTURE_SURFACE_COMMAND, when set, replaces each child capture of
# --all: it is run as `<command> <surface> <output dir>` (tests use it).
#
# The real notification inbox (entries and their images) is parked only while
# every shell instance is stopped, and put back the same way, so no queued
# shell job and no restart-time image sweep can touch it. Parking refuses
# (the capture is aborted, the inbox untouched) while the session is locked or
# the shell cannot be stopped; a restore that cannot stop the shell or verify
# every file keeps the notifications in their capture-backup.* dir and says
# so. Notifications that arrive during a capture land in the capture inbox and
# are dropped at restore (a failed restore leaves them there). A stop counts
# only when `quickshell list` confirms no instance is left.
#
# Usage: scripts/capture-screenshots --surface <name> --output <dir> | --all --output <dir> | --hero --output <dir>

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/paths.sh"
surface=""
output=""
capture_all=0
build_hero_only=0
bar_capture_target=""
bar_capture_previous_workspace=""
bar_capture_update_marker_created=0
bar_capture_update_marker="$HOME/.local/state/omarchy/reboot-required"
notification_state_dir="$HOME/.local/state/omarchy/notifications"
notification_inbox_dir="$notification_state_dir/inbox"
notification_images_dir="$notification_state_dir/images"

# Prints the running shell's config dir, resolved like omarchy-restart-shell:
# the session's OMARCHY_PATH (a caller may disagree after dev link/unlink),
# else $OMARCHY_PATH, else /usr/share/omarchy.
omarchy_shell_config() {
  local session_path
  session_path="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1 || true)"
  printf '%s/shell\n' "${session_path:-${OMARCHY_PATH:-/usr/share/omarchy}}"
}

# Stops every running Omarchy shell instance and succeeds only once
# `quickshell list` confirms none is left. Fails closed: refuses (stopping
# nothing) while the session is locked (that would kill the lock screen), and
# fails when the config is missing or the list cannot be read.
stop_omarchy_shell() {
  local config listed tries=0
  if omarchy-hyprland-session-locked >/dev/null 2>&1; then
    return 1
  fi
  config="$(omarchy_shell_config)"
  [[ -f "$config/shell.qml" ]] || return 1
  # Each kill stops the oldest instance and fails once none is left.
  while ((tries < 50)) && timeout 5 quickshell kill -p "$config" --any-display >/dev/null 2>&1; do
    tries=$((tries + 1))
  done
  listed="$(quickshell list -p "$config" --any-display 2>&1)" || return 1
  ! grep -Fq 'Process ID' <<<"$listed"
}

# Prints every entry (dotfiles included) directly inside dir $1, one per
# line, NUL-terminated.
dir_entries() {
  find "$1" -mindepth 1 -maxdepth 1 -print0 2>/dev/null
}

# Moves the real notification inbox (entries and images) into backup dir $1
# while the shell is stopped, sets the caller's swapped flag (variable named
# $2) to 1 the moment the move is done, then restarts the shell on the empty
# inbox. Fails with nothing parked when the shell cannot be stopped (the shell
# is restarted unless the session is locked, as the stop may already have
# killed instances); a failed move is rolled back, and anything the rollback
# could not move stays in the backup (see remove_empty_backup).
park_notification_inbox() {
  local backup="$1" flag="$2" dir file
  if ! stop_omarchy_shell; then
    omarchy-hyprland-session-locked >/dev/null 2>&1 || omarchy restart shell >/dev/null 2>&1 || true
    return 1
  fi
  mkdir -p "$backup/inbox" "$backup/images" "$notification_inbox_dir" "$notification_images_dir"
  if ! { find "$notification_inbox_dir" -maxdepth 1 -name '*.json' -exec mv -t "$backup/inbox" {} + &&
    find "$notification_images_dir" -mindepth 1 -maxdepth 1 -exec mv -t "$backup/images" {} +; }; then
    for dir in inbox images; do
      while IFS= read -r -d '' file; do
        mv -n -- "$file" "$notification_state_dir/$dir/" || true
      done < <(dir_entries "$backup/$dir")
    done
    omarchy restart shell >/dev/null 2>&1 || true
    return 1
  fi
  printf -v "$flag" 1
  omarchy restart shell >/dev/null 2>&1 || true
}

# Puts the notification inbox parked in backup dir $1 back. With every shell
# instance stopped (so no queued job of the capture shell survives), it drops
# the capture entries and images, copies every parked file (dotfiles too)
# back and checks each one; only then is the backup handed off (renamed, then
# deleted), so a rerun never deletes verified files. When the shell cannot be
# stopped or a file does not match, nothing more is touched and the backup is
# kept and named. Rerunning after an interruption is safe. The caller
# restarts the shell.
restore_parked_inbox() {
  local backup="$1" dir file
  [[ -d "$backup" ]] || return 0
  if ! stop_omarchy_shell; then
    printf 'notification inbox not restored (shell still running / session locked); your notifications are kept in %s\n' "$backup" >&2
    return 1
  fi
  mkdir -p "$notification_inbox_dir" "$notification_images_dir"
  find "$notification_inbox_dir" -maxdepth 1 -name '*.json' -delete 2>/dev/null || true
  find "$notification_images_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null || true
  for dir in inbox images; do
    while IFS= read -r -d '' file; do
      cp -p -- "$file" "$notification_state_dir/$dir/" 2>/dev/null || true
    done < <(dir_entries "$backup/$dir")
  done
  for dir in inbox images; do
    while IFS= read -r -d '' file; do
      cmp -s -- "$file" "$notification_state_dir/$dir/${file##*/}" || {
        printf 'notification inbox not fully restored; your notifications are kept in %s\n' "$backup" >&2
        return 1
      }
    done < <(dir_entries "$backup/$dir")
  done
  # Every file is back: a leftover of the backup is no longer needed.
  rm -rf -- "$backup.restored" 2>/dev/null || true
  if ! mv -- "$backup" "$backup.restored"; then
    printf 'notification inbox restored; its backup %s could not be removed, delete it yourself\n' "$backup" >&2
    return 0
  fi
  rm -rf -- "$backup.restored" 2>/dev/null ||
    printf 'notification inbox restored; delete the leftover %s yourself\n' "$backup.restored" >&2
  return 0
}

# Removes an unused park backup dir $1 (rmdir only: never deletes files).
# When files are left in it (a park whose rollback could not move them all
# back), it is kept and named, and this fails.
remove_empty_backup() {
  rmdir -- "$1/inbox" "$1/images" 2>/dev/null || true
  rmdir -- "$1" 2>/dev/null && return 0
  [[ -d "$1" ]] || return 0
  printf 'notification files from an aborted park are kept in %s; move them back into %s\n' "$1" "$notification_state_dir" >&2
  return 1
}

# Stand-in names the Network and Bluetooth captures draw instead of real ones.
default_wifi_names='["Aranea-Home","Neighbour-5G","Cafe-Guest","Library-Free","Studio-2G","Atelier","Harbour-Net","Old-Router"]'
default_bt_names='["WH-1000XM5","MX Master 3S","Pixel 9","Keychron K3","JBL Flip 6","Xbox Controller","Galaxy Buds2","Kindle"]'
# Stand-in fixture rows the VPN capture draws instead of the machine's real
# NetworkManager profiles and own-app VPNs.
default_vpn_fixture='[{"name":"Office (Firebox)","label":"OpenVPN","kind":"nm","connected":true,"ip":"10.20.4.17","server":"vpn.example.com","upMinutes":72},{"name":"Azure (Contoso)","label":"Azure VPN Client","kind":"app","connected":true,"upMinutes":23},{"name":"Client A","label":"OpenVPN","kind":"nm","connected":false},{"name":"GlobalProtect (HQ)","label":"GlobalProtect","kind":"app","connected":false},{"name":"Azure (Fabrikam)","label":"Azure VPN Client","kind":"app","connected":false}]'
# The stand-in place (Amsterdam) the Clock capture draws instead of the
# user's own configured or wttr.in-resolved area.
default_clock_place='{"name":"Amsterdam","latitude":52.37,"longitude":4.90}'
# Stand-in device and app labels and the track the Audio capture draws
# instead of the user's own (AudioLogic.parseShowcase reads it).
default_audio_showcase='{"outputs":["Studio Monitors","WH-1000XM5"],"inputs":["Desk Mic","WH-1000XM5"],"apps":["Spotify","Firefox"],"track":{"title":"Midnight City","artist":"M83","player":"Spotify","progress":0.4}}'
# Stand-in agents the Agents capture draws instead of the user's real usage,
# plans and balance (AgentsLogic.parseShowcase reads it).
default_agents_showcase='{"agents":[{"id":"claude","name":"Claude Code","plan":"Pro","updatedMinutesAgo":3,"todayPrompts":46,"todaySessions":5,"limits":[{"label":"Session (5-hour)","percent":0.42,"resetsInMinutes":134},{"label":"Weekly (7-day)","percent":0.63,"resetsInMinutes":3720}],"days":[182400000,241700000,96300000,318900000,275200000,204600000,128300000],"models":[{"id":"claude-sonnet-5","input":4200000,"output":9800000,"cacheRead":1186000000,"cacheWrite":52000000},{"id":"claude-opus-5","input":1900000,"output":4100000,"cacheRead":512000000,"cacheWrite":23000000},{"id":"claude-haiku-4-5","input":800000,"output":1200000,"cacheRead":64000000,"cacheWrite":3100000}]},{"id":"codex","name":"Codex","plan":"Plus","updatedMinutesAgo":3,"todayPrompts":18,"todaySessions":2,"limits":[{"label":"5h window","percent":0.12,"resetsInMinutes":251},{"label":"Weekly (7-day)","percent":0.86,"resetsInMinutes":1490}],"days":[42100000,0,63800000,51200000,88900000,37400000,22600000],"models":[{"id":"gpt-5.6-sol","input":2100000,"output":3900000,"cacheRead":241000000,"cacheWrite":0},{"id":"gpt-5.6-mini","input":600000,"output":900000,"cacheRead":38000000,"cacheWrite":0}]},{"id":"fireworks","name":"Fireworks","plan":"Prepaid","updatedMinutesAgo":3,"todayPrompts":12,"todaySessions":2,"limits":[],"days":[3100000,4800000,0,6200000,2900000,5400000,1700000],"models":[{"id":"deepseek-v4","input":5200000,"output":2600000,"cacheRead":0,"cacheWrite":0},{"id":"llama-4-maverick","input":1800000,"output":900000,"cacheRead":0,"cacheWrite":0}],"balance":{"remaining":18.4,"funded":50,"spent":31.6,"currency":"USD"}}]}'

# The surfaces --all captures.
all_surfaces=(menu menu-submenu settings settings-scaling menu-search menu-input desktop health lock plymouth btop file-manager neovim notifications notifications-empty clipboard emojis polkit network vpn audio bluetooth agents power monitor tray tray-manage clock weather image-picker apps favorites recent dawn osd workspaces updates)

# Builds $output/hero-showcase.gif from the listed frame PNGs; exits 3 when
# magick or a frame is missing.
build_hero_showcase() {
  command -v magick >/dev/null 2>&1 || {
    echo 'magick is required to build screenshots/hero-showcase.gif' >&2
    exit 3
  }
  # Keep the hero narrative grouped by context: desktop/menu navigation,
  # application launchers, notifications and panels, then system controls and
  # the workspace/update finish. Terminal-heavy captures stay in the gallery
  # but are omitted from the short showcase loop.
  local frames=(desktop menu menu-submenu settings settings-scaling menu-search menu-input apps favorites recent notifications notifications-empty health updates workspaces clipboard emojis image-picker network vpn audio bluetooth agents power monitor tray tray-manage clock weather lock osd)
  local frame
  local frame_paths=()
  for frame in "${frames[@]}"; do
    [[ -f "$output/$frame.png" ]] || {
      echo "Cannot build hero showcase: missing $output/$frame.png" >&2
      exit 3
    }
    frame_paths+=("$output/$frame.png")
  done
  magick -delay 100 -loop 0 "${frame_paths[@]}" \
    -resize 1280x -colors 128 -layers Optimize "$output/hero-showcase.gif"
  printf 'built: %s\n' "$output/hero-showcase.gif"
}

while (($#)); do
  case "$1" in
    --surface)
      (($# >= 2)) || {
        echo '--surface requires a value' >&2
        exit 2
      }
      surface="$2"
      shift
      ;;
    --output)
      (($# >= 2)) || {
        echo '--output requires a directory' >&2
        exit 2
      }
      output="$2"
      shift
      ;;
    --all) capture_all=1 ;;
    --hero) build_hero_only=1 ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if ((build_hero_only)); then
  [[ -n "$output" ]] || {
    echo 'Usage: scripts/capture-screenshots --hero --output <dir>' >&2
    exit 2
  }
  build_hero_showcase
  exit 0
fi

if ((capture_all)); then
  [[ -n "$output" ]] || {
    echo 'Usage: scripts/capture-screenshots --all --output <dir>' >&2
    exit 2
  }
  command -v hyprctl >/dev/null 2>&1 || {
    echo '--all requires hyprctl so captures cannot silently run on the wrong workspace' >&2
    exit 3
  }
  active_workspace="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null || true)"
  [[ -n "$active_workspace" && "$active_workspace" != "null" ]] || {
    echo 'Unable to verify the active workspace; refusing --all capture' >&2
    exit 3
  }
  [[ "$active_workspace" == "2" ]] || {
    echo "Refusing --all capture on workspace $active_workspace; switch to workspace 2 first" >&2
    exit 3
  }
  # The bell is part of the desktop: it stays in every capture. Notifications
  # no longer toast (they go to the center), so instead of hiding the plugin
  # the real inbox is parked for the whole batch and restored afterwards;
  # badges then show capture data only, never the user's own count.
  mkdir -p "$(aranea_state_root)"
  batch_inbox_backup="$(mktemp -d "$(aranea_state_root)/capture-backup.XXXXXX")"
  # Restore the real inbox, leave the finished capture set visible on the
  # intentionally empty workspace for a moment, then return focus. Set
  # before the inbox is parked; the swapped flag is only set once the real
  # inbox has actually been moved aside, and cleared once it is back.
  batch_swapped=0
  batch_finished=0
  batch_finish_status=0
  # Puts the real inbox back (when it was parked; see restore_parked_inbox),
  # restarts the shell, waits, then focuses workspace 1. Runs once (the EXIT
  # trap stays set while the explicit call runs); fails when the inbox could
  # not be restored, after the shell is back. Says what became of
  # notifications that arrived during the capture.
  finish_batch() {
    if ((batch_finished)); then
      return "$batch_finish_status"
    fi
    if ((batch_swapped)); then
      if restore_parked_inbox "$batch_inbox_backup"; then
        batch_swapped=0
        printf '%s\n' 'note: notifications that arrived during the capture were not kept (the real inbox was parked)' >&2
      else
        batch_finish_status=1
        printf '%s\n' 'note: notifications that arrived during the capture are still in the inbox, next to the capture ones' >&2
      fi
    else
      remove_empty_backup "$batch_inbox_backup" || batch_finish_status=1
    fi
    omarchy restart shell >/dev/null 2>&1 || true
    sleep "${ARANEA_CAPTURE_RETURN_DELAY:-10}"
    hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })' >/dev/null 2>&1 || true
    batch_finished=1
    return "$batch_finish_status"
  }
  # A batch that stops early (set -e) still restores the inbox and focus.
  trap 'finish_batch || exit 1' EXIT
  if ! park_notification_inbox "$batch_inbox_backup" batch_swapped; then
    echo 'notification inbox not parked (session locked, shell still running or a file could not be moved); nothing captured' >&2
    exit 3
  fi
  sleep 3
  # Captures one surface in a child run; fails when it wrote no new PNG. The
  # previous PNG is set aside first (so it never counts as a new capture) and
  # put back when the capture fails, so the README keeps its old screenshot.
  capture_one() {
    local all_surface="$1"
    local png="$output/$all_surface.png" previous="$output/.$all_surface.png.previous"
    rm -f -- "$previous"
    if [[ -f "$png" ]]; then mv -- "$png" "$previous"; fi
    if [[ -n "${ARANEA_CAPTURE_SURFACE_COMMAND:-}" ]]; then
      "$ARANEA_CAPTURE_SURFACE_COMMAND" "$all_surface" "$output" || true
    else
      "$0" --surface "$all_surface" --output "$output" || true
    fi
    if [[ -f "$png" ]]; then
      rm -f -- "$previous"
      return 0
    fi
    if [[ -f "$previous" ]]; then mv -- "$previous" "$png"; fi
    return 1
  }
  # A failed surface is reported at the end; the batch captures the rest.
  failed_surfaces=()
  for all_surface in "${all_surfaces[@]}"; do
    capture_one "$all_surface" || failed_surfaces+=("$all_surface")
  done
  # The hero GIF needs every frame; with failures it is left as it was.
  if ((${#failed_surfaces[@]} == 0)); then
    build_hero_showcase
  else
    printf '%s\n' 'hero showcase not rebuilt: some surfaces failed' >&2
  fi
  # Normal completion restores explicitly; the trap only covers a batch that
  # stops early, and stays set until the explicit restore is done.
  batch_restore_status=0
  finish_batch || batch_restore_status=1
  trap - EXIT
  if ((${#failed_surfaces[@]})); then
    printf 'capture failed: %s\n' "${failed_surfaces[*]}" >&2
    exit 1
  fi
  exit "$batch_restore_status"
fi

[[ -n "$surface" && -n "$output" ]] || {
  echo 'Usage: scripts/capture-screenshots --surface <name> --output <dir>' >&2
  exit 2
}
showcase_surface="$surface"
case "$surface" in
  settings | settings-scaling | settings-narrow | settings-dirty | settings-unavailable | settings-integration-failed | settings-notifications) showcase_surface=settings ;;
  menu-search-mixed | menu-search-no-match | menu-search-no-compositor | menu-search-vanished) showcase_surface=menu ;;
  plymouth) showcase_surface=boot ;;
  btop) showcase_surface=about ;;
  neovim) showcase_surface=editor ;;
  notifications-empty) showcase_surface=notifications ;;
esac
"$repo_root/scripts/aranea-showcase" surface "$showcase_surface" >/dev/null
mkdir -p "$output"

# Settings and search captures use production content with inert owner fixtures.
case "$surface" in
  menu-search-mixed | menu-search-no-match | menu-search-no-compositor | menu-search-vanished)
    "$repo_root/tools/render-menu-preview" --output "$output/$surface.png" --fixture "${surface#menu-search-}"
    exit 0
    ;;
  settings-narrow | settings-dirty | settings-unavailable | settings-integration-failed | settings-notifications)
    settings_fixture="${surface#settings-}"
    [[ "$surface" != settings ]] || settings_fixture=wide
    "$repo_root/tools/render-settings-preview" --output "$output/$surface.png" --fixture "$settings_fixture"
    exit 0
    ;;
esac

# Capture the normal production Settings layer with acknowledged inert owner state.
# The private transaction restores UI/showcase; the shell restores workspace/focus.
capture_settings_surface() (
  command -v omarchy-shell >/dev/null && command -v grim >/dev/null && command -v jq >/dev/null || exit 3
  local snapshot fixture answer previous_workspace previous_focus staged restore_needed=0
  snapshot="$(omarchy-shell aranea.settings.capture captureSnapshot 2>/dev/null)" || exit 3
  jq -e 'type == "object" and (.opened | type == "boolean") and (.section | type == "string")' <<<"$snapshot" >/dev/null || exit 3
  local workspace_snapshot focus_snapshot
  workspace_snapshot="$(hyprctl activeworkspace -j 2>/dev/null)" || {
    echo 'Unable to read Settings capture workspace' >&2
    exit 3
  }
  previous_workspace="$(jq -er -s '
    if length == 1 and (.[0] | type == "object") and (.[0].id | type == "number")
      and (.[0].id | . > 0 and . <= 2147483647 and floor == .)
    then .[0].id else error("invalid workspace snapshot") end' <<<"$workspace_snapshot" 2>/dev/null)" || {
    echo 'Invalid Settings capture workspace snapshot' >&2
    exit 3
  }
  focus_snapshot="$(hyprctl activewindow -j 2>/dev/null)" || {
    echo 'Unable to read Settings capture focus' >&2
    exit 3
  }
  previous_focus="$(jq -er -s '
    if length == 1 and (.[0] | type == "object") and
      (.[0] == {} or ((.[0].address | type == "string") and (.[0].address | test("^0x[0-9a-fA-F]+$"))))
    then .[0].address // "" else error("invalid focus snapshot") end' <<<"$focus_snapshot" 2>/dev/null)" || {
    echo 'Invalid Settings capture focus snapshot' >&2
    exit 3
  }
  fixture="$(jq -cn --arg section "$([[ "$surface" == settings-scaling ]] && echo display || echo appearance)" --arg artwork "$repo_root/backgrounds/" --arg snapshot "$snapshot" '
    {section: $section, snapshot: $snapshot, fixture: {displayDraft: (if $section == "display" then "2.667" else "" end), state: {
      display: {monitor:"eDP-1",scale: (if $section == "display" then 2.666667 else 2 end),width:3840,height:2160,availability:"available",persistenceSupport:"supported",configuredScale: (if $section == "display" then 2.66667 else 2 end)},
      motion:{configured:"on",applied:"on",application:"applied",availability:"available"},
      wallpaper:{activeId:"day",availability:"available"},
      wallpapers:[{id:"day",label:"Day",path:($artwork+"background-day.png"),available:true},{id:"night",label:"Night",path:($artwork+"background-night.png"),available:true}],wallpapersAvailability:"available",
      schedule:{enabled:true,applied:true,availability:"available",dawn:"06:00",day:"08:00",dusk:"18:00",night:"20:00"},
      integrations:[{id:"session",status:"inactive",availability:"available"},{id:"terminal",status:"active",availability:"available"}],integrationsAvailability:"available"},
      notifications:{dnd:"off",dndAvailability:"available",quiet:"scheduled",quietAvailability:"available",window:"22:00-07:00",windowAvailability:"available"},
      results:(if $section == "display" then {"display-scale":"Applied · 2.666667 · saved"} else {} end), itemErrors:{}}}')"
  staged="$(mktemp "$output/.settings-capture.XXXXXX.png")"
  # Restore only Settings by identity, then the previously focused workspace/client.
  restore_settings_capture() {
    local failed=0
    if ((restore_needed)); then
      answer="$(omarchy-shell aranea.settings.capture captureRestore "$snapshot" 2>/dev/null || true)"
      [[ "$answer" == ok ]] || {
        echo 'Settings capture restoration failed' >&2
        failed=1
      }
      if [[ -n "$previous_workspace" ]]; then
        hyprctl dispatch "hl.dsp.focus({ workspace = \"$previous_workspace\" })" >/dev/null 2>&1 || failed=1
      fi
      if [[ "$previous_focus" =~ ^0x[[:xdigit:]]+$ ]]; then
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$previous_focus\" })" >/dev/null 2>&1 || failed=1
      fi
      restore_needed=0
    fi
    rm -f -- "$staged"
    return "$failed"
  }
  trap 'restore_settings_capture || exit 3' EXIT
  answer="$(omarchy-shell aranea.settings.capture captureBegin "$fixture" 2>/dev/null || true)"
  if [[ "$answer" != ok ]]; then
    printf 'Settings capture fixture refused: %s\n' "$answer" >&2
    exit 3
  fi
  restore_needed=1
  hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })' >/dev/null 2>&1 || exit 3
  local attempt ready=0
  for ((attempt = 0; attempt < 30; attempt++)); do
    answer="$(omarchy-shell aranea.settings.capture captureState 2>/dev/null || true)"
    jq -e '.readOnly == true' <<<"$answer" >/dev/null 2>&1 || exit 3
    if jq -e '.ready == true' <<<"$answer" >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.1
  done
  ((ready)) || {
    echo 'Settings capture never became ready' >&2
    exit 3
  }
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  grim "$staged" && [[ -s "$staged" ]] || exit 3
  # Restoration failure keeps the old output, just like failed screenshot capture.
  local completed
  completed="$(mktemp "$output/.settings-complete.XXXXXX.png")"
  mv -- "$staged" "$completed"
  restore_settings_capture || {
    rm -f -- "$completed"
    exit 3
  }
  trap - EXIT
  mv -f -- "$completed" "$output/$surface.png"
  printf 'captured: %s\n' "$output/$surface.png"
)

# Opens the Aranea menu page for $surface and grabs the screen with grim.
capture_menu_surface() {
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  local payload
  case "$surface" in
    menu) payload='{"menu":"root"}' ;;
    menu-submenu) payload='{"menu":"system"}' ;;
    apps) payload='{"menu":"apps"}' ;;
    favorites) payload='{"menu":"apps.favorites"}' ;;
    recent) payload='{"menu":"apps.recent"}' ;;
    menu-search) payload='{"mode":"select","prompt":"Search","options":["Files","Terminal","Workspace"]}' ;;
    menu-input) payload='{"mode":"input","prompt":"Name"}' ;;
    *) return 1 ;;
  esac

  omarchy-shell shell hide araneadev.menu >/dev/null 2>&1 || true
  omarchy-shell shell toggle araneadev.menu "$payload"
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  # A grim error after the frame was written is not fatal; no frame is.
  grim "$output/$surface.png" || true
  omarchy-shell shell hide araneadev.menu >/dev/null 2>&1 || true
  if [[ ! -f "$output/$surface.png" ]]; then
    echo "capture failed: $output/$surface.png was not written" >&2
    return 3
  fi
  printf 'captured: %s\n' "$output/$surface.png"
}

# Prints the address of every window on the capture workspace (2), one per
# line.
capture_window_addresses() {
  hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.workspace.id == 2) | .address' 2>/dev/null || true
}

# Closes the windows on the capture workspace that were not in BEFORE (the
# output of capture_window_addresses taken before launching the capture app),
# by address. Never "the active window": focus may be on the user's own
# window by the time the capture finishes.
close_new_windows() {
  local before="$1" address
  while IFS= read -r address; do
    [[ -n "$address" ]] || continue
    grep -Fxq -- "$address" <<<"$before" && continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1 || true
  done < <(capture_window_addresses)
}

# Opens kitty with the Aranea config running COMMAND in a window titled
# TITLE, grabs the screen, then closes the window.
capture_terminal_surface() {
  local title="$1"
  local command_name="$2"
  command -v kitty >/dev/null 2>&1 || {
    echo "kitty is required to capture $surface" >&2
    exit 3
  }
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "$command_name is required to capture $surface" >&2
    exit 3
  }

  local windows_before
  windows_before="$(capture_window_addresses)"
  kitty --config "$repo_root/integrations/terminal/kitty.conf" \
    --class "aranea-screenshot-$surface" --title "$title" \
    --override initial_window_width=104c --override initial_window_height=34c \
    -e "$command_name" &
  local child_pid=$!
  sleep 1
  hyprctl dismissnotify >/dev/null 2>&1 || true
  sleep "${ARANEA_SCREENSHOT_DELAY:-2}"
  grim "$output/$surface.png"
  # Close the capture window immediately so the next surface cannot inherit it.
  close_new_windows "$windows_before"
  kill "$child_pid" >/dev/null 2>&1 || true
  wait "$child_pid" >/dev/null 2>&1 || true
  # Terminal applications can exit non-zero after the compositor frame is
  # already captured (Neovim emits a harmless terminal escape warning on some
  # builds). Keep the frame and continue the batch when the file exists.
  if [[ ! -f "$output/$surface.png" ]]; then
    echo "capture failed: $output/$surface.png was not written" >&2
    return 3
  fi
  printf 'captured: %s\n' "$output/$surface.png"
}

# Summons shell popup TARGET, grabs the screen, then hides it.
capture_popup_surface() {
  local target="$1" payload="${2:-}"
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  local summon_result
  if [[ -n "$payload" ]]; then
    summon_result="$(omarchy-shell shell summon "$target" "$payload" 2>&1)"
  else
    summon_result="$(omarchy-shell shell summon "$target" 2>&1)"
  fi
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon popup $target: $summon_result" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

# Summons dropdown TARGET, hands it the stand-in NAMES (JSON: an array, or
# Audio's or Agents' object) through
# its showcase IPC method, waits SECONDS... (each one slept in turn), grabs
# the screen, then hides it, which clears the names. A failed summon, or a
# showcase answer other than "ok" (a closed dropdown answers "closed"), exits
# 3 before anything is grabbed.
capture_showcase_surface() {
  local target="$1" names="$2"
  shift 2
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  local summon_result showcase_result seconds
  summon_result="$(omarchy-shell shell summon "$target" 2>&1 || true)"
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon popup $target: $summon_result" >&2
    exit 3
  fi
  # The leading space keeps qs from reading a bracketed argument as a list
  # (it would split '["a","b"]' into two arguments); JSON.parse skips it.
  showcase_result="$(omarchy-shell "$target" showcase " $names" 2>&1 || true)"
  if [[ "$showcase_result" != "ok" ]]; then
    omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
    printf 'capture failed: %s did not take the stand-in names (showcase answered "%s"); is the Aranea dropdown active? No screenshot written.\n' "$target" "$showcase_result" >&2
    exit 3
  fi
  for seconds in "$@"; do
    sleep "$seconds"
  done
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

# Summons the VPN dropdown (bar widget araneadev.vpn) and hands it FIXTURE (a
# JSON array of fixture rows) through its `showcaseFixture` IPC method on
# target aranea.vpn, waits, grabs the screen, then hides it, which clears the
# fixture. A failed summon, or a showcaseFixture answer other than "ok" (a
# closed dropdown answers "closed"), exits 3 before anything is grabbed, so
# the machine's real VPN profiles never reach a screenshot.
capture_vpn_surface() {
  local fixture="$1"
  local summon_target=araneadev.vpn ipc_target=aranea.vpn
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide "$summon_target" >/dev/null 2>&1 || true
  local summon_result fixture_result
  summon_result="$(omarchy-shell shell summon "$summon_target" 2>&1 || true)"
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon popup $summon_target: $summon_result" >&2
    exit 3
  fi
  # The leading space keeps qs from reading a bracketed argument as a list
  # (it would split '[{...}]' into many arguments); JSON.parse skips it.
  fixture_result="$(omarchy-shell "$ipc_target" showcaseFixture " $fixture" 2>&1 || true)"
  if [[ "$fixture_result" != "ok" ]]; then
    omarchy-shell shell hide "$summon_target" >/dev/null 2>&1 || true
    printf 'capture failed: %s did not take the fixture rows (showcaseFixture answered "%s"); is the Aranea VPN dropdown active? No screenshot written.\n' "$ipc_target" "$fixture_result" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  omarchy-shell shell hide "$summon_target" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

# Summons the Clock dropdown (target omarchy.clock) and hands it PLACE (a
# JSON {"name","latitude","longitude"} object) through its `showcase` IPC
# method, waits, grabs the screen, then hides it, which clears the stand-in
# place. A failed summon, or a showcase answer other than "ok" (a closed
# dropdown answers "closed"), exits 3 before anything is grabbed, so the
# README never shows the user's real area. Each monitor's bar hosts its own
# clock, and the IPC target lands on just one of them, so that instance
# relays the showcase to whichever one's dropdown the summon opened; the
# delay then lets the stand-in's caption and sun redraw before grim. The
# stand-in's sunrise and sunset are computed in this machine's timezone
# (the dropdown's local time), not the place's own.
capture_clock_surface() {
  local place="$1" target=omarchy.clock
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  local summon_result showcase_result
  summon_result="$(omarchy-shell shell summon "$target" 2>&1 || true)"
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon popup $target: $summon_result" >&2
    exit 3
  fi
  showcase_result="$(omarchy-shell "$target" showcase "$place" 2>&1 || true)"
  if [[ "$showcase_result" != "ok" ]]; then
    omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
    printf 'capture failed: %s did not take the stand-in place (showcase answered "%s"); is the Aranea dropdown active? No screenshot written.\n' "$target" "$showcase_result" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

# True once NAME (a StatusNotifierItem bus name such as
# "org.kde.StatusNotifierItem-1234-1") appears in the StatusNotifierWatcher's
# RegisteredStatusNotifierItems, polling for up to 10s. False (no retries
# left) when the watcher never lists it.
tray_wait_for_registration() {
  local name="$1" tries=0
  while ((tries < 100)); do
    if busctl --user --json=short get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
      org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null |
      jq -e --arg n "$name" '.data | any(startswith($n))' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
    tries=$((tries + 1))
  done
  return 1
}

# Starts two dev-only fixture tray items (tools/fixture-tray-item: "Courier",
# then once it is registered, "Syncbox" with a different icon, so the
# drawer's SystemTray order is deterministic with Courier first), fails
# closed (exit 3, no screenshot, both fixtures killed) if either never
# registers with the StatusNotifierWatcher or if the watcher also lists any
# item that is not one of those two fixtures (so a real tray app can never
# reach a tray screenshot), summons `araneadev.tray`'s `menu 0` IPC method
# for $surface=tray (Courier's drawer index) or its `manage` method for
# $surface=tray-manage, and grabs the screen into $output/$surface.png, then
# closes the popup and always kills the two fixtures by their own PIDs
# (never a pattern match, which could also hit this very capture shell).
capture_tray_surface() {
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }
  if ! command -v busctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "busctl and jq are required to capture $surface (to verify only the fixtures are on the tray)" >&2
    exit 3
  fi

  local courier_pid="" syncbox_pid="" courier_name="" syncbox_name=""
  # Kills exactly the two fixture PIDs started below (by PID, never a
  # `pkill -f` pattern, which could also match this capture shell itself).
  # Each step tolerates a fixture that is already gone.
  tray_cleanup_fixtures() {
    [[ -n "$courier_pid" ]] && kill "$courier_pid" >/dev/null 2>&1 || true
    [[ -n "$syncbox_pid" ]] && kill "$syncbox_pid" >/dev/null 2>&1 || true
    [[ -n "$courier_pid" ]] && wait "$courier_pid" >/dev/null 2>&1 || true
    [[ -n "$syncbox_pid" ]] && wait "$syncbox_pid" >/dev/null 2>&1 || true
    return 0
  }
  # Succeeds only when the watcher's list could be read, is not empty and
  # holds nothing but the two fixtures; prints why otherwise. Fails closed:
  # a busctl or jq failure counts as a mismatch.
  tray_only_fixtures() {
    local registered_json
    if ! registered_json="$(busctl --user --json=short get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
      org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null)"; then
      echo "could not read the StatusNotifierWatcher's registered items"
      return 1
    fi
    if ! jq -e --arg c "$courier_name" --arg s "$syncbox_name" \
      '(.data | type) == "array" and (.data | length) > 0 and all(.data[]; startswith($c) or startswith($s))' \
      <<<"$registered_json" >/dev/null 2>&1; then
      printf 'the tray holds something other than the two fixtures (%s)\n' "$registered_json"
      return 1
    fi
    return 0
  }
  trap tray_cleanup_fixtures EXIT

  "$repo_root/tools/fixture-tray-item" --name Courier >/dev/null 2>&1 &
  courier_pid=$!
  courier_name="org.kde.StatusNotifierItem-$courier_pid-1"
  if ! tray_wait_for_registration "$courier_name"; then
    echo "capture failed: the Courier fixture never registered with the StatusNotifierWatcher; no screenshot written" >&2
    exit 3
  fi

  "$repo_root/tools/fixture-tray-item" --name Syncbox --icon folder-download-symbolic >/dev/null 2>&1 &
  syncbox_pid=$!
  syncbox_name="org.kde.StatusNotifierItem-$syncbox_pid-1"
  if ! tray_wait_for_registration "$syncbox_name"; then
    echo "capture failed: the Syncbox fixture never registered with the StatusNotifierWatcher; no screenshot written" >&2
    exit 3
  fi

  # Fail closed: refuse both tray captures if the watcher's list can't be
  # read, is empty, or holds any item that is not one of the two fixtures
  # just started.
  local mismatch
  if ! mismatch="$(tray_only_fixtures)"; then
    printf 'capture failed: %s; refusing both tray captures so a real app never reaches a screenshot\n' "$mismatch" >&2
    exit 3
  fi
  # The fixture's Id is its name: a saved pin or hide of "Courier" or
  # "Syncbox" would move or hide a fixture and change what `menu 0` opens.
  local config_file
  config_file="$(xdg_config_home)/omarchy/shell.json"
  if [[ -f "$config_file" ]] && ! jq -e '
      [.bar.layout[]? | arrays | .[] | objects
        | select(.id == "araneadev.tray" or .id == "omarchy.tray")
        | ((.pinned // []) + (.hidden // []))[]]
      | any(. == "Courier" or . == "Syncbox") | not' "$config_file" >/dev/null 2>&1; then
    echo "capture failed: Courier or Syncbox is in the tray entry's saved pinned or hidden list (or $config_file is unreadable); no screenshot written" >&2
    exit 3
  fi

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell -q araneadev.tray close >/dev/null 2>&1 || true
  # Courier is the first (index 0) drawer item: a fixture's Id is its name,
  # neither name is in the saved pinned or hidden lists (checked above), so
  # TrayLogic.menuTarget's drawer bucket (SystemTray insertion order) puts
  # Courier, registered first, at index 0.
  local ipc_result="" ipc_status=0
  case "$surface" in
    tray)
      ipc_result="$(omarchy-shell araneadev.tray menu 0 2>&1)" || ipc_status=$?
      ;;
    tray-manage)
      ipc_result="$(omarchy-shell araneadev.tray manage 2>&1)" || ipc_status=$?
      ;;
  esac
  if ((ipc_status != 0)) || [[ -n "$ipc_result" ]]; then
    echo "Unable to summon araneadev.tray for $surface: ${ipc_result:-exit $ipc_status}" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  # The same check again: an app that registered while the popup was up
  # could be in the screenshot, which is then deleted.
  if ! mismatch="$(tray_only_fixtures)"; then
    rm -f "$output/$surface.png"
    omarchy-shell -q araneadev.tray close >/dev/null 2>&1 || true
    printf 'capture failed: %s after the capture; screenshot deleted\n' "$mismatch" >&2
    exit 3
  fi
  omarchy-shell -q araneadev.tray close >/dev/null 2>&1 || true
  tray_cleanup_fixtures
  trap - EXIT
  printf 'captured: %s\n' "$output/$surface.png"
}

# Opens a bar-owned popover through its IPC target, grabs the screen, then
# closes it. These widgets are bar entries rather than standalone shell
# panels, so they cannot use `shell summon`.
capture_bar_widget_surface() {
  bar_capture_target="$1"
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  bar_capture_previous_workspace="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null || true)"
  # Restores the workspace, temporary update marker and shell after capture.
  restore_bar_capture_workspace() {
    [[ -n "$bar_capture_target" ]] && omarchy-shell -q "$bar_capture_target" close || true
    if ((bar_capture_update_marker_created)); then
      rm -f -- "$bar_capture_update_marker"
      omarchy restart shell >/dev/null 2>&1 || true
      sleep 3
      bar_capture_update_marker_created=0
    fi
    if [[ -n "$bar_capture_previous_workspace" ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = \"$bar_capture_previous_workspace\" })" >/dev/null 2>&1 || true
    fi
  }
  trap restore_bar_capture_workspace EXIT
  hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })' >/dev/null 2>&1 || true
  if [[ "$bar_capture_target" == araneadev.updates && ! -e "$bar_capture_update_marker" ]]; then
    mkdir -p "${bar_capture_update_marker%/*}"
    touch "$bar_capture_update_marker"
    bar_capture_update_marker_created=1
    omarchy restart shell >/dev/null 2>&1 || true
    sleep 3
  fi
  sleep 1
  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell -q "$bar_capture_target" close || true
  omarchy-shell "$bar_capture_target" open >/dev/null
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  trap - EXIT
  restore_bar_capture_workspace
  printf 'captured: %s\n' "$output/$surface.png"
}

# Shows a sample volume OSD on workspace 2 and grabs the screen.
capture_osd_surface() {
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo 'omarchy-shell is required to capture osd' >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo 'grim is required to capture osd' >&2
    exit 3
  }

  # OSD captures must always be taken on the clean showcase workspace.  This
  # avoids terminal/chat text leaking into the reference frame.
  hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })' >/dev/null 2>&1 || true
  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide araneadev.osd >/dev/null 2>&1 || true
  local summon_result
  summon_result="$(omarchy-shell shell summon araneadev.osd '{"icon":"volume","message":"","value":71,"max":100,"duration":5000}' 2>&1)"
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon OSD: $summon_result" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  hyprctl dismissnotify >/dev/null 2>&1 || true
  grim "$output/$surface.png"
  omarchy-shell shell hide araneadev.osd >/dev/null 2>&1 || true
  printf 'captured: %s (workspace 2 live OSD)\n' "$output/$surface.png"
}

case "$surface" in
  settings | settings-scaling)
    capture_settings_surface
    exit 0
    ;;
  menu | menu-submenu | menu-search | menu-input | apps | favorites | recent)
    capture_menu_surface
    exit 0
    ;;
  desktop)
    hyprctl dismissnotify >/dev/null 2>&1 || true
    grim "$output/$surface.png"
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  notifications | notifications-empty)
    mkdir -p "$(aranea_state_root)"
    inbox_backup="$(mktemp -d "$(aranea_state_root)/capture-backup.XXXXXX")"
    # Put the real inbox back however this ends (set by the park below, the
    # moment the real inbox has been moved aside).
    # Only undo what was done: before the park, the inbox is the real one and
    # must not be touched.
    inbox_swapped=0
    inbox_restored=0
    inbox_restore_status=0
    # Hides the notification center; when the inbox was parked, dismisses the
    # capture popups, puts the real inbox back (restore_parked_inbox) and
    # restarts the shell, also when the restore failed. Runs once (the EXIT
    # trap stays set while the explicit call runs); fails when the inbox could
    # not be restored.
    restore_inbox() {
      if ((inbox_restored)); then
        return "$inbox_restore_status"
      fi
      omarchy-shell shell hide araneadev.notifications >/dev/null 2>&1 || true
      if ((! inbox_swapped)); then
        remove_empty_backup "$inbox_backup" || inbox_restore_status=1
        inbox_restored=1
        return "$inbox_restore_status"
      fi
      omarchy-shell notifications dismissAll >/dev/null 2>&1 || true
      if restore_parked_inbox "$inbox_backup"; then
        inbox_swapped=0
      else
        inbox_restore_status=1
      fi
      omarchy restart shell >/dev/null 2>&1 || true
      inbox_restored=1
      return "$inbox_restore_status"
    }
    trap 'restore_inbox || exit 1' EXIT
    # Sanitized fixtures: park the real inbox, show only capture notifications.
    if ! park_notification_inbox "$inbox_backup" inbox_swapped; then
      echo "notification inbox not parked (session locked, shell still running or a file could not be moved); $surface not captured" >&2
      exit 3
    fi
    sleep 2
    case "$surface" in
      notifications)
        # Notifications go straight to the center (no toasts); one critical
        # entry shows the red bell badge.
        for app in Slack Slack Slack Build; do
          notify-send -a "$app" "$app update" 'Theme capture · notification center' || true
        done
        notify-send -a Alarm -u critical 'Battery low' 'Theme capture · critical notification' || true
        sleep 1
        omarchy-shell shell toggle araneadev.notifications >/dev/null
        ;;
      notifications-empty)
        omarchy-shell shell toggle araneadev.notifications >/dev/null
        ;;
    esac
    sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
    grim "$output/$surface.png"
    restore_inbox || exit 1
    trap - EXIT
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  clipboard | emojis)
    # Fixture data only: the real clipboard history (or emoji recents) is set
    # aside for the capture and put back afterwards, so no real clipboard
    # content can reach a screenshot. Files are swapped only while the shell
    # is stopped, so a running picker can neither capture into the fixture nor
    # write its in-memory history over the restored file.
    state_home="$(xdg_state_home)"
    if [[ "$surface" == clipboard ]]; then
      picker_file="$HOME/.local/state/omarchy/clipboard-history.json"
      picker_id=omarchy.clipboard
    else
      picker_file="$state_home/aranea/emoji-recent.json"
      picker_id=omarchy.emojis
    fi
    # The backup lives in the state dir, not /tmp: if this script is killed,
    # the real file is still next to where it belongs.
    mkdir -p "$state_home/aranea"
    picker_backup="$(mktemp -d "$state_home/aranea/capture-backup.XXXXXX")"
    clip_type=""
    # Put everything back however this ends (set before anything is moved).
    # Only undo what was actually done: a run that stops before the real file
    # was moved aside must not delete it, nor clear an untouched clipboard.
    picker_swapped=0
    clipboard_swapped=0
    picker_finished=0
    picker_finish_status=0
    # Stops the shell (stop_omarchy_shell), restores the picker file and
    # clipboard (only what was swapped), deletes the backup dir and restarts
    # the shell. When the shell cannot be stopped, a running picker could
    # write its fixture history over the restored file, so the swapped file
    # stays in the backup (named on stderr) and the capture fails. Runs once
    # (the EXIT trap stays set while the explicit call runs).
    finish_picker() {
      local keep_backup=0
      if ((picker_finished)); then
        return "$picker_finish_status"
      fi
      if ((picker_swapped)) && ! stop_omarchy_shell; then
        printf 'picker history not restored (shell still running / session locked); yours is kept in %s\n' "$picker_backup" >&2
        keep_backup=1
        picker_finish_status=1
      elif ((picker_swapped)); then
        rm -f "$picker_file"
        if [[ -e "$picker_backup/saved" ]] && ! mv "$picker_backup/saved" "$picker_file"; then
          printf 'picker history not restored; yours is kept in %s\n' "$picker_backup" >&2
          keep_backup=1
          picker_finish_status=1
        fi
      fi
      if [[ "$surface" == clipboard ]] && ((clipboard_swapped)); then
        if [[ -n "$clip_type" ]]; then wl-copy --type "$clip_type" <"$picker_backup/clipboard"; else wl-copy --clear; fi
      fi
      ((keep_backup)) || rm -rf "$picker_backup"
      omarchy restart shell >/dev/null 2>&1 || true
      picker_finished=1
      return "$picker_finish_status"
    }
    trap 'finish_picker || exit 1' EXIT
    if ! stop_omarchy_shell; then
      echo "shell not stopped (session locked or shell still running); $surface not captured, nothing was swapped" >&2
      exit 3
    fi
    [[ -e "$picker_file" ]] && mv "$picker_file" "$picker_backup/saved"
    picker_swapped=1
    if [[ "$surface" == clipboard ]]; then
      # The picker records the live clipboard when the shell starts: save it
      # (never a password manager's marker type) and seed fixture text.
      clip_type="$(wl-paste --list-types 2>/dev/null | grep -vx 'x-kde-passwordManagerHint' | head -n 1 || true)"
      if [[ -n "$clip_type" ]] && ! wl-paste --type "$clip_type" >"$picker_backup/clipboard" 2>/dev/null; then
        echo "could not save the clipboard; not replacing it" >&2
        exit 3
      fi
      clipboard_swapped=1
      printf '%s' "https://github.com/AraneaDev/aranea-desktop" | wl-copy
    fi
    mkdir -p "$(dirname "$picker_file")"
    now_ms="$(date +%s%3N)"
    if [[ "$surface" == clipboard ]]; then
      jq -n --argjson now "$now_ms" --arg img "$repo_root/screenshots/desktop.png" '[
        {type:"text", text:"https://github.com/AraneaDev/aranea-desktop", pinned:true, pinnedAtMs:($now - 7200000), capturedAtMs:($now - 7200000)},
        {type:"text", text:"ghp_Fixture0123456789abcdefABCDEF0123", capturedAtMs:($now - 180000)},
        {type:"text", text:"#7a5cff", capturedAtMs:($now - 600000)},
        {type:"text", text:"for f in *.png; do\n  magick \"$f\" -resize 50% \"small-$f\"\ndone", capturedAtMs:($now - 900000)},
        {type:"text", text:"~/Work/AraneaDev/aranea-desktop/README.md", capturedAtMs:($now - 1500000)},
        {type:"image", path:$img, mime:"image/png", capturedAt:"Sunday 11:20", capturedAtMs:($now - 2400000)},
        {type:"text", text:"A quiet obsidian desktop with a living network of light.", capturedAtMs:($now - 3600000)}
      ]' >"$picker_file"
    else
      printf '%s\n' '{"version":1,"recent":["🚀","✅","👍","🎉","🔥","🕷️","💚","✨"]}' >"$picker_file"
    fi
    omarchy restart shell >/dev/null 2>&1 || true
    sleep 5
    omarchy-shell shell toggle "$picker_id" >/dev/null
    sleep 1.5
    grim "$output/$surface.png"
    finish_picker || exit 1
    trap - EXIT
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  polkit)
    # A harmless request (pkexec /usr/bin/true) with the details open. It is
    # always cancelled with Escape; nothing is ever typed into the field.
    command -v pkexec >/dev/null 2>&1 || {
      echo "pkexec is required to capture $surface" >&2
      exit 3
    }
    command -v wtype >/dev/null 2>&1 || {
      echo "wtype is required to capture $surface" >&2
      exit 3
    }
    pkexec /usr/bin/true >/dev/null 2>&1 &
    pkexec_pid=$!
    # True when the omarchy-polkit layer is on screen.
    prompt_visible() {
      hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | select(.namespace? == "omarchy-polkit")] | length > 0' >/dev/null 2>&1
    }
    # Escape goes only to the prompt (it holds the keyboard while visible);
    # a pkexec still running after that is killed, never waited on forever.
    finish_polkit() {
      if prompt_visible; then
        wtype -k Escape >/dev/null 2>&1 || true
        sleep 1
      fi
      if kill -0 "$pkexec_pid" 2>/dev/null; then kill "$pkexec_pid" 2>/dev/null || true; fi
      wait "$pkexec_pid" 2>/dev/null || true
    }
    trap finish_polkit EXIT
    shown=0
    for _ in $(seq 1 20); do
      if prompt_visible; then
        shown=1
        break
      fi
      sleep 0.5
    done
    if ((! shown)); then
      echo "polkit prompt never appeared; is a polkit agent registered?" >&2
      exit 3
    fi
    # Give the pkaction lookup a moment, then open the details.
    sleep 1
    wtype -k Tab
    sleep 0.5
    grim "$output/$surface.png"
    finish_polkit
    trap - EXIT
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  health)
    # The health dropdown with one live problem: a throwaway failing unit.
    # The probe is always reset, even when a later step fails, so no red
    # problem is left behind in the real dropdown.
    # Clear it before the next surface: reset the unit, recheck at once and
    # wait for the monitor to report healthy again.
    cleanup_health_probe() {
      omarchy-shell shell hide araneadev.health >/dev/null 2>&1 || true
      systemctl --user reset-failed aranea-capture-probe >/dev/null 2>&1 || true
      omarchy-shell health refresh >/dev/null 2>&1 || true
      for _ in $(seq 1 20); do
        [[ "$(omarchy-shell health status 2>/dev/null)" == critical ]] || break
        sleep 0.5
      done
    }
    trap cleanup_health_probe EXIT
    # A fresh shell has no CPU history yet; wait for ~100 s of it (50
    # samples at 2 s) so the sparkline is a real graph.
    for _ in $(seq 1 120); do
      (($(omarchy-shell health metrics 2>/dev/null | jq -r '.samples // 0' 2>/dev/null || echo 0) >= 50)) && break
      sleep 2
    done
    systemd-run --user --unit=aranea-capture-probe false >/dev/null 2>&1 || true
    sleep 1
    omarchy-shell health refresh >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do
      [[ "$(omarchy-shell health status 2>/dev/null)" == critical ]] && break
      sleep 1
    done
    omarchy-shell shell toggle araneadev.health >/dev/null
    sleep 3
    grim "$output/$surface.png"
    cleanup_health_probe
    trap - EXIT
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  btop)
    hyprctl dismissnotify >/dev/null 2>&1 || true
    capture_terminal_surface "Aranea Btop" btop
    exit 0
    ;;
  neovim)
    hyprctl dismissnotify >/dev/null 2>&1 || true
    capture_terminal_surface "Aranea Neovim" nvim
    exit 0
    ;;
  network)
    # Stand-in SSIDs, and 20 s for the 60 s link graph to draw a trace.
    capture_showcase_surface omarchy.network "${ARANEA_CAPTURE_WIFI_NAMES:-$default_wifi_names}" \
      "${ARANEA_NETWORK_GRAPH_DELAY:-20}"
    exit 0
    ;;
  vpn)
    # Stand-in fixture rows: never the machine's real VPN profiles.
    capture_vpn_surface "${ARANEA_CAPTURE_VPN_FIXTURE:-$default_vpn_fixture}"
    exit 0
    ;;
  audio)
    # Stand-in device, app and track names: never the user's own.
    capture_showcase_surface omarchy.audio "${ARANEA_CAPTURE_AUDIO_SHOWCASE:-$default_audio_showcase}" \
      "${ARANEA_SCREENSHOT_DELAY:-1}"
    exit 0
    ;;
  bluetooth)
    # Stand-in device names, and a few seconds more for the scan to find some.
    capture_showcase_surface omarchy.bluetooth "${ARANEA_CAPTURE_BT_NAMES:-$default_bt_names}" \
      "${ARANEA_SCREENSHOT_DELAY:-1}" "${ARANEA_BLUETOOTH_SCAN_DELAY:-3}"
    exit 0
    ;;
  agents)
    # Stand-in agents, plans, usage and balance: never the user's own.
    capture_showcase_surface omarchy.agents "${ARANEA_CAPTURE_AGENTS_SHOWCASE:-$default_agents_showcase}" \
      "${ARANEA_SCREENSHOT_DELAY:-1}"
    exit 0
    ;;
  power)
    capture_popup_surface omarchy.power
    exit 0
    ;;
  monitor)
    capture_popup_surface omarchy.monitor
    exit 0
    ;;
  tray | tray-manage)
    # Fixture tray items only (tools/fixture-tray-item): never a real app.
    capture_tray_surface
    exit 0
    ;;
  workspaces)
    capture_bar_widget_surface araneadev.workspaces
    exit 0
    ;;
  updates)
    capture_bar_widget_surface araneadev.updates
    exit 0
    ;;
  clock)
    # Stand-in place (Amsterdam): never the user's own configured or
    # wttr.in-resolved area.
    capture_clock_surface "${ARANEA_CAPTURE_CLOCK_PLACE:-$default_clock_place}"
    exit 0
    ;;
  weather)
    # The dropdown names the configured town: show a demo city instead of the
    # user's own, and put their location back however the capture ends.
    weather_file="$HOME/.local/state/omarchy/settings/weather.json"
    weather_backup=""
    # Puts the user's weather location back (or removes the demo one).
    restore_weather() {
      if [[ -n "$weather_backup" ]]; then
        mv -f -- "$weather_backup" "$weather_file"
      else
        rm -f -- "$weather_file"
      fi
    }
    mkdir -p "$(dirname "$weather_file")" "$(aranea_state_root)"
    if [[ -f "$weather_file" ]]; then
      weather_backup="$(mktemp "$(aranea_state_root)/weather-backup.XXXXXX")"
      cp -- "$weather_file" "$weather_backup"
    fi
    trap restore_weather EXIT
    jq -n --arg name "${ARANEA_CAPTURE_WEATHER_CITY:-Amsterdam}" \
      --argjson latitude "${ARANEA_CAPTURE_WEATHER_LATITUDE:-52.37}" \
      --argjson longitude "${ARANEA_CAPTURE_WEATHER_LONGITUDE:-4.90}" \
      '{name: $name, latitude: $latitude, longitude: $longitude}' >"$weather_file"
    # The dropdown reloads the location and fetches the forecast first.
    sleep "${ARANEA_WEATHER_DELAY:-6}"
    capture_popup_surface omarchy.weather
    # A failed capture exits inside capture_popup_surface; the trap restores then.
    trap - EXIT
    restore_weather
    exit 0
    ;;
  image-picker)
    # Aranea's own backgrounds, so no personal pictures appear.
    capture_popup_surface omarchy.image-picker "$(jq -cn --arg dirs "$repo_root/backgrounds" '{imageDirs: $dirs, showLabels: true}')"
    exit 0
    ;;
  file-manager)
    command -v nautilus >/dev/null 2>&1 || {
      echo 'nautilus is required to capture file-manager' >&2
      exit 3
    }
    windows_before="$(capture_window_addresses)"
    nautilus --new-window "$repo_root" >/dev/null 2>&1 &
    child_pid=$!
    sleep 1
    hyprctl dismissnotify >/dev/null 2>&1 || true
    sleep "${ARANEA_SCREENSHOT_DELAY:-2}"
    grim "$output/$surface.png"
    close_new_windows "$windows_before"
    kill "$child_pid" >/dev/null 2>&1 || true
    wait "$child_pid" >/dev/null 2>&1 || true
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  lock)
    # The real LockView rendered offscreen with a stand-in clock; the session
    # is never locked. The renderer writes nothing when it fails.
    "$repo_root/tools/render-lock-preview" --output "$output/$surface.png" >/dev/null || {
      echo 'Unable to render the lock screen' >&2
      exit 1
    }
    printf 'captured: %s (offscreen LockView render)\n' "$output/$surface.png"
    exit 0
    ;;
  dawn)
    cp "$repo_root/backgrounds/variants/dawn.png" "$output/$surface.png"
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  osd)
    if [[ -n "${ARANEA_OSD_CAPTURE_COMMAND:-}" ]]; then
      "$ARANEA_OSD_CAPTURE_COMMAND" "$output/$surface.png"
      printf 'captured: %s\n' "$output/$surface.png"
      exit 0
    fi
    capture_osd_surface
    exit 0
    ;;
  plymouth)
    # The disk-unlock prompt composed from the Plymouth theme's own assets
    # and omarchy.script geometry; no plymouthd, sudo or reboot. The renderer
    # writes nothing when it fails.
    "$repo_root/tools/render-plymouth-preview" --output "$output/$surface.png" >/dev/null || {
      echo 'Unable to render the Plymouth boot screen' >&2
      exit 1
    }
    printf 'captured: %s (Plymouth password prompt render)\n' "$output/$surface.png"
    exit 0
    ;;
esac

if [[ -n "${ARANEA_SCREENSHOT_COMMAND:-}" ]]; then
  "$ARANEA_SCREENSHOT_COMMAND" "$output/$surface.png"
  printf 'captured: %s\n' "$output/$surface.png"
  exit 0
fi

printf 'No screenshot provider configured for %s. Set ARANEA_SCREENSHOT_COMMAND to a capture command.\n' "$surface" >&2
exit 3
