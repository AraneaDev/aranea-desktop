#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
surface=""
output=""
capture_all=0
# These are the surfaces currently summonable on this installation. The
# first-party Bluetooth, keyboard-layout, and system-update ids are retained
# in aranea-showcase for direct diagnostics, but their shell API returns
# "unknown" here and they must not poison a complete batch with blank PNGs.
all_surfaces=(menu menu-submenu menu-search menu-input desktop diagnostics lock plymouth fastfetch file-manager neovim notifications network audio bluetooth agents power monitor apps favorites recent idle)

build_hero_showcase() {
  command -v magick >/dev/null 2>&1 || {
    echo 'magick is required to build screenshots/hero-showcase.gif' >&2
    exit 3
  }
  local frames=(desktop menu menu-submenu diagnostics fastfetch neovim lock plymouth)
  local frame
  for frame in "${frames[@]}"; do
    [[ -f "$output/$frame.png" ]] || {
      echo "Cannot build hero showcase: missing $output/$frame.png" >&2
      exit 3
    }
  done
  magick -delay 100 -loop 0 \
    "$output/desktop.png" "$output/menu.png" "$output/menu-submenu.png" \
    "$output/diagnostics.png" "$output/fastfetch.png" "$output/neovim.png" \
    "$output/lock.png" "$output/plymouth.png" \
    -resize 1280x -colors 128 -layers Optimize "$output/hero-showcase.gif"
  printf 'built: %s\n' "$output/hero-showcase.gif"
}

while (($#)); do
  case "$1" in
    --surface) (($# >= 2)) || { echo '--surface requires a value' >&2; exit 2; }; surface="$2"; shift ;;
    --output) (($# >= 2)) || { echo '--output requires a directory' >&2; exit 2; }; output="$2"; shift ;;
    --all) capture_all=1 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if (( capture_all )); then
  [[ -n "$output" ]] || { echo 'Usage: scripts/capture-screenshots --all --output <dir>' >&2; exit 2; }
  command -v hyprctl >/dev/null 2>&1 || { echo '--all requires hyprctl so captures cannot silently run on the wrong workspace' >&2; exit 3; }
  active_workspace="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null || true)"
  [[ -n "$active_workspace" && "$active_workspace" != "null" ]] || {
    echo 'Unable to verify the active workspace; refusing --all capture' >&2
    exit 3
  }
  [[ "$active_workspace" == "2" ]] || {
    echo "Refusing --all capture on workspace $active_workspace; switch to workspace 2 first" >&2
    exit 3
  }
  # Leave the finished capture set visible on the intentionally empty
  # workspace long enough for visual inspection before returning focus.
  trap 'sleep "${ARANEA_CAPTURE_RETURN_DELAY:-10}"; hyprctl dispatch '\''hl.dsp.focus({ workspace = "1" })'\'' >/dev/null 2>&1 || true' EXIT
  for all_surface in "${all_surfaces[@]}"; do
    "$0" --surface "$all_surface" --output "$output"
  done
  build_hero_showcase
  exit 0
fi

[[ -n "$surface" && -n "$output" ]] || { echo 'Usage: scripts/capture-screenshots --surface <name> --output <dir>' >&2; exit 2; }
showcase_surface="$surface"
case "$surface" in
  plymouth) showcase_surface=boot ;;
  fastfetch) showcase_surface=about ;;
  neovim) showcase_surface=editor ;;
esac
"$repo_root/scripts/aranea-showcase" surface "$showcase_surface" >/dev/null
mkdir -p "$output"

capture_menu_surface() {
  command -v omarchy-shell >/dev/null 2>&1 || {
    echo "omarchy-shell is required to capture $surface" >&2
    exit 3
  }
  command -v grim >/dev/null 2>&1 || {
    echo "grim is required to capture $surface" >&2
    exit 3
  }

  local payload
  case "$surface" in
    menu) payload='{"menu":"root"}' ;;
    menu-submenu) payload='{"menu":"apps"}' ;;
    apps) payload='{"menu":"apps"}' ;;
    favorites) payload='{"menu":"apps.favorites"}' ;;
    recent) payload='{"menu":"apps.recent"}' ;;
    menu-search) payload='{"mode":"select","prompt":"Search","options":["Files","Terminal","Workspace"]}' ;;
    menu-input) payload='{"mode":"input","prompt":"Name"}' ;;
    *) return 1 ;;
  esac

  omarchy-shell shell hide araneadev.menu >/dev/null 2>&1 || true
  omarchy-shell shell toggle araneadev.menu "$payload"
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  grim "$output/$surface.png"
  omarchy-shell shell hide araneadev.menu >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

capture_terminal_surface() {
  local title="$1"
  local command_name="$2"
  local terminal_bin=kitty
  [[ "$surface" == "fastfetch" ]] && terminal_bin=ghostty
  command -v "$terminal_bin" >/dev/null 2>&1 || { echo "$terminal_bin is required to capture $surface" >&2; exit 3; }
  command -v "$command_name" >/dev/null 2>&1 || { echo "$command_name is required to capture $surface" >&2; exit 3; }

  if [[ "$surface" == "fastfetch" ]]; then
    ghostty +new-window --title="${title// /-}" -e bash -lc 'fastfetch; exec bash' &
  else
    kitty --config "$repo_root/integrations/terminal/kitty.conf" \
      --class "aranea-screenshot-$surface" --title "$title" \
      --override initial_window_width=104c --override initial_window_height=34c \
      -e "$command_name" &
  fi
  local child_pid=$!
  sleep 1
  hyprctl dismissnotify >/dev/null 2>&1 || true
  sleep "${ARANEA_SCREENSHOT_DELAY:-2}"
  grim "$output/$surface.png"
  # Close the capture window immediately so the next surface cannot inherit it.
  hyprctl dispatch 'hl.dsp.window.close()' >/dev/null 2>&1 || true
  kill "$child_pid" >/dev/null 2>&1 || true
  wait "$child_pid" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

capture_popup_surface() {
  local target="$1"
  command -v omarchy-shell >/dev/null 2>&1 || { echo "omarchy-shell is required to capture $surface" >&2; exit 3; }
  command -v grim >/dev/null 2>&1 || { echo "grim is required to capture $surface" >&2; exit 3; }

  hyprctl dismissnotify >/dev/null 2>&1 || true
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  local summon_result
  summon_result="$(omarchy-shell shell summon "$target" 2>&1)"
  if [[ "$summon_result" != "ok" ]]; then
    echo "Unable to summon popup $target: $summon_result" >&2
    exit 3
  fi
  sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
  grim "$output/$surface.png"
  omarchy-shell shell hide "$target" >/dev/null 2>&1 || true
  printf 'captured: %s\n' "$output/$surface.png"
}

case "$surface" in
  menu|menu-submenu|menu-search|menu-input|apps|favorites|recent)
    capture_menu_surface
    exit 0
    ;;
  desktop)
    grim "$output/$surface.png"
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  notifications)
    command -v notify-send >/dev/null 2>&1 &&
      notify-send -a Aranea -u normal -t 2500 'Aranea notification' 'Theme capture · notification surface' || true
    sleep 0.5
    omarchy-shell shell toggle araneadev.notifications >/dev/null
    sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
    grim "$output/$surface.png"
    omarchy-shell shell hide araneadev.notifications >/dev/null 2>&1 || true
    # Let the capture-only toast expire before the next all-surface capture.
    sleep 2
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  diagnostics)
    # Keep the diagnostics capture free of unrelated toast notifications.
    omarchy plugin disable araneadev.notifications >/dev/null 2>&1 || true
    aranea-diagnostics-toggle >/dev/null
    sleep "${ARANEA_SCREENSHOT_DELAY:-1}"
    grim "$output/$surface.png"
    aranea-diagnostics-toggle >/dev/null 2>&1 || true
    omarchy plugin enable araneadev.notifications >/dev/null 2>&1 || true
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  fastfetch)
    omarchy plugin disable araneadev.notifications >/dev/null 2>&1 || true
    hyprctl dismissnotify >/dev/null 2>&1 || true
    capture_terminal_surface "Aranea Fastfetch" fastfetch
    omarchy plugin enable araneadev.notifications >/dev/null 2>&1 || true
    exit 0
    ;;
  neovim)
    omarchy plugin disable araneadev.notifications >/dev/null 2>&1 || true
    hyprctl dismissnotify >/dev/null 2>&1 || true
    capture_terminal_surface "Aranea Neovim" nvim
    omarchy plugin enable araneadev.notifications >/dev/null 2>&1 || true
    exit 0
    ;;
  network)
    capture_popup_surface omarchy.network
    exit 0
    ;;
  audio)
    capture_popup_surface omarchy.audio
    exit 0
    ;;
  bluetooth)
    capture_popup_surface omarchy.bluetooth
    exit 0
    ;;
  agents)
    capture_popup_surface omarchy.agents
    exit 0
    ;;
  power)
    capture_popup_surface omarchy.power
    exit 0
    ;;
  monitor)
    capture_popup_surface omarchy.monitor
    exit 0
    ;;
  idle)
    command -v omarchy-launch-screensaver >/dev/null 2>&1 || {
      echo 'omarchy-launch-screensaver is required to capture idle' >&2
      exit 3
    }
    command -v grim >/dev/null 2>&1 || {
      echo 'grim is required to capture idle' >&2
      exit 3
    }
    omarchy-launch-screensaver force >/dev/null 2>&1 &
    screensaver_launcher_pid=$!
    sleep "${ARANEA_SCREENSHOT_DELAY:-2}"
    grim "$output/$surface.png"
    kill "$screensaver_launcher_pid" >/dev/null 2>&1 || true
    wait "$screensaver_launcher_pid" >/dev/null 2>&1 || true
    pkill -x ttfx >/dev/null 2>&1 || true
    pkill -f '[o]rg.omarchy.screensaver' >/dev/null 2>&1 || true
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  keyboard-layout)
    capture_popup_surface omarchy.keyboard-layout
    exit 0
    ;;
  system-update)
    capture_popup_surface omarchy.system-update
    exit 0
    ;;
  file-manager)
    command -v nautilus >/dev/null 2>&1 || { echo 'nautilus is required to capture file-manager' >&2; exit 3; }
    nautilus --new-window "$repo_root" >/dev/null 2>&1 &
    child_pid=$!
    sleep 1
    hyprctl dismissnotify >/dev/null 2>&1 || true
    sleep "${ARANEA_SCREENSHOT_DELAY:-2}"
    grim "$output/$surface.png"
    hyprctl dispatch 'hl.dsp.window.close()' >/dev/null 2>&1 || true
    kill "$child_pid" >/dev/null 2>&1 || true
    wait "$child_pid" >/dev/null 2>&1 || true
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  lock)
    cp "$repo_root/branding/screens/lock.png" "$output/$surface.png"
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
  plymouth)
    cp "$repo_root/branding/screens/plymouth.png" "$output/$surface.png"
    printf 'captured: %s\n' "$output/$surface.png"
    exit 0
    ;;
esac

if [[ -n "${ARANEA_SCREENSHOT_COMMAND:-}" ]]; then
  "$ARANEA_SCREENSHOT_COMMAND" "$output/$surface.png"
  printf 'captured: %s\n' "$output/$surface.png"
  exit 0
fi

printf 'No screenshot provider configured for %s. Set ARANEA_SCREENSHOT_COMMAND to a capture command.\n' "$surface" >&2
exit 3
