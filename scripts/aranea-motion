#!/usr/bin/env bash
set -euo pipefail

# Reads, sets or toggles the Aranea motion setting (Hyprland animations on
# or off), kept in the Aranea state dir, and applies it through hyprctl.
#
# Usage: scripts/aranea-motion [status|set on|off|toggle|apply]

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/lib/paths.sh"
state_root="$(aranea_state_root)"
state_file="$state_root/motion"

# Prints "off" when the state file says off, else "on".
motion_status() {
  if [[ -f "$state_file" && "$(<"$state_file")" == off ]]; then
    printf '%s\n' off
  else
    printf '%s\n' on
  fi
}

# JSON reads preserve the text default while reporting invalid stored values.
motion_status_json() {
  local configured=on applied=null application=deferred availability=available observed
  if [[ -e "$state_file" || -L "$state_file" ]]; then
    if [[ -f "$state_file" && -r "$state_file" ]]; then
      configured="$(cat "$state_file")"
      [[ "$configured" == on || "$configured" == off ]] || configured=null
    else configured=null; fi
  fi
  [[ "$configured" != null ]] || availability=unavailable
  if command -v "${ARANEA_HYPRCTL:-hyprctl}" >/dev/null 2>&1; then
    application=unavailable
    if observed="$("${ARANEA_HYPRCTL:-hyprctl}" -j getoption animations:enabled)"; then
      case "$(jq -r 'if .bool == true then "on" elif .bool == false then "off" elif .int == 1 then "on" elif .int == 0 then "off" else "unknown" end' <<<"$observed" 2>/dev/null)" in
        on) applied='"on"' ;;
        off) applied='"off"' ;;
      esac
      if [[ "$applied" != null ]]; then
        application=pending
        [[ "$applied" == \"$configured\" ]] && application=applied
      fi
    fi
  fi
  jq -cn --arg configured "$configured" --argjson applied "$applied" \
    --arg availability "$availability" --arg application "$application" \
    '{configured:(if $configured == "null" then null else $configured end),
      applied:$applied, availability:$availability, application:$application}'
  [[ "$availability" == available ]]
}

# Applies the stored mode to Hyprland (animations off, or on with Aranea's
# curves) and prints it; only prints it when hyprctl is missing.
apply_motion() {
  local mode hyprctl_bin reply lua_code apply_status=0
  mode="$(motion_status)"
  hyprctl_bin="${ARANEA_HYPRCTL:-hyprctl}"
  if ! command -v "$hyprctl_bin" >/dev/null 2>&1; then
    printf 'motion: %s (Hyprland apply deferred)\n' "$mode"
    return 0
  fi

  if [[ "$mode" == off ]]; then
    reply="$("$hyprctl_bin" keyword animations:enabled false)" || apply_status=$?
    lua_code='hl.config({ animations = { enabled = false } })'
  else
    # A modest spatial overshoot approximates the shell card springs. Define
    # it before either use; closing stays monotonic and layer surfaces retain
    # their QML motion so transparent shell windows never get a second scale.
    reply="$("$hyprctl_bin" --batch 'keyword animations:enabled true; keyword bezier araneaSpring, 0.22, 1, 0.36, 1.14; keyword animation windowsIn, 1, 2.8, araneaSpring, popin 94%; keyword animation windowsMove, 1, 2.8, araneaSpring; keyword animation windowsOut, 1, 1.4, linear, popin 96%; keyword animation workspaces, 1, 2.4, easeInOutCubic, slidefade 12%; keyword animation specialWorkspace, 1, 2.6, easeInOutCubic, slidefadevert 10%')" || apply_status=$?
    lua_code='hl.config({ animations = { enabled = true } }); hl.curve("araneaSpring", { type = "bezier", points = { { 0.22, 1 }, { 0.36, 1.14 } } }); hl.animation({ leaf = "windowsIn", enabled = true, speed = 2.8, bezier = "araneaSpring", style = "popin 94%" }); hl.animation({ leaf = "windowsMove", enabled = true, speed = 2.8, bezier = "araneaSpring" }); hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.4, bezier = "linear", style = "popin 96%" }); hl.animation({ leaf = "workspaces", enabled = true, speed = 2.4, bezier = "easeInOutCubic", style = "slidefade 12%" }); hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 2.6, bezier = "easeInOutCubic", style = "slidefadevert 10%" })'
  fi

  # Lua-configured Hyprland refuses legacy keywords before changing anything.
  # Its CLI can exit 0 for that rejection, so inspect the compositor reply.
  if [[ "$reply" == *"keyword can't work with non-legacy parsers. Use eval."* ]]; then
    apply_status=0
    reply="$("$hyprctl_bin" eval "$lua_code")" || apply_status=$?
  fi
  if ((apply_status != 0)); then
    [[ -z "$reply" ]] || printf '%s\n' "$reply" >&2
    return "$apply_status"
  fi
  if [[ -n "$reply" ]] && grep -qvE '^(ok|[[:space:]]*)$' <<<"$reply"; then
    printf 'motion: Hyprland rejected apply: %s\n' "$reply" >&2
    return 1
  fi
  printf 'motion: %s\n' "$mode"
}

case "${1:-status}" in
  status)
    if [[ "${2:-}" == --json ]]; then
      [[ $# -eq 2 ]] || exit 2
      command -v jq >/dev/null 2>&1 || {
        echo 'jq is required for --json' >&2
        exit 2
      }
      motion_status_json
      exit $?
    fi
    printf 'motion: %s\n' "$(motion_status)"
    ;;
  set)
    mode="${2:-}"
    [[ "$mode" == on || "$mode" == off ]] || {
      printf 'Usage: %s set on|off\n' "$0" >&2
      exit 2
    }
    mkdir -p "$state_root"
    printf '%s\n' "$mode" >"$state_file"
    apply_motion
    ;;
  toggle)
    if [[ "$(motion_status)" == on ]]; then
      "$0" set off
    else
      "$0" set on
    fi
    ;;
  apply)
    apply_motion
    ;;
  *)
    printf 'Usage: %s status|set on|off|toggle|apply\n' "$0" >&2
    exit 2
    ;;
esac
