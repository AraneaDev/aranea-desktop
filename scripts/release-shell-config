#!/usr/bin/env bash
set -euo pipefail

# The inverse of repair-shell-config for the notification center, run by the
# theme-set hook when another theme is applied: Aranea's bell-only
# notifications step aside and Omarchy's own notification daemon (with its
# toasts) takes over again. When the bell was in the bar, a "parked" marker
# asks repair-shell-config to put it back on the next return to Aranea; a
# bell the user removed parks nothing and stays removed.
#
# `omarchy plugin disable` is not used here: for a cloned plugin it rewrites
# the bell's bar entry into an entry for the clone's source.
#
# Usage: scripts/release-shell-config [shell.json]

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/lib/paths.sh"
config_file="${1:-$(xdg_config_home)/omarchy/shell.json}"

if [[ ! -f "$config_file" ]]; then
  exit 0
fi
command -v jq >/dev/null 2>&1 || {
  printf 'jq is required to release shell config: %s\n' "$config_file" >&2
  exit 1
}

# Write through a symlinked shell.json (dotfile managers) instead of
# replacing the link with a plain file.
resolved_config="$(readlink -f -- "$config_file" 2>/dev/null || true)"
[[ -n "$resolved_config" ]] && config_file="$resolved_config"

state_root="$(aranea_state_root)"
parked_marker="$state_root/notifications-widget-parked"
health_parked="$state_root/health-widget-parked"
config_dir="$(dirname "$config_file")"
tmp_file="$(mktemp "$config_dir/.shell.json.aranea.XXXXXX")"
# Removes the temp file on exit.
cleanup() { rm -f "$tmp_file"; }
trap cleanup EXIT

# Which polkit agent this config enables. An agent registers once per shell
# process, so a change of owner needs a shell restart: leave a marker for
# finish-polkit-handover (the hooks run it) instead of restarting from here.
polkit_owner() {
  jq -r 'if ([.plugins[]? | (if type == "string" then . else .id? end)] | index("araneadev.polkit")) != null
            and (((.disabledPlugins // []) | index("omarchy.polkit")) != null)
         then "aranea" else "stock" end' "$1" 2>/dev/null || echo unknown
}
# Leaves the polkit-handover marker when the rewrite changes which polkit
# agent is enabled.
note_polkit_handover() {
  if [[ "$(polkit_owner "$config_file")" != "$(polkit_owner "$tmp_file")" ]]; then
    mkdir -p "$state_root"
    : >"$state_root/polkit-handover"
  fi
}

jq '
  def entry_id: if type == "string" then . else .id? end;
  # Aranea clones that step aside, and the stock plugins that take over again.
  def ours: ["araneadev.notifications", "araneadev.health", "araneadev.clipboard", "araneadev.emojis", "araneadev.polkit", "araneadev.lock", "araneadev.osd", "araneadev.menu", "araneadev.workspaces", "araneadev.updates", "araneadev.audio", "araneadev.bluetooth"];
  def stock: ["omarchy.notifications", "omarchy.clipboard", "omarchy.emojis", "omarchy.polkit", "omarchy.lock", "omarchy.osd", "omarchy.bar", "omarchy.menu"];
  def retarget($from; $to):
    if type == "string" then (if . == $from then $to else . end)
    elif type == "object" and .id == $from then .id = $to
    else . end;
  # The bar goes back to Omarchy: no bar id means its own bar. The Aranea
  # menu entry becomes the stock menu entry, keeping its place and settings.
  (if (.bar | type) == "object" and .bar.id == "araneadev.bar" then .bar |= del(.id) else . end)
  | (if (.bar.layout | type) == "object" then
       .bar.layout |= with_entries(.value |= (if type == "array" then map(
         retarget("araneadev.menu"; "omarchy.menu")
         | retarget("araneadev.workspaces"; "omarchy.workspaces")
         | retarget("araneadev.updates"; "omarchy.system-update")
         | retarget("araneadev.audio"; "omarchy.audio")
         | retarget("araneadev.bluetooth"; "omarchy.bluetooth")
       ) else . end))
     else . end)
  |
  if (.bar.layout | type) == "object" then
    .bar.layout |= with_entries(
      .value |= (if type == "array" then map(select(entry_id as $id | ours | index($id) | not)) else . end))
  else . end
  | if (.plugins | type) == "array" then .plugins |= map(select(entry_id as $id | ours | index($id) | not)) else . end
  | if (.disabledPlugins | type) == "array" then .disabledPlugins |= map(select(. as $id | stock | index($id) | not)) else . end
  | if (.cloneSourceRestores | type) == "array" then
      .cloneSourceRestores |= map(select(. as $id | ours | index($id) | not))
      | if (.cloneSourceRestores | length) == 0 then del(.cloneSourceRestores) else . end
    else . end
' "$config_file" >"$tmp_file"

# Park the bell and health icon for the return to Aranea, only now that the
# release itself succeeded (a failing jq exits above under set -e).
if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.notifications") != null' \
  "$config_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$parked_marker"
fi
if jq -e '[.bar.layout[]? | arrays | .[] | (if type == "string" then . else .id? end)] | index("araneadev.health") != null' \
  "$config_file" >/dev/null 2>&1; then
  mkdir -p "$state_root"
  : >"$health_parked"
fi

note_polkit_handover

if cmp -s "$config_file" "$tmp_file"; then
  exit 0
fi
chmod --reference="$config_file" "$tmp_file"
mv -f "$tmp_file" "$config_file"
printf 'released notification center from shell config: %s\n' "$config_file"
