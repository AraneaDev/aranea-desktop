#!/usr/bin/env bash
set -euo pipefail

# Earlier Aranea versions shipped a Conky overlay (the "diagnostics" layer).
# Remove only the files they installed: a user's own Conky configuration is
# left alone.
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
conky_dir="$HOME/.config/conky"

if [[ -L "$conky_dir/conky.conf" ]] && [[ "$(readlink "$conky_dir/conky.conf")" == */omarchy/current/theme/* ]]; then
  rm -f "$conky_dir/conky.conf"
fi
if [[ -f "$conky_dir/gradient-border.lua" ]] \
   && [[ "$(head -n 1 "$conky_dir/gradient-border.lua")" == "-- Draws conky's hairline border as the theme's signature mint -> violet" ]]; then
  rm -f "$conky_dir/gradient-border.lua"
fi
rmdir "$conky_dir" 2>/dev/null || true
rm -f "$HOME/.local/bin/aranea-diagnostics-toggle"
# 1.7.0 kept mutes for health items in the notification center; health now
# lives only in its dropdown, so the mute file is obsolete.
rm -f "$state_home/aranea/health.json"
