#!/bin/bash
# Usage: aranea-agent-hook-worker claude|codex < native-hook.json (private)
# Bounded native ingress. Payload identity never supplies process evidence.
set -euo pipefail
export PATH=/usr/bin:/bin
unset BASH_ENV ENV CDPATH
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/paths.sh
source "$script_dir/lib/paths.sh"
# shellcheck source=scripts/lib/agent-activity.sh
source "$script_dir/lib/agent-activity.sh"
export ARANEA_ACTIVITY_GENERATION="${ARANEA_ACTIVITY_GENERATION:-$(agent_activity_generation)}"
[[ $# == 1 && ("$1" == claude || "$1" == codex) ]]
payload=$(head -c 1048577 | jq -Rces 'if utf8bytelength > 1048576 then error("size") else fromjson | select(type == "object") end')
response=$(jq -c --arg provider "$1" '{action:"native",args:{provider:$provider,payload:.,caller:null}}' <<<"$payload" | /bin/bash "$script_dir/aranea-agent-store" mutate)
# Exactly one helper wins its own epoch lock; ordinary tools never launch helpers.
if [[ $(jq -r '.hook_event_name' <<<"$payload") == SessionStart ]]; then
  session=$(jq -r '.session_id' <<<"$payload")
  record=$(jq -c --arg provider "$1" --arg id "$session" '.state.sessions[] | select(.provider == $provider and .providerSessionId == $id and .provenance != null and .connection.connected)' <<<"$response")
  if [[ -n "$record" ]]; then
    /usr/bin/setsid /bin/bash "$script_dir/aranea-agent-heartbeat" "$1" "$session" "$(jq -r .producerEpoch <<<"$record")" "$(jq -r .provenance.pid <<<"$record")" "$(jq -r .provenance.startTime <<<"$record")" "$(jq -r .provenance.bootId <<<"$record")" </dev/null >/dev/null 2>&1 &
  fi
fi
