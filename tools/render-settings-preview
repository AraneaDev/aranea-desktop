#!/usr/bin/env bash
# Renders real SettingsSurface content in an inert offscreen host. No live
# desktop owner is contacted; fixture mode rejects reads and mutations.
# Usage: tools/render-settings-preview --output FILE [--fixture NAME] [--background FILE]
# Workspaces use repository Silken Vault art unless --background selects a file.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/render-capture.sh
source "$repo_root/tools/lib/render-capture.sh"
output="" background="$repo_root/backgrounds/variants/silken-vault.png"
fixture=wide
requested_width="" requested_height="" project_count=""
while (($#)); do
  case "$1" in
    --output | --fixture | --width | --height | --project-count | --background)
      (($# >= 2)) || exit 2
      case "$1" in
        --output) output="$2" ;;
        --fixture) fixture="$2" ;;
        --width) requested_width="$2" ;;
        --height) requested_height="$2" ;;
        --project-count) project_count="$2" ;;
        --background) background="$2" ;;
      esac
      shift 2
      ;;
    *)
      echo 'Usage: tools/render-settings-preview --output FILE [--fixture NAME] [--background FILE]' >&2
      exit 2
      ;;
  esac
done
[[ -n "$output" ]] || exit 2
for value in "$requested_width" "$requested_height" "$project_count"; do
  [[ -z "$value" || "$value" =~ ^[0-9]{1,4}$ ]] || exit 2
done
[[ -z "$requested_width" ]] || ((10#$requested_width >= 320 && 10#$requested_width <= 3840)) || exit 2
[[ -z "$requested_height" ]] || ((10#$requested_height >= 240 && 10#$requested_height <= 2160)) || exit 2
[[ -z "$project_count" ]] || ((10#$project_count <= 100)) || exit 2
case "$fixture" in
  workspaces)
    width=1440
    height=810
    ;;
  wide | scaling | dirty | integration-failed | notifications | projects-empty | projects-discovery | projects-grouped | projects-partial | project-details | project-launch-partial | project-setup-folder | project-setup-review | project-setup-configure | project-setup-bulk | project-setup-agents)
    width=840
    height=620
    ;;
  narrow | unavailable)
    width=652
    height=452
    ;;
  *)
    echo "Unknown settings fixture: $fixture" >&2
    exit 2
    ;;
esac
if [[ "$fixture" == workspaces ]]; then
  [[ -f "$background" && -r "$background" ]] || {
    echo "Settings preview needs a readable background: $background" >&2
    exit 1
  }
  background="$(readlink -f -- "$background")"
fi
width="${requested_width:-${ARANEA_SETTINGS_RENDER_WIDTH:-$width}}"
height="${requested_height:-${ARANEA_SETTINGS_RENDER_HEIGHT:-$height}}"
shell_dir="${ARANEA_QML_SHELL_DIR:-/usr/share/omarchy/shell}"
quickshell_bin="${ARANEA_SETTINGS_PREVIEW_QUICKSHELL:-quickshell}"
[[ -f "$shell_dir/Commons/qmldir" && -f "$shell_dir/Ui/qmldir" ]] || {
  echo "Settings preview needs Omarchy shell at $shell_dir" >&2
  exit 1
}
quickshell_path="$(command -v "$quickshell_bin")"
command -v magick >/dev/null
work="$(mktemp -d /tmp/aranea-settings.XXXXXX)"
qs_pid=""
staged=""
# Stop only the isolated preview process group and discard partial images.
cleanup() {
  if [[ -n "$qs_pid" ]]; then
    kill -- "-$qs_pid" 2>/dev/null || true
    wait "$qs_pid" 2>/dev/null || true
  fi
  rm -rf -- "$work"
  [[ -z "$staged" ]] || rm -f -- "$staged"
}
trap cleanup EXIT
mkdir -p "$work/cfg/plugins" "$work/run" "$work/home" "$work/state/omarchy/current"
ln -s "$repo_root" "$work/state/omarchy/current/theme"
mkdir -p "$work/home/.local/state/omarchy/current"
ln -s "$repo_root" "$work/home/.local/state/omarchy/current/theme"
# Fixed process traps are installed before Quickshell loads any component.
render_capture_install_traps "$work"
chmod 700 "$work/run"
ln -s "$shell_dir/Commons" "$work/cfg/Commons"
ln -s "$shell_dir/Ui" "$work/cfg/Ui"
for plugin in "$repo_root"/plugins/araneadev.*; do
  [[ -d "$plugin" ]] && ln -s "$plugin" "$work/cfg/plugins/${plugin##*/}"
done
cp "$repo_root/tests/qml/fixtures/settings-preview.qml" "$work/cfg/shell.qml"
cp "$repo_root/tests/qml/fixtures/ProjectPreview.js" "$work/cfg/ProjectPreview.js"
[[ "${ARANEA_SETTINGS_RENDER_CONTROLS:-0}" != 1 ]] || cp "$repo_root/tests/qml/fixtures/projects-controls.qml" "$work/cfg/shell.qml"
if [[ "$fixture" == workspaces ]]; then
  cp "$repo_root/tests/qml/fixtures/workspaces-preview.qml" "$work/cfg/shell.qml"
  # A fixed local URL avoids interpreting spaces, quotes, # or ? in input paths.
  cp -- "$background" "$work/cfg/background.png"
fi
(cd "$work" && exec setsid env -u WAYLAND_DISPLAY -u DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u HYPRLAND_INSTANCE_SIGNATURE \
  -u QT_QPA_PLATFORMTHEME -u QT_STYLE_OVERRIDE -u QT_SCREEN_SCALE_FACTORS -u QT_AUTO_SCREEN_SCALE_FACTOR \
  PATH="$work/traps:$PATH" ARANEA_CAPTURE_EXECUTION_LOG="$work/execution.log" \
  QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR=1 ARANEA_REDUCED_MOTION=1 \
  HOME="$work/home" XDG_CONFIG_HOME="$work/home/.config" XDG_DATA_HOME="$work/home/.local/share" XDG_RUNTIME_DIR="$work/run" XDG_CACHE_HOME="$work/cache" XDG_STATE_HOME="$work/state" \
  ARANEA_SETTINGS_RENDER_ROOT="$repo_root" ARANEA_SETTINGS_RENDER_FIXTURE="$fixture" \
  ARANEA_SETTINGS_RENDER_WIDTH="$width" ARANEA_SETTINGS_RENDER_HEIGHT="$height" \
  ARANEA_PROJECT_RENDER_COUNT="$project_count" \
  ARANEA_SETTINGS_RENDER_OUTPUT="$work/grab.png" \
  "$quickshell_path" -p "$work/cfg") >"$work/log" 2>&1 &
qs_pid=$!
waited=0
while ((waited < 200)); do
  grep -q 'SETTINGSRENDER\|Failed to load configuration' "$work/log" && break
  kill -0 "$qs_pid" 2>/dev/null || break
  sleep 0.2
  waited=$((waited + 1))
done
if [[ -s "$work/execution.log" ]]; then
  echo "Preview refused unexpected process execution:" >&2
  cat "$work/execution.log" >&2
  exit 1
fi
if ! grep -q 'SETTINGSRENDER OK' "$work/log" || grep -Eq 'TypeError|ReferenceError|Unable to assign|Binding loop detected' "$work/log"; then
  echo 'Settings preview failed:' >&2
  tail -20 "$work/log" >&2
  exit 1
fi
[[ "${ARANEA_SETTINGS_RENDER_CONTROLS:-0}" != 1 ]] || grep 'PROJECTCONTROLS' "$work/log"
[[ "$(magick identify -format '%wx%h' "$work/grab.png")" == "${width}x${height}" ]] || exit 1
mkdir -p -- "$(dirname -- "$output")"
staged="$(mktemp "$(dirname -- "$output")/.render-settings.XXXXXX")"
magick "$work/grab.png" -strip "PNG32:$staged"
mv -f -- "$staged" "$output"
staged=""
printf 'rendered: %s (%sx%s)\n' "$output" "$width" "$height"
