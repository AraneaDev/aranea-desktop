#!/usr/bin/env bash
# Renders real Tasks content in an inert offscreen host. No live
# desktop owner is contacted; fixture mode rejects reads and mutations.
# Usage: tools/render-agents-preview --output FILE [--fixture empty|working|needs-input|review|failed|lost|finished|long|mixed|partial|pending]
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/render-capture.sh
source "$repo_root/tools/lib/render-capture.sh"
output=""
fixture=mixed
while (($#)); do
  case "$1" in
    --output | --fixture)
      (($# >= 2)) || exit 2
      case "$1" in
        --output) output="$2" ;;
        --fixture) fixture="$2" ;;
      esac
      shift 2
      ;;
    *)
      echo 'Usage: tools/render-agents-preview --output FILE [--fixture NAME]' >&2
      exit 2
      ;;
  esac
done
[[ -n "$output" ]] || exit 2
case "$fixture" in
  empty | working | needs-input | review | failed | lost | finished | long | mixed | partial | pending)
    width=840
    height=680
    ;;
  *)
    echo "Unknown agents fixture: $fixture" >&2
    exit 2
    ;;
esac
width="${ARANEA_AGENTS_RENDER_WIDTH:-$width}"
height="${ARANEA_AGENTS_RENDER_HEIGHT:-$height}"
shell_dir="${ARANEA_QML_SHELL_DIR:-/usr/share/omarchy/shell}"
quickshell_bin="${ARANEA_AGENTS_PREVIEW_QUICKSHELL:-quickshell}"
[[ -f "$shell_dir/Commons/qmldir" && -f "$shell_dir/Ui/qmldir" ]] || {
  echo "Agents preview needs Omarchy shell at $shell_dir" >&2
  exit 1
}
quickshell_path="$(command -v "$quickshell_bin")"
command -v magick >/dev/null
work="$(mktemp -d /tmp/aranea-agents.XXXXXX)"
qs_pid=""
staged=""
# Stop only the isolated preview process group and discard partial images.
cleanup() {
  if [[ -n "$qs_pid" ]]; then
    kill -- "-$qs_pid" 2>/dev/null || true
    wait "$qs_pid" 2>/dev/null || true
  fi
  rm -rf -- "$work"
  [[ -z "$staged" ]] || rm -f -- "$staged"
}
trap cleanup EXIT
mkdir -p "$work/cfg/plugins" "$work/run" "$work/home" "$work/state/omarchy/current"
mkdir -p "$work/theme/scripts"
cp "$repo_root/colors.toml" "$repo_root/shell.toml" "$work/theme/"
ln -s "$work/theme" "$work/state/omarchy/current/theme"
mkdir -p "$work/home/.local/state/omarchy/current"
ln -s "$work/theme" "$work/home/.local/state/omarchy/current/theme"
# Fixed process traps are installed before Quickshell loads any component.
render_capture_install_traps "$work"
# Absolute theme helper paths are traps too; the real scripts are never imported.
for helper in "$repo_root"/scripts/aranea*; do
  [[ -f "$helper" ]] || continue
  cp "$work/traps/aranea" "$work/theme/scripts/${helper##*/}"
done
# Any write below HOME/state/theme during capture fails the preview.
find "$work/home" "$work/state" "$work/theme" -type f -print0 | sort -z | xargs -0 sha256sum >"$work/before"
chmod 700 "$work/run"
ln -s "$shell_dir/Commons" "$work/cfg/Commons"
ln -s "$shell_dir/Ui" "$work/cfg/Ui"
for plugin in "$repo_root"/plugins/araneadev.*; do
  [[ -d "$plugin" ]] && ln -s "$plugin" "$work/cfg/plugins/${plugin##*/}"
done
cp "$repo_root/tests/qml/fixtures/agents-preview.qml" "$work/cfg/shell.qml"
(cd "$work" && exec setsid env -u WAYLAND_DISPLAY -u DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u HYPRLAND_INSTANCE_SIGNATURE \
  -u QT_QPA_PLATFORMTHEME -u QT_STYLE_OVERRIDE -u QT_SCREEN_SCALE_FACTORS -u QT_AUTO_SCREEN_SCALE_FACTOR \
  PATH="$work/traps:$PATH" ARANEA_CAPTURE_EXECUTION_LOG="$work/execution.log" \
  QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR=1 ARANEA_REDUCED_MOTION=1 \
  HOME="$work/home" XDG_CONFIG_HOME="$work/home/.config" XDG_DATA_HOME="$work/home/.local/share" XDG_RUNTIME_DIR="$work/run" XDG_CACHE_HOME="$work/cache" XDG_STATE_HOME="$work/state" \
  ARANEA_STATE_ROOT="$work/state/aranea" CODEX_HOME="$work/home/.codex" OMARCHY_PATH="$work/theme" ARANEA_AGENTS_RENDER_FIXTURE="$fixture" \
  ARANEA_AGENTS_RENDER_WIDTH="$width" ARANEA_AGENTS_RENDER_HEIGHT="$height" \
  ARANEA_AGENTS_RENDER_OUTPUT="$work/grab.png" \
  "$quickshell_path" -p "$work/cfg") >"$work/log" 2>&1 &
qs_pid=$!
waited=0
while ((waited < 200)); do
  grep -q 'AGENTSRENDER\|Failed to load configuration' "$work/log" && break
  kill -0 "$qs_pid" 2>/dev/null || break
  sleep 0.2
  waited=$((waited + 1))
done
find "$work/home" "$work/state" "$work/theme" -type f -print0 | sort -z | xargs -0 sha256sum >"$work/after"
cmp -s "$work/before" "$work/after" || {
  echo 'Agents preview wrote state, settings or theme files' >&2
  exit 1
}
if [[ -s "$work/execution.log" ]]; then
  echo "Preview refused unexpected process execution:" >&2
  cat "$work/execution.log" >&2
  exit 1
fi
if ! grep -q 'AGENTSRENDER OK' "$work/log" || grep -Eq 'TypeError|ReferenceError|Unable to assign|Binding loop detected' "$work/log"; then
  echo 'Agents preview failed:' >&2
  tail -20 "$work/log" >&2
  exit 1
fi
[[ "$(magick identify -format '%wx%h' "$work/grab.png")" == "${width}x${height}" ]] || exit 1
mkdir -p -- "$(dirname -- "$output")"
staged="$(mktemp "$(dirname -- "$output")/.render-agents.XXXXXX")"
magick "$work/grab.png" -strip "PNG32:$staged"
mv -f -- "$staged" "$output"
staged=""
printf 'rendered: %s (%sx%s)\n' "$output" "$width" "$height"
