#!/usr/bin/env bash
# Runs every quality gate for this repository, the same way locally, in CI,
# before a release and from the git hooks.
#
# Usage: tools/check [--fix] [--fast] [--staged] [--only STAGES] [--skip STAGES] [--update-baselines]
#
# Stages run in order: format lint validate qml test smoke. Each prints one
# result line; a summary follows, and the exit status is non-zero when any
# stage failed. See CONTRIBUTING.md.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
all_stages=(format lint validate qml test smoke)

# Prints the usage text.
usage() {
  cat <<'EOF'
Usage: tools/check [--fix] [--fast] [--staged] [--only STAGES] [--skip STAGES] [--update-baselines]

  --fix               write formatting fixes instead of only checking
  --fast              skip smoke and the slow bash tests
  --staged            check the staged (index) content of staged files
  --only a,b          run only these stages
  --skip a,b          skip these stages
  --update-baselines  shrink the qmllint baseline and raise coverage floors
Stages: format lint validate qml test smoke
EOF
}

fix=0 fast=0 staged=0 update_baselines=0 only="" skip=""
while (($#)); do
  case "$1" in
    --fix) fix=1 ;;
    --fast) fast=1 ;;
    --staged) staged=1 ;;
    --update-baselines) update_baselines=1 ;;
    --only) only="${2:?--only needs a stage list}"; shift ;;
    --skip) skip="${2:?--skip needs a stage list}"; shift ;;
    -h | --help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
export fix fast staged update_baselines

# True when NAME is one of the known stages.
known_stage() {
  local name="$1" stage
  for stage in "${all_stages[@]}"; do [[ "$stage" == "$name" ]] && return 0; done
  return 1
}
for list in "$only" "$skip"; do
  IFS=',' read -r -a names <<<"$list"
  for name in "${names[@]}"; do
    known_stage "$name" || { printf 'Unknown stage: %s\n' "$name" >&2; exit 2; }
  done
done

# True when STAGE should run given --only/--skip.
wanted() {
  local stage="$1"
  [[ -n "$only" && ",$only," != *",$stage,"* ]] && return 1
  [[ ",$skip," == *",$stage,"* ]] && return 1
  return 0
}

# The tree being checked: the repository, or a snapshot of the index.
check_root="$repo_root"
if ((staged)); then
  check_root="$(mktemp -d)"
  trap 'rm -rf "$check_root"' EXIT
  (cd "$repo_root" && git diff --cached --name-only --diff-filter=ACMR -z |
    xargs -0 -r git checkout-index --prefix="$check_root/" --)
fi
export check_root repo_root

# Prints tracked (or staged) files, optionally filtered by extended regular
# expressions matched against the whole path (e.g. '\.json$').
check_files() {
  local list
  if ((staged)); then
    list="$(cd "$repo_root" && git diff --cached --name-only --diff-filter=ACMR)"
  else
    list="$(cd "$repo_root" && git ls-files)"
  fi
  if (($# == 0)); then
    printf '%s\n' "$list"
    return
  fi
  local file regex
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    for regex in "$@"; do
      if [[ "$file" =~ $regex ]]; then
        printf '%s\n' "$file"
        break
      fi
    done
  done <<<"$list"
}

# Stage libraries (each defines stage_<name>).
source "$repo_root/tools/lib/check-validate.sh"

# Runs one stage function (defined by the libraries above).
run_stage() {
  case "$1" in
    format) stage_format ;;
    lint) stage_lint ;;
    validate) stage_validate ;;
    qml) stage_qml ;;
    test) stage_test ;;
    smoke) stage_smoke ;;
  esac
}

results=()
failed=0
for stage in "${all_stages[@]}"; do
  wanted "$stage" || continue
  if ! declare -F "stage_$stage" >/dev/null; then
    results+=("$stage: not available")
    continue
  fi
  printf '== %s\n' "$stage"
  run_stage "$stage"
  status=$?
  case "$status" in
    0) results+=("$stage: ok") ;;
    77) results+=("$stage: skipped")
        if [[ "${ARANEA_CHECK_REQUIRE_ALL:-0}" == 1 ]]; then results[-1]="$stage: FAILED (skip not allowed)"; failed=1; fi ;;
    *) results+=("$stage: FAILED"); failed=1 ;;
  esac
done

printf '\n'
printf '%s\n' "${results[@]}"
exit "$failed"
