{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strict": false,
    "target": "es2016",
    "lib": ["es2016"],
    "moduleDetection": "force",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["plugins/**/*.js", "types/**/*.d.ts"],
  "exclude": [
    "plugins/araneadev.audio/AudioBridge.js",
    "plugins/araneadev.health/HealthBridge.js",
    "plugins/araneadev.notifications/ServiceBridge.js",
    "node_modules"
  ]
}
